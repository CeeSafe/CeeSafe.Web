// Drain (implementation plan M1 task 4): one start wakes every waiter, a late waiter returns at once, starting twice
// is harmless, and drainStarted stops the operation it races.
import web_core;

async fn show(label: StringView, ok: bool) -> Result<void, NetError> {
    match (await AsyncConsole.write(label)) {
        Ok() => {}
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
    match (await AsyncConsole.writeLine(if (ok) " ok" else " FAILED")) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

async fn sleep(ms: u64) -> Result<void, NetError> {
    match (await Timer.sleep(ms)) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

async fn work(ms: u64, v: u32) -> Result<u32, NetError> {
    await sleep(ms)?;
    return Ok(v);
}

async fn checks() -> Result<void, NetError> {
    let drain = Drain.create()?;
    await show("a new drain has not started", !drain.isDraining())?;

    // Six waiters, one start.
    var woken = [false; 6];
    await Async.scope(NetError.OutOfMemory, (s) => {
        for (k in 0..woken.length) {
            s.spawn(async () => {
                await drain.wait()?;
                woken[k] = true;
                return Ok();
            });
        }
        s.spawn(async () => {
            await sleep(10)?;
            drain.start();
            return Ok();
        });
    })?;
    var all = true;
    for (k in 0..woken.length) {
        all = all && woken[k];
    }
    await show("one start wakes all six waiters", all && drain.isDraining())?;

    let before = Timer.now();
    await drain.wait()?;
    await show("a waiter after the start returns at once", Timer.now() - before < 5)?;
    drain.start();
    await show("starting again is harmless", drain.isDraining())?;

    // drainStarted against an operation: the operation wins before a start, the drain wins after one.
    let fresh = Drain.create()?;
    let quick: Result<Raced<u32>, NetError> =
        await Async.race(async () => await work(5, 7), async () => await drainStarted<u32>(fresh));
    await show("the operation finishes before a drain", match (quick) {
        Ok(r) => r.value == 7 && r.winner == 0,
        Err(_) => false,
    })?;
    var stopped: Result<Raced<u32>, NetError> = Err(NetError.Closed);
    await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            stopped = await Async.race(async () => await work(100000, 7), async () => await drainStarted<u32>(fresh));
            return Ok();
        });
        s.spawn(async () => {
            await sleep(10)?;
            fresh.start();
            return Ok();
        });
    })?;
    await show("a drain stops the operation as Cancelled", match (stopped) {
        Err(NetError.Cancelled) => fresh.isDraining(),
        _ => false,
    })?;
    return Ok();
}

fn main() {
    match (Async.run(checks())) {
        Ok() => {}
        Err(e) => { Console.writeLine(NetErrors.describe(e)); }
    }
}
