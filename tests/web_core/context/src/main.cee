// ConnectionContext (Web ADR 0001 §3.6): identity, age and the server's drain.
import web_core;

async fn show(label: StringView, ok: bool) -> Result<void, NetError> {
    match (await AsyncConsole.write(label)) {
        Ok() => {}
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
    match (await AsyncConsole.writeLine(if (ok) " ok" else " FAILED")) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

async fn checks() -> Result<void, NetError> {
    let drain = Drain.create()?;
    let c = ConnectionContext.acceptedNow(42, drain);
    await show("id", c.id() == 42)?;
    await show("accepted now", c.acceptedAtMs() <= Timer.now() && c.ageMs() < 1000)?;
    match (await Timer.sleep(15)) {
        Ok() => {}
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
    await show("age grows", c.ageMs() >= 15)?;
    let future = ConnectionContext.create(7, Timer.now() + 100000, drain);
    await show("a future acceptance has age 0", future.ageMs() == 0 && future.id() == 7)?;
    await show("not draining", !c.isDraining() && !c.drain().isDraining())?;
    drain.start();
    await show("sees the drain", c.isDraining() && future.isDraining())?;
    return Ok();
}

fn main() {
    match (Async.run(checks())) {
        Ok() => {}
        Err(_) => { Console.writeLine("failed"); }
    }
}
