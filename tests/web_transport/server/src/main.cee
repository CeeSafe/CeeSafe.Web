// ConnectionServer over MockIncoming (implementation plan M1): admission by workers, a failure at every step ending
// only its connection, the handshake deadline, and drain: idle workers stop at once, connections in flight finish
// within the grace period, and a connection that ignores the drain is cancelled when the grace runs out.
import web_core;
import web_transport;

async fn show(label: StringView, ok: bool) -> Result<void, NetError> {
    match (await AsyncConsole.write(label)) {
        Ok() => {}
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
    match (await AsyncConsole.writeLine(if (ok) " ok" else " FAILED")) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

async fn sleep(ms: u64) -> Result<void, NetError> {
    match (await Timer.sleep(ms)) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

/// The input of every echo connection.
fn message() -> [u8; 26] => [
    0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6A, 0x6B, 0x6C, 0x6D,
    0x6E, 0x6F, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7A,
];

/// Echoes until the peer ends its side, each read and write bounded; counts the bytes and the connections whose
/// echo matched the message, and the highest number of connections served at once.
struct EchoHandler {
    bytes: AtomicU64;
    matched: AtomicU64;
    active: AtomicU64;
    peak: AtomicU64;
    /// Connections whose context had a loopback peer address.
    loopbackPeers: AtomicU64;
    /// The local port of the last connection with a local address.
    localPort: AtomicU64;
}

impl ConnectionHandler for EchoHandler {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        match (ctx.peerAddress()) {
            Some(a) => {
                if (a.isLoopback()) {
                    let n = this.loopbackPeers.fetchAdd(1);
                }
            }
            null => {}
        }
        match (ctx.localAddress()) {
            Some(a) => { this.localPort.store(a.port() as u64); }
            null => {}
        }
        let now = this.active.fetchAdd(1) + 1;
        loop {
            let seen = this.peak.load();
            if (now <= seen) {
                break;
            }
            match (this.peak.compareExchange(seen, now)) {
                Ok(_) => { break; }
                Err(_) => {}
            }
        }
        let r = await echo(this, conn);
        let left = this.active.fetchSub(1);
        return r;
    }
}

async fn echo(h: borrow EchoHandler, conn: borrow mut dyn Transport) -> Result<void, NetError> {
    var buf = [0u8; 8];
    var got: usize = 0;
    var same = true;
    let m = message();
    loop {
        let n = await Transports.readWithin(conn, mut buf[..], Deadline.after(1000))?;
        if (n == 0) {
            break;
        }
        for (i in 0..n) {
            if (got + i >= m.length || buf[i] != m[got + i]) {
                same = false;
            }
        }
        got += n;
        let added = h.bytes.fetchAdd(n as u64);
        await sleep(1)?; // lets other workers run, so connections overlap
        await Transports.writeWithin(conn, buf[0..n], Deadline.after(1000))?;
    }
    if (same && got == m.length) {
        let k = h.matched.fetchAdd(1);
    }
    return Ok();
}

fn echoHandler() -> EchoHandler => EchoHandler {
    bytes: AtomicU64.create(0),
    matched: AtomicU64.create(0),
    active: AtomicU64.create(0),
    peak: AtomicU64.create(0),
    loopbackPeers: AtomicU64.create(0),
    localPort: AtomicU64.create(0),
};

/// Reads once and records whether the read failed with `Reset`; `reading` is set first, so a client knows when to
/// reset the connection.
struct ResetHandler {
    reading: AtomicBool;
    resets: AtomicU64;
}

impl ConnectionHandler for ResetHandler {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        var buf = [0u8; 8];
        this.reading.store(true);
        let r = await Transports.readWithin(conn, mut buf[..], Deadline.after(2000));
        match (r) {
            Err(NetError.Reset) => {
                let n = this.resets.fetchAdd(1);
            }
            _ => {}
        }
        let done = r?;
        return Ok();
    }
}

/// Works for `ms` milliseconds (a request in flight), whatever the drain, then returns.
struct SlowHandler {
    ms: u64;
}

impl ConnectionHandler for SlowHandler {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        await sleep(this.ms)?;
        return Ok();
    }
}

/// An idle keep-alive connection that honours the drain: it waits for a request that never comes, and returns when
/// the drain starts.
struct IdleHandler {}

impl ConnectionHandler for IdleHandler {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        var buf = [0u8; 8];
        let r: Result<Raced<usize>, NetError> = await Async.race(
            async () => await conn.read(mut buf[..]),
            async () => await drainStarted<usize>(ctx.drain()),
        );
        match (r) {
            Ok(_) => { return Ok(); }
            Err(NetError.Cancelled) => {
                if (ctx.isDraining()) {
                    return Ok(); // drained between requests: close gracefully
                }
                return Err(NetError.Cancelled);
            }
            Err(e) => { return Err(e); }
        }
    }
}

/// A connection that ignores the drain: it reads a peer that never sends.
struct StubbornHandler {}

impl ConnectionHandler for StubbornHandler {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        var buf = [0u8; 8];
        let n = await conn.read(mut buf[..])?;
        return Ok();
    }
}

/// An acceptor whose handshake never finishes: it honours its deadline.
struct StalledAcceptor {}

impl Acceptor for StalledAcceptor {
    async fn accept(borrow this, stream: PlainStream, deadline: Deadline) -> Result<Box<dyn Transport>, NetError> {
        return await deadlineElapsed<Box<dyn Transport>>(deadline);
    }
}

fn limits(workers: u32, graceMs: u64) -> ConnectionLimits {
    var l = ConnectionLimits.defaults();
    l.workers = workers;
    l.graceMs = graceMs;
    l.closeLingerMs = 100;
    l.handshakeMs = 20;
    return l;
}

fn mock(input: Slice<u8>) -> Result<MockTransport, NetError> {
    match (MockTransport.create(input)) {
        Ok(m) => { return Ok(m); }
        Err(e) => { return Err(NetErrors.fromAlloc(e)); }
    }
}

/// Runs the server until `incoming` ends (`drainAfterMs` 0) or until a drain started after `drainAfterMs`.
async fn serve(
    incoming: borrow MockIncoming,
    acceptor: borrow dyn Acceptor,
    handler: borrow dyn ConnectionHandler,
    l: borrow ConnectionLimits,
    drainAfterMs: u64,
    report: borrow mut ServerReport,
) -> Result<void, NetError> {
    let drain = Drain.create()?;
    await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            report = await ConnectionServer.run(incoming, acceptor, handler, l, drain)?;
            return Ok();
        });
        s.spawn(async () => {
            if (drainAfterMs > 0) {
                await sleep(drainAfterMs)?;
                drain.start();
            }
            return Ok();
        });
    })?;
    return Ok();
}

fn emptyReport() -> ServerReport => ServerReport {
    accepted: 0,
    handshakesFailed: 0,
    served: 0,
    failed: 0,
    acceptErrors: 0,
    forced: false,
};

async fn servesEveryConnection() -> Result<void, NetError> {
    let incoming = MockIncoming.create(16)?;
    let m = message();
    for (k in 0..12u64) {
        incoming.push(mock(m[..])?.withSeededSplits(k + 1, 5))?;
    }
    incoming.close();
    let h = echoHandler();
    let a = PlainAcceptor {};
    let l = limits(4, 1000);
    var r = emptyReport();
    await serve(incoming, a, h, l, 0, mut r)?;
    await show("12 connections accepted and served", r.accepted == 12 && r.served == 12 && r.failed == 0)?;
    await show("every echo matched", h.matched.load() == 12 && h.bytes.load() == 12 * 26)?;
    await show("admission: never more than 4 at once", h.peak.load() <= 4 && h.peak.load() >= 2)?;
    await show("not forced", !r.forced)?;
    return Ok();
}

async fn failureAtEveryStep() -> Result<void, NetError> {
    let m = message();
    let incoming = MockIncoming.create(64)?;
    for (k in 0..m.length + 1) {
        incoming.push(mock(m[..])?.withChunk(3).withResetAt(k))?;
    }
    for (k in 0..m.length) {
        incoming.push(mock(m[..])?.withChunk(3).withWriteFailureAfter(k))?;
    }
    incoming.push(mock(m[..])?)?;
    incoming.close();
    let h = echoHandler();
    let a = PlainAcceptor {};
    let l = limits(3, 1000);
    var r = emptyReport();
    await serve(incoming, a, h, l, 0, mut r)?;
    await show("a reset at each of 27 offsets fails its connection only", r.accepted == 54 && r.failed == 53)?;
    await show("the server goes on serving", r.served == 1 && h.matched.load() == 1)?;
    return Ok();
}

async fn handshakeDeadline() -> Result<void, NetError> {
    let m = message();
    let incoming = MockIncoming.create(4)?;
    incoming.push(mock(m[..])?)?;
    incoming.push(mock(m[..])?)?;
    incoming.close();
    let h = echoHandler();
    let a = StalledAcceptor {};
    let l = limits(1, 1000);
    var r = emptyReport();
    let started = Timer.now();
    await serve(incoming, a, h, l, 0, mut r)?;
    let took = Timer.now() - started;
    await show("a stalled handshake times out", r.handshakesFailed == 2 && r.served == 0)?;
    await show("after the handshake deadline", took >= 40 && took < 1000)?;
    return Ok();
}

async fn drainStopsIdleWorkers() -> Result<void, NetError> {
    let incoming = MockIncoming.create(4)?; // never closed: the workers wait in accept
    let h = echoHandler();
    let a = PlainAcceptor {};
    let l = limits(8, 5000);
    var r = emptyReport();
    let started = Timer.now();
    await serve(incoming, a, h, l, 10, mut r)?;
    let took = Timer.now() - started;
    await show("drain stops 8 idle workers at once", took < 1000 && !r.forced && r.accepted == 0)?;
    return Ok();
}

async fn drainLetsInFlightFinish() -> Result<void, NetError> {
    let m = message();
    let incoming = MockIncoming.create(4)?;
    incoming.push(mock(m[..])?)?;
    incoming.push(mock(m[..])?)?;
    let h = SlowHandler { ms: 60 };
    let a = PlainAcceptor {};
    let l = limits(4, 5000);
    var r = emptyReport();
    let started = Timer.now();
    await serve(incoming, a, h, l, 10, mut r)?;
    let took = Timer.now() - started;
    await show("requests in flight finish during the drain", r.served == 2 && !r.forced)?;
    await show("the drain ends when they do", took >= 60 && took < 2000)?;
    return Ok();
}

async fn drainClosesIdleConnections() -> Result<void, NetError> {
    let m = message();
    let incoming = MockIncoming.create(4)?;
    incoming.push(mock(m[0..0])?.withHang())?;
    incoming.push(mock(m[0..0])?.withHang())?;
    let h = IdleHandler {};
    let a = PlainAcceptor {};
    let l = limits(4, 5000);
    var r = emptyReport();
    let started = Timer.now();
    await serve(incoming, a, h, l, 10, mut r)?;
    let took = Timer.now() - started;
    await show("idle keep-alive connections close on drain", r.served == 2 && !r.forced && took < 2000)?;
    return Ok();
}

async fn graceRunsOut() -> Result<void, NetError> {
    let m = message();
    let incoming = MockIncoming.create(4)?;
    incoming.push(mock(m[0..0])?.withHang())?;
    incoming.push(mock(m[0..0])?.withHang())?;
    let h = StubbornHandler {};
    let a = PlainAcceptor {};
    let l = limits(4, 50);
    var r = emptyReport();
    let started = Timer.now();
    await serve(incoming, a, h, l, 10, mut r)?;
    let took = Timer.now() - started;
    await show("connections ignoring the drain are cancelled after the grace", r.forced && r.served == 0)?;
    await show("shutdown within drain + grace + epsilon", took >= 60 && took < 1000)?;
    return Ok();
}

/// A TCP client: sends the message, ends its side, and checks the echo.
async fn client(port: u16) -> Result<bool, NetError> {
    var c = await TcpTransport.connect("127.0.0.1", port)?;
    let m = message();
    await c.write(m[..])?;
    await c.shutdownWrite()?;
    var buf = [0u8; 32];
    var got: usize = 0;
    loop {
        let n = await c.read(mut buf[got..])?;
        if (n == 0) {
            break;
        }
        got += n;
    }
    var same = got == m.length;
    for (i in 0..got) {
        if (i < m.length && buf[i] != m[i]) {
            same = false;
        }
    }
    return Ok(same);
}

async fn overTcp() -> Result<void, NetError> {
    let listener = Listener.bind("127.0.0.1", 0)?;
    let port = listener.port()?;
    let drain = Drain.create()?;
    let h = echoHandler();
    let a = PlainAcceptor {};
    let l = limits(4, 1000);
    var r = emptyReport();
    var good: u32 = 0;
    let started = Timer.now();
    var drainedAt: u64 = 0;
    await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            r = await ConnectionServer.run(listener, a, h, l, drain)?;
            return Ok();
        });
        s.spawn(async () => {
            var ok = [false; 8];
            let clients = await Async.scope(NetError.OutOfMemory, (c) => {
                for (k in 0..ok.length) {
                    c.spawn(async () => {
                        ok[k] = await client(port)?;
                        return Ok();
                    });
                }
            });
            for (k in 0..ok.length) {
                if (ok[k]) {
                    good += 1;
                }
            }
            drainedAt = Timer.now();
            drain.start(); // whatever the clients did, so the server always stops
            return clients;
        });
    })?;
    let stopped = Timer.now() - drainedAt;
    await show("8 TCP clients echoed through 4 workers", good == 8 && h.matched.load() == 8)?;
    await show("TCP report: 8 accepted, 8 served", r.accepted == 8 && r.served == 8 && r.failed == 0)?;
    await show("the TCP server drains at once when idle", !r.forced && stopped < 500)?;
    await show(
        "each TCP context has the loopback peer and the listener's port",
        h.loopbackPeers.load() == 8 && h.localPort.load() == port as u64,
    )?;
    return Ok();
}

/// A real RST (SO_LINGER 0, `TcpTransport.abort`) while the handler reads: its read is `Err(Reset)`, the connection
/// counts as failed, and the server serves on.
async fn resetOverTcp() -> Result<void, NetError> {
    let listener = Listener.bind("127.0.0.1", 0)?;
    let port = listener.port()?;
    let drain = Drain.create()?;
    let h = ResetHandler { reading: AtomicBool.create(false), resets: AtomicU64.create(0) };
    let a = PlainAcceptor {};
    let l = limits(2, 1000);
    var r = emptyReport();
    var sawReading = false;
    await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            r = await ConnectionServer.run(listener, a, h, l, drain)?;
            return Ok();
        });
        s.spawn(async () => {
            let c = await TcpTransport.connect("127.0.0.1", port)?;
            for (i in 0..200) {
                if (h.reading.load()) {
                    break;
                }
                match (await Timer.sleep(5)) {
                    Ok() => {}
                    Err(e) => { return Err(NetErrors.fromAsync(e)); }
                }
            }
            sawReading = h.reading.load();
            c.abort();
            for (i in 0..200) {
                if (h.resets.load() > 0) {
                    break;
                }
                match (await Timer.sleep(5)) {
                    Ok() => {}
                    Err(e) => { return Err(NetErrors.fromAsync(e)); }
                }
            }
            drain.start();
            return Ok();
        });
    })?;
    await show("a peer's RST fails the read with Reset", sawReading && h.resets.load() == 1)?;
    await show("the reset connection counts as failed", r.accepted == 1 && r.failed == 1 && r.served == 0)?;
    return Ok();
}

async fn checks() -> Result<void, NetError> {
    await servesEveryConnection()?;
    await failureAtEveryStep()?;
    await handshakeDeadline()?;
    await drainStopsIdleWorkers()?;
    await drainLetsInFlightFinish()?;
    await drainClosesIdleConnections()?;
    await graceRunsOut()?;
    await overTcp()?;
    await resetOverTcp()?;
    return Ok();
}

/// The process's open descriptors (`/dev/fd`), or null where it cannot be listed (Windows).
fn openDescriptors() -> usize? {
    match (Directory.list("/dev/fd")) {
        Ok(names) => { return Some(names.length); }
        Err(_) => { return null; }
    }
}

fn main() {
    let before = openDescriptors();
    match (Async.run(checks())) {
        Ok() => {}
        Err(e) => { Console.writeLine(NetErrors.describe(e)); }
    }
    let after = openDescriptors();
    let same = match (before) {
        Some(b) => match (after) {
            Some(a) => a == b,
            null => false,
        },
        null => true, // not measurable here; the leak check still runs
    };
    Console.writeLine(if (same) "descriptors back to the baseline ok" else "descriptors back to the baseline FAILED");
}
