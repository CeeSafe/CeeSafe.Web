// MockTransport (Web ADR 0001 §3.7): splits (fixed, seeded and reproducible), reset at an offset, hang until a
// deadline, write steps, write failure and poisoning, shutdown, the empty-buffer rule, and cancellation landing in a
// paused read or write.
import web_core;
import web_transport;

async fn show(label: StringView, ok: bool) -> Result<void, NetError> {
    match (await AsyncConsole.write(label)) {
        Ok() => {}
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
    match (await AsyncConsole.writeLine(if (ok) " ok" else " FAILED")) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(NetErrors.fromAsync(e)); }
    }
}

fn mock(text: StringView) -> Result<MockTransport, NetError> {
    match (MockTransport.create(text.bytes())) {
        Ok(m) => { return Ok(m); }
        Err(e) => { return Err(NetErrors.fromAlloc(e)); }
    }
}

fn equals(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

/// Reads to the end, recording each read's size into `sizes` (as decimal digits, one per read, sizes < 10).
async fn drain(t: borrow mut dyn Transport, sizes: borrow mut Vector<u8>) -> Result<usize, NetError> {
    var buf = [0u8; 16];
    var total: usize = 0;
    loop {
        let n = await t.read(mut buf[..])?;
        if (n == 0) {
            return Ok(total);
        }
        match (sizes.push(48 + truncate<u8>(n % 10))) {
            Ok() => {}
            Err(e) => { return Err(NetErrors.fromAlloc(e)); }
        }
        total += n;
    }
}

async fn splits() -> Result<void, NetError> {
    let text = "abcdefghijklmnopqrstuvwxyz";
    var fixed = mock(text)?.withChunk(4);
    var sizes = Vector<u8>.create();
    let n = await drain(mut fixed, mut sizes)?;
    await show("fixed chunk 4 of 26: 4444442", n == 26 && equals(sizes.view(), "4444442".bytes()))?;

    var a = mock(text)?.withSeededSplits(42, 5);
    var b = mock(text)?.withSeededSplits(42, 5);
    var sa = Vector<u8>.create();
    var sb = Vector<u8>.create();
    let na = await drain(mut a, mut sa)?;
    let nb = await drain(mut b, mut sb)?;
    var inRange = true;
    for (s in sa) {
        inRange = inRange && s >= 49 && s <= 53;
    }
    await show("seeded splits are reproducible", na == 26 && nb == 26 && equals(sa.view(), sb.view()))?;
    await show("seeded splits stay within 1..5", inRange && sa.length >= 6)?;

    var whole = mock(text)?;
    var sw = Vector<u8>.create();
    let nw = await drain(mut whole, mut sw)?;
    await show("whole reads fill the buffer: 16 then 10", nw == 26 && equals(sw.view(), "60".bytes()))?;
    return Ok();
}

async fn failures() -> Result<void, NetError> {
    var buf = [0u8; 16];
    var r = mock("0123456789")?.withResetAt(6);
    let first = await r.read(mut buf[..])?;
    let second = await r.read(mut buf[..]);
    await show("reset at 6: 6 bytes, then Reset", first == 6 && match (second) {
        Err(NetError.Reset) => true,
        _ => false,
    })?;

    var e = mock("x")?;
    await show("empty buffer is LimitExceeded", match (await e.read(mut buf[0..0])) {
        Err(NetError.LimitExceeded) => true,
        _ => false,
    })?;

    var h = mock("")?.withHang();
    let raced: Result<Raced<usize>, NetError> =
        await Async.race(
            async () => await h.read(mut buf[..]),
            async () => await deadlineElapsed<usize>(Deadline.after(10)),
        );
    await show("hang until deadline", match (raced) {
        Err(NetError.TimedOut) => true,
        _ => false,
    })?;

    var w = mock("")?.withWriteFailureAfter(3);
    let wrote = await w.write("abcdef".bytes());
    let after = await w.write("z".bytes());
    await show("write failure after 3 bytes: Reset, then Closed", equals(w.written(), "abc".bytes()) && match (wrote) {
        Err(NetError.Reset) => true,
        _ => false,
    } && match (after) {
        Err(NetError.Closed) => true,
        _ => false,
    } && w.isPoisoned())?;

    var v = mock("")?.withWriteStep(2);
    let hello = "hello";
    let world = " world";
    let parts = IoParts.two(hello.bytes(), world.bytes());
    let step = await v.writeVectored(parts)?;
    await Transports.writeAllVectored(mut v, parts)?;
    await show("write step 2, then writeAllVectored", step == 2 && equals(v.written(), "hehello world".bytes()))?;

    var s = mock("")?;
    await s.shutdownWrite()?;
    await show("shutdown, then write is Closed", s.isShutdown() && match (await s.write("x".bytes())) {
        Err(NetError.Closed) => true,
        _ => false,
    })?;
    return Ok();
}

async fn cancellation() -> Result<void, NetError> {
    // A write paused for 50 ms, bounded by a 5 ms deadline: TimedOut wins, and the cancelled write poisons.
    var w = mock("")?.withPause(50);
    let raced: Result<Raced<u32>, NetError> = await Async.race(
        async () => {
            await w.write("never".bytes())?;
            return Ok(1u32);
        },
        async () => await deadlineElapsed<u32>(Deadline.after(5)),
    );
    await show("cancelled paused write poisons", w.isPoisoned() && w.written().length == 0 && match (raced) {
        Err(NetError.TimedOut) => true,
        _ => false,
    })?;

    // A paused read cancelled the same way loses nothing: the next read gets the bytes.
    var r = mock("data")?.withPause(50);
    var buf = [0u8; 8];
    let lost: Result<Raced<usize>, NetError> =
        await Async.race(
            async () => await r.read(mut buf[..]),
            async () => await deadlineElapsed<usize>(Deadline.after(5)),
        );
    let again = await r.read(mut buf[..])?;
    await show("cancelled paused read loses nothing", again == 4 && r.consumed() == 4 && match (lost) {
        Err(NetError.TimedOut) => true,
        _ => false,
    })?;

    var a = mock("")?.withAlpn(Alpn.Http2);
    await show("alpn", match (a.alpn()) {
        Alpn.Http2 => true,
        _ => false,
    })?;
    return Ok();
}

async fn checks() -> Result<void, NetError> {
    await splits()?;
    await failures()?;
    await cancellation()?;
    return Ok();
}

fn main() {
    match (Async.run(checks())) {
        Ok() => {}
        Err(e) => { Console.writeLine(NetErrors.describe(e)); }
    }
}
