<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The Kestrel comparison server (Web ADR 0015 §6): .NET 10, pinned by global.json's SDK, built with
       `dotnet publish -c Release`. Server GC and tiered PGO are .NET's defaults for ASP.NET Core and are left so. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>bench_kestrel</AssemblyName>
    <!-- The newest installed 10.0 patch: the SDK that global.json pins brings it (10.0.401: runtime 10.0.12). Disable
         would ask for exactly 10.0.0, which a machine with only that SDK lacks. run.py records the runtime. -->
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>
</Project>
