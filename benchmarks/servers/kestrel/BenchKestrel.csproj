<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The Kestrel comparison server (Web ADR 0015 §6): .NET 10, pinned by global.json's SDK, built with
       `dotnet publish -c Release`. Server GC and tiered PGO are .NET's defaults for ASP.NET Core and are left so. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>bench_kestrel</AssemblyName>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
</Project>
