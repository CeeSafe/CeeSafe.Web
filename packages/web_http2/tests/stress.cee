// The driver under cancellation and flow control (Web ADR 0011 §5, the M7 gate): a stream reset in the middle of its
// body, a hundred streams cancelled when the client leaves, a hundred drained to their end, and a response held to a
// small window. The expected numbers come from RFC 9113: SETTINGS_INITIAL_WINDOW_SIZE (§6.5.2, §6.9.2) bounds what a
// stream may send before WINDOW_UPDATE (§6.9), and no frame exceeds SETTINGS_MAX_FRAME_SIZE, 16 384 by default (§4.2).
import web_core;
import web_http;

/// What the server wrote, frame by frame: for each stream up to 255, its HEADERS, its DATA bytes and whether it
/// ended; the GOAWAYs, RST_STREAMs and the largest frame.
struct Tally {
    heads: [u32; 256];
    bytes: [u64; 256];
    ended: [bool; 256];
    goAways: u32;
    lastStream: u32;
    resets: u32;
    largest: usize;
}

fn tally(out: borrow Vector<u8>) -> Result<Tally, TestFailure> {
    var t = Tally {
        heads: [0u32; 256],
        bytes: [0u64; 256],
        ended: [false; 256],
        goAways: 0,
        lastStream: 0,
        resets: 0,
        largest: 0,
    };
    let all = out.view();
    var at: usize = 0;
    while (at + 9 <= all.length) {
        let h = match (Frames.parseHeader(all[at..])) {
            Some(h) => h,
            null => { return Err(TestFailure.create("a frame")); },
        };
        let n = h.length as usize;
        if (at + 9 + n > all.length) {
            return Err(TestFailure.create("a whole frame"));
        }
        if (n > t.largest) {
            t.largest = n;
        }
        let id = h.stream as usize;
        if (id < 256) {
            if (h.kind == FrameTypes.headers()) {
                t.heads[id] += 1;
            } else if (h.kind == FrameTypes.data()) {
                t.bytes[id] += n as u64;
            }
            if ((h.kind == FrameTypes.headers() || h.kind == FrameTypes.data()) && h.flags & FrameFlags.endStream() != 0) {
                t.ended[id] = true;
            }
        }
        if (h.kind == FrameTypes.goAway()) {
            t.goAways += 1;
            t.lastStream = read32(all, at + 9);
        } else if (h.kind == FrameTypes.rstStream()) {
            t.resets += 1;
        }
        at += 9 + n;
    }
    if (at != all.length) {
        return Err(TestFailure.create("trailing bytes"));
    }
    return Ok(t);
}

/// A hundred GETs of `path` on streams 1, 3, … 199, each with END_STREAM.
fn hundred(bytes: borrow mut Vector<u8>, path: StringView) -> Result<void, TestFailure> {
    let get = getBlock(path)?;
    for (k in 0..100u32) {
        frame(bytes, FrameTypes.headers(), FrameFlags.endHeaders() | FrameFlags.endStream(), 2 * k + 1, get.view())?;
    }
    return Ok();
}

@test
async fn a_stream_reset_in_its_body() -> Result<void, TestFailure> {
    // POST /echo on stream 1 sends part of its body, then RST_STREAM (CANCEL, 0x8); a GET on stream 3 follows. Stream 1's
    // handler, waiting for the rest of the body, is cancelled and answers nothing; stream 3 is served (§5.4.2, §6.4).
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    let echo = blockOf(":method: POST\n:scheme: https\n:path: /echo\n:authority: example.test\n")?;
    frame(mut bytes, FrameTypes.headers(), FrameFlags.endHeaders(), 1, echo.view())?;
    frame(mut bytes, FrameTypes.data(), 0, 1, "abc".bytes())?;
    frameHex(mut bytes, FrameTypes.rstStream(), 0, 1, "00000008")?;
    let get = getBlock("/hello")?;
    frame(mut bytes, FrameTypes.headers(), FrameFlags.endHeaders() | FrameFlags.endStream(), 3, get.view())?;
    let out = await served(bytes, 200)?;
    let t = tally(out)?;
    Check.equalU64(0, t.heads[1] as u64)?;
    Check.equalU64(0, t.bytes[1])?;
    Check.equalU64(1, t.heads[3] as u64)?;
    Check.equalU64(5, t.bytes[3])?;
    return Check.isTrue(t.ended[3], "stream 3 ended");
}

@test
async fn a_hundred_streams_cancelled_when_the_client_leaves() -> Result<void, TestFailure> {
    // A hundred handlers each wait 10 s; the client leaves after 100 ms. The connection ends then: every handler is
    // cancelled where it waits (no response, and no frame or task left), not awaited. (The bound leaves room for a
    // slow machine and the interpreter.)
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    hundred(mut bytes, "/stall")?;
    let start = Timer.now();
    let out = await served(bytes, 100)?;
    let took = Timer.now() - start;
    let t = tally(out)?;
    var answered: u64 = 0;
    for (k in 0..100usize) {
        answered += t.heads[2 * k + 1] as u64;
    }
    Check.equalU64(0, answered)?;
    return Check.isTrue(took < 5000, "ended long before the handlers' 10 s");
}

@test
async fn a_hundred_streams_drained() -> Result<void, TestFailure> {
    // The server drains 50 ms in, with a hundred 300 ms handlers running: GOAWAY (NO_ERROR, last stream 199, §6.8), every
    // stream answered in full, then the connection ends, long before the client would leave (10 s).
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    hundred(mut bytes, "/slow")?;
    let start = Timer.now();
    let out = await servedDraining(bytes, 10000, 50)?;
    let took = Timer.now() - start;
    let t = tally(out)?;
    Check.isTrue(t.goAways >= 1, "GOAWAY")?;
    Check.equalU64(199, t.lastStream as u64)?;
    for (k in 0..100usize) {
        let id = 2 * k + 1;
        Check.equalU64(1, t.heads[id] as u64)?;
        Check.equalU64(4, t.bytes[id])?; // "slow"
        Check.isTrue(t.ended[id], "each stream ended")?;
    }
    return Check.isTrue(took < 8000, "ended once the streams were done, before the client left");
}

@test
async fn half_closed_client_gets_every_response() -> Result<void, TestFailure> {
    // Three 300 ms requests, then the client shuts down its sending side after 50 ms but keeps reading (TCP's
    // half-close). The server sends GOAWAY (no stream can start), answers all three, then ends the connection.
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    let slow = getBlock("/slow")?;
    for (k in 0..3u32) {
        frame(mut bytes, FrameTypes.headers(), FrameFlags.endHeaders() | FrameFlags.endStream(), 2 * k + 1, slow.view())?;
    }
    let start = Timer.now();
    let out = await servedHalfClosed(bytes, 50, 0)?;
    let took = Timer.now() - start;
    let t = tally(out)?;
    Check.isTrue(t.goAways >= 1, "GOAWAY")?;
    Check.equalU64(5, t.lastStream as u64)?;
    for (k in 0..3usize) {
        let id = 2 * k + 1;
        Check.equalU64(1, t.heads[id] as u64)?;
        Check.equalU64(4, t.bytes[id])?; // "slow"
        Check.isTrue(t.ended[id], "each stream ended")?;
    }
    return Check.isTrue(took < 5000, "the connection ended once the streams were done");
}

@test
async fn half_closed_client_that_goes_is_found_by_a_probe() -> Result<void, TestFailure> {
    // Ten handlers wait 10 s. The client half-closes at 50 ms and goes at 500 ms, with nothing written meanwhile. A
    // PING each idle second probes it; the first write after it went fails, and the connection ends with its streams
    // cancelled, long before the handlers' 10 s.
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    let stall = getBlock("/stall")?;
    for (k in 0..10u32) {
        frame(mut bytes, FrameTypes.headers(), FrameFlags.endHeaders() | FrameFlags.endStream(), 2 * k + 1, stall.view())?;
    }
    let start = Timer.now();
    let out = await servedHalfClosed(bytes, 50, 500)?;
    let took = Timer.now() - start;
    let t = tally(out)?;
    Check.isTrue(t.goAways >= 1, "GOAWAY before the client went")?;
    Check.equalU64(0, t.heads[1] as u64)?;
    return Check.isTrue(took < 4000, "a probe found the client gone");
}

@test
async fn a_response_held_to_a_small_window() -> Result<void, TestFailure> {
    // SETTINGS_INITIAL_WINDOW_SIZE = 1000 (identifier 0x4): /big may send 1 000 bytes of its 100 000 and must then wait
    // for WINDOW_UPDATE, which never comes (§6.9.2). The stream does not end.
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    frameHex(mut bytes, FrameTypes.settings(), 0, 0, "0004000003e8")?;
    let get = getBlock("/big")?;
    frame(mut bytes, FrameTypes.headers(), FrameFlags.endHeaders() | FrameFlags.endStream(), 1, get.view())?;
    let out = await served(bytes, 300)?;
    let t = tally(out)?;
    Check.equalU64(1, t.heads[1] as u64)?;
    Check.equalU64(1000, t.bytes[1])?;
    return Check.isTrue(!t.ended[1], "not ended");
}

@test
async fn a_response_through_window_updates() -> Result<void, TestFailure> {
    // The same window, then WINDOW_UPDATEs: the stream's by 99 000 and the connection's (65 535 at first, §6.9.2) by
    // 34 465, exactly enough for 100 000 bytes. All of it arrives, in frames of at most 16 384 bytes (§4.2).
    var bytes = Vector<u8>.create();
    preface(mut bytes)?;
    frameHex(mut bytes, FrameTypes.settings(), 0, 0, "0004000003e8")?;
    let get = getBlock("/big")?;
    frame(mut bytes, FrameTypes.headers(), FrameFlags.endHeaders() | FrameFlags.endStream(), 1, get.view())?;
    frameHex(mut bytes, FrameTypes.windowUpdate(), 0, 1, "000182b8")?; // 99 000
    frameHex(mut bytes, FrameTypes.windowUpdate(), 0, 0, "000086a1")?; // 34 465
    let out = await served(bytes, 300)?;
    let t = tally(out)?;
    Check.equalU64(100000, t.bytes[1])?;
    Check.isTrue(t.ended[1], "ended")?;
    return Check.isTrue(t.largest <= 16384, "frames within SETTINGS_MAX_FRAME_SIZE");
}
