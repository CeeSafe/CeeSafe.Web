// Http3Server over real UDP on loopback (Web ADR 0014 amendment 4 item 4, stage 3 part (c)). The application is the
// test's own `Application`; the client is this package's test client (`H3Connection.client` over a QuicConnection on
// its own socket). Six requests at once on one connection, each checked against what the application was written to
// answer (RFC 9114 §4.1 for the framing, RFC 9110 for the statuses):
//   GET /hello     200 "hello, h3"
//   POST /echo     200 and the request's body (1.5 MiB, more than a stream's window), whole
//   GET /big       200 and 3 MiB written in pieces, whole
//   GET /trailers  200 "t" and the trailer `x-check: ok`
//   GET /fail      the handler fails: 500
//   GET /missing   404
import web_core;
import web_http;
import web_quic;

struct TestApp {}

impl Application for TestApp {
    async fn handle(
        borrow this,
        request: borrow Request,
        exchange: borrow mut Exchange,
        connection: borrow ConnectionContext,
    ) -> Result<void, HandlerError> {
        let path = request.path().bytes();
        if (same(path, "/hello")) {
            return await exchange.send(Status.ok(), "hello, h3".bytes());
        }
        if (same(path, "/echo")) {
            var body = match (OwnedBuffer.create(4194304)) {
                Ok(b) => b,
                Err(_) => { return Err(HandlerError.Internal); },
            };
            await exchange.readToEnd(mut body)?;
            return await exchange.send(Status.ok(), body.readable());
        }
        if (same(path, "/big")) {
            exchange.setStatus(Status.ok());
            var piece = [0u8; 10000];
            var at: usize = 0;
            let total: usize = 3 * 1048576;
            while (at < total) {
                let n = if (total - at < piece.length) total - at else piece.length;
                for (i in 0..n) {
                    piece[i] = pattern(at + i);
                }
                await exchange.write(piece[0..n])?;
                at += n;
            }
            return Ok();
        }
        if (same(path, "/trailers")) {
            exchange.setStatus(Status.ok());
            exchange.trailer("x-check", "ok".bytes())?;
            await exchange.write("t".bytes())?;
            return Ok();
        }
        if (same(path, "/fail")) {
            return Err(HandlerError.Internal);
        }
        return Err(HandlerError.Status(Status.notFound()));
    }

    async fn beforeHead(
        borrow this,
        request: borrow Request,
        head: borrow mut ResponseHead,
    ) -> Result<void, HandlerError> => Ok();
}

fn same(a: Slice<u8>, text: StringView) -> bool {
    let b = text.bytes();
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

fn startsWith(a: Slice<u8>, text: StringView) -> bool {
    let b = text.bytes();
    if (a.length < b.length) {
        return false;
    }
    for (i in 0..b.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

/// What the client received on one request's stream.
struct Answer {
    stream: i64;
    fields: Vector<u8>;
    trailers: Vector<u8>;
    data: Vector<u8>;
    ended: bool;
    reset: bool;
}

fn answer() -> Answer => Answer {
    stream: -1,
    fields: Vector<u8>.create(),
    trailers: Vector<u8>.create(),
    data: Vector<u8>.create(),
    ended: false,
    reset: false,
};

fn quic<T>(r: Result<T, QuicError>, what: StringView) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create(what)); }
    }
}

fn indexOf(answers: borrow Vector<Answer>, stream: i64) -> usize? {
    let all = answers.view();
    for (i in 0..all.length) {
        if (all[i].stream == stream) {
            return Some(i);
        }
    }
    return null;
}

/// The echo's request body: 1.5 MiB, more than a stream's flow-control window (1 MiB).
fn echoSize() -> usize => 1572864;

/// The client: connects to `server`, sends the six requests at once, and reads until every answer has ended.
async fn fetch(tls: borrow QuicTls, server: SocketAddress) -> Result<Vector<Answer>, TestFailure> {
    let any = SocketAddress.V4([127u8, 0, 0, 1], 0);
    let socket = match (AsyncUdpSocket.bind(any, UdpOptions.defaults())) {
        Ok(s) => s,
        Err(_) => { return Err(TestFailure.create("the client's socket")); },
    };
    let local = match (socket.localAddress()) {
        Ok(a) => a,
        Err(_) => { return Err(TestFailure.create("the client's address")); },
    };
    let ids = quic(QuicIds.random(), "random IDs")?;
    var conn = quic(
        QuicConnection.client(tls, "localhost", QuicAddress.of(local), QuicAddress.of(server), ids, Clock.monotonicNanos()),
        "the client",
    )?;
    conn.creditOnConsume();
    var client = h3(H3Connection.client(65536), "the client's HTTP/3")?;
    var buffer = Vector<u8>.create();
    var out = Vector<u8>.create();
    mem(buffer.resize(65536, 0))?;
    mem(out.resize(quicDatagramSize(), 0))?;
    var answers = Vector<Answer>.create();
    var started = false;
    var echoSent: usize = 0;
    var echoStream: i64 = -1;
    var piece = [0u8; 16384];
    let deadline = Clock.monotonicNanos() + 30000000000; // 30 s: the transfers take well under one
    loop {
        var done = started;
        for (a in answers.view()) {
            if (!(a.ended || a.reset)) {
                done = false;
            }
        }
        if (done) {
            return Ok(answers);
        }
        if (Clock.monotonicNanos() > deadline) {
            return Err(TestFailure.create("the answers did not all end in 30 s"));
        }
        // QUIC's events, into HTTP/3.
        loop {
            let event = match (quic(conn.nextEvent(buffer.viewMut()), "a QUIC event")?) {
                Some(e) => e,
                null => { break; },
            };
            match (event) {
                QuicEvent.StreamReset(stream, _) => {
                    match (indexOf(answers, stream)) {
                        Some(i) => {
                            let list = answers.viewMut();
                            list[i].reset = true;
                        }
                        null => {}
                    }
                }
                _ => {}
            }
            let n = match (event) {
                QuicEvent.StreamData(_, n, _) => n,
                _ => 0,
            };
            h3(H3Glue.onQuic(mut client, mut conn, event, buffer.view()[0..n]), "HTTP/3's read")?;
        }
        if (!started && conn.handshakeDone()) {
            h3(H3Glue.start(mut client, mut conn), "HTTP/3's streams")?;
            let all = ["/hello", "/echo", "/big", "/trailers", "/fail", "/missing"];
            for (k in 0..all.length) {
                let stream = quic(conn.openStream(), "a request stream")?;
                var f = H3Fields.create();
                let method = if (k == 1) "POST" else "GET";
                mem(f.add(":method".bytes(), method.bytes()))?;
                mem(f.add(":scheme".bytes(), "https".bytes()))?;
                mem(f.add(":authority".bytes(), "localhost".bytes()))?;
                mem(f.add(":path".bytes(), all[k].bytes()))?;
                h3(client.request(stream, f, k == 1), "a request")?;
                var a = answer();
                a.stream = stream;
                mem(answers.push(a))?;
                if (k == 1) {
                    echoStream = stream;
                }
            }
            started = true;
        }
        // HTTP/3's events, into the answers.
        loop {
            let event = match (h3(client.nextEvent(buffer.viewMut()), "an HTTP/3 event")?) {
                Some(e) => e,
                null => { break; },
            };
            h3(H3Glue.obey(mut client, mut conn, event), "obeying HTTP/3")?;
            match (event) {
                H3Event.Field(stream, nameLength, valueLength, trailer) => {
                    match (indexOf(answers, stream)) {
                        Some(i) => {
                            let list = answers.viewMut();
                            let a = borrow mut list[i];
                            let into = if (trailer) borrow mut a.trailers else borrow mut a.fields;
                            mem(into.extend(buffer.view()[0..nameLength]))?;
                            mem(into.extend(": ".bytes()))?;
                            mem(into.extend(buffer.view()[nameLength..nameLength + valueLength]))?;
                            mem(into.push(10))?;
                        }
                        null => {}
                    }
                }
                H3Event.FieldsEnd(stream, _, fin) => {
                    if (fin) {
                        match (indexOf(answers, stream)) {
                            Some(i) => {
                                let list = answers.viewMut();
                                list[i].ended = true;
                            }
                            null => {}
                        }
                    }
                }
                H3Event.Data(stream, n) => {
                    match (indexOf(answers, stream)) {
                        Some(i) => {
                            let list = answers.viewMut();
                            mem(list[i].data.extend(buffer.view()[0..n]))?;
                        }
                        null => {}
                    }
                    conn.consume(stream, n as u64);
                }
                H3Event.End(stream) => {
                    match (indexOf(answers, stream)) {
                        Some(i) => {
                            let list = answers.viewMut();
                            list[i].ended = true;
                        }
                        null => {}
                    }
                }
                _ => {}
            }
        }
        // The echo's body, as far as its queue takes it.
        while (started && echoSent < echoSize()) {
            let n = if (echoSize() - echoSent < piece.length) echoSize() - echoSent else piece.length;
            for (i in 0..n) {
                piece[i] = pattern(echoSent + i);
            }
            let taken = h3(client.sendBody(echoStream, piece[0..n], echoSent + n == echoSize()), "the echo's body")?;
            echoSent += taken;
            if (taken < n) {
                break;
            }
        }
        if (started) {
            h3(H3Glue.flush(mut client, mut conn, out.viewMut()), "HTTP/3's write")?;
        }
        // Datagrams out.
        loop {
            let d = match (quic(conn.datagram(out.viewMut(), Clock.monotonicNanos()), "a datagram")?) {
                Some(d) => d,
                null => { break; },
            };
            match (await socket.sendTo(out.view()[0..d.length], server)) {
                Ok() => {}
                Err(_) => { return Err(TestFailure.create("sending")); }
            }
        }
        // A datagram, or the connection's timer (at most 10 ms, so the echo's body keeps flowing).
        let now = Clock.monotonicNanos();
        var waitMs: u64 = match (conn.nextTimeout()) {
            Some(t) => if (t <= now) 0 else (t - now + 999999) / 1000000,
            null => 1000,
        };
        if (waitMs > 10) {
            waitMs = 10;
        }
        if (waitMs == 0) {
            quic(conn.onTimeout(now), "a timer")?;
            continue;
        }
        let raced: Result<Raced<Datagram?>, AsyncError> = await Async.race(
            async () => {
                let d = await socket.recvFrom(buffer.viewMut())?;
                return Ok(Some(d));
            },
            async () => {
                await Timer.sleep(waitMs)?;
                return Ok(null);
            },
        );
        let won: Raced<Datagram?> = match (raced) {
            Ok(w) => w,
            Err(_) => { return Err(TestFailure.create("waiting")); },
        };
        let datagram: Datagram? = if (won.winner == 0) won.value else match (won.other) {
            Some(d) => d,
            null => won.value,
        };
        match (datagram) {
            Some(d) => {
                quic(conn.feed(QuicAddress.of(d.from), 0, buffer.view()[0..d.length], Clock.monotonicNanos()), "a read")?;
            }
            null => {
                let t = Clock.monotonicNanos();
                match (conn.nextTimeout()) {
                    Some(due) => {
                        if (due <= t) {
                            quic(conn.onTimeout(t), "a timer")?;
                        }
                    }
                    null => {}
                }
            }
        }
    }
}

/// How the race between the server and the client ended.
enum Ended {
    Server,
    Client(Vector<Answer>),
    ClientFailed(TestFailure),
}

fn isPattern(bytes: Slice<u8>) -> bool {
    for (i in 0..bytes.length) {
        if (bytes[i] != pattern(i)) {
            return false;
        }
    }
    return true;
}

@test
async fn six_requests_over_udp() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let alpn = [Alpn.Http3];
    let serverTls = quic(QuicTls.serverFromPem(serverPem().bytes(), serverKey().bytes(), alpn[..]), "server TLS")?;
    let clientTls = quic(QuicTls.clientFromPem(caPem().bytes(), alpn[..]), "client TLS")?;
    let any = SocketAddress.V4([127u8, 0, 0, 1], 0);
    let socket = match (AsyncUdpSocket.bind(any, UdpOptions.defaults())) {
        Ok(s) => s,
        Err(_) => { return Err(TestFailure.create("the server's socket")); },
    };
    let local = match (socket.localAddress()) {
        Ok(a) => a,
        Err(_) => { return Err(TestFailure.create("the server's address")); },
    };
    let tls = match (Arc<QuicTls>.create(serverTls)) {
        Ok(t) => t,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    let boxed: Box<dyn Application + Send> = match (Box.create(TestApp {})) {
        Ok(b) => b,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    let app = match (Arc<Box<dyn Application + Send>>.create(boxed)) {
        Ok(a) => a,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    let drain = match (Drain.create()) {
        Ok(d) => d,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    let raced: Result<Raced<Ended>, AsyncError> = await Async.race(
        async move () => {
            let _ = await Http3Server.serve(socket, local, tls, app, Limits.defaults(), drain, Http3Options.defaults());
            return Ok(Ended.Server);
        },
        async () => {
            match (await fetch(clientTls, local)) {
                Ok(a) => { return Ok(Ended.Client(a)); }
                Err(e) => { return Ok(Ended.ClientFailed(e)); }
            }
        },
    );
    let answers = match (raced) {
        Ok(won) => match (won.value) {
            Ended.Client(a) => a,
            Ended.ClientFailed(e) => { return Err(e); },
            Ended.Server => { return Err(TestFailure.create("the server ended before the client")); },
        },
        Err(_) => { return Err(TestFailure.create("the race")); },
    };
    let all = answers.view();
    Check.equalU64(6, all.length as u64)?;
    // GET /hello
    Check.isTrue(startsWith(all[0].fields.view(), ":status: 200\n"), "/hello: 200 first")?;
    Check.equalBytes("hello, h3".bytes(), all[0].data.view())?;
    // POST /echo
    Check.isTrue(startsWith(all[1].fields.view(), ":status: 200\n"), "/echo: 200")?;
    Check.equalU64(echoSize() as u64, all[1].data.length as u64)?;
    Check.isTrue(isPattern(all[1].data.view()), "/echo: the body back, in order")?;
    // GET /big
    Check.isTrue(startsWith(all[2].fields.view(), ":status: 200\n"), "/big: 200")?;
    Check.equalU64(3 * 1048576, all[2].data.length as u64)?;
    Check.isTrue(isPattern(all[2].data.view()), "/big: the bytes, in order")?;
    // GET /trailers
    Check.isTrue(startsWith(all[3].fields.view(), ":status: 200\n"), "/trailers: 200")?;
    Check.equalBytes("t".bytes(), all[3].data.view())?;
    Check.equalBytes("x-check: ok\n".bytes(), all[3].trailers.view())?;
    // GET /fail and /missing
    Check.isTrue(startsWith(all[4].fields.view(), ":status: 500\n"), "/fail: 500")?;
    Check.isTrue(startsWith(all[5].fields.view(), ":status: 404\n"), "/missing: 404")?;
    for (a in all) {
        Check.isTrue(a.ended && !a.reset, "every answer ended, none reset")?;
    }
    return Ok();
}
