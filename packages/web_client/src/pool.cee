// The connection pool (Web ADR 0009 §3.4): per origin, idle connections and a semaphore of slots. A request holds one
// of its origin's `maxPerOrigin` slots from before it has a connection until its response gives the connection back
// or closes it; an idle connection holds none. A request takes an idle connection before it makes a new one, so an
// origin never has more than `maxPerOrigin` connections, and a request that waits for a slot gets the connection
// that the request before it gave back. Behind an AsyncMutex, so concurrent requests share it (the connections are
// `Send`, §2).
import web_core;
import web_transport;
import web_http;

struct Idle {
    conn: Box<dyn Transport + Send>;
    since: u64;
    /// The read buffer the connection's last response used, empty: the next response on it reads into it again.
    carry: OwnedBuffer;
}

struct Origin {
    secure: bool;
    host: Vector<u8>;
    port: u16;
    idle: Vector<Idle>;
    /// The semaphore: a token per free slot.
    slots: Channel<u8>;
    /// Requests and retries, for the retry budget.
    requests: u64;
    retries: u64;
}

struct PoolState {
    origins: Vector<Origin>;
    closed: bool;
}

/// A taken connection: a pooled one with its read buffer (a reuse race is possible), or a slot for a new one.
enum Taken {
    Reused(Box<dyn Transport + Send>, OwnedBuffer),
    Slot,
}

struct ConnectionPool {
    state: AsyncMutex<PoolState>;
    maxPerOrigin: u32;
    maxIdle: u32;
    idleTimeoutMs: u64;

    fn create(options: borrow ClientOptions) -> Result<ConnectionPool, ClientError> {
        let state = PoolState { origins: Vector<Origin>.create(), closed: false };
        match (AsyncMutex<PoolState>.create(state)) {
            Ok(m) => {
                return Ok(ConnectionPool {
                    state: m,
                    maxPerOrigin: if (options.maxPerOrigin == 0) 1 else options.maxPerOrigin,
                    maxIdle: options.maxIdlePerOrigin,
                    idleTimeoutMs: options.idleTimeoutMs,
                });
            }
            Err(_) => { return Err(ClientError.Net(NetError.OutOfMemory)); }
        }
    }

    /// A place among the origin's requests, with a connection for it: the origin's newest idle connection that is
    /// fresh enough (`Reused`), or none (`Slot`: the caller makes one, and frees the slot if it cannot). With every
    /// slot taken the request waits, until `total`, and takes the connection a finished request gives back. The
    /// request is counted for the retry budget.
    async fn acquire(borrow this, url: borrow Url, total: Deadline) -> Result<Taken, ClientError> {
        var slots: Channel<u8>? = null;
        {
            var guard = locked(await this.state.lock())?;
            let s = guard.data();
            if (s.closed) {
                return Err(ClientError.Shutdown);
            }
            let i = this.originIndex(s, url)?;
            let o = borrow mut s.origins[i];
            o.requests += 1;
            match (o.slots.tryRecv()) {
                Some(_) => { return Ok(this.newestIdle(o)); }
                null => { slots = Some(o.slots.clone()); }
            }
        }
        let waiting = match (slots) {
            Some(c) => c,
            null => { return Err(ClientError.Shutdown); },
        };
        let got = if (total.isNever()) await waiting.recvAsync() else await Async.deadline(
            total.instant(),
            AsyncError.TimedOut,
            async () => await waiting.recvAsync(),
        );
        match (got) {
            Ok(Some(_)) => {}
            Ok(null) => { return Err(ClientError.Shutdown); }
            Err(e) => { return Err(ClientError.Net(NetErrors.fromAsync(e))); }
        }
        // The slot is this request's now. Whoever freed it may have left its connection in the pool.
        var guard = match (await this.state.lock()) {
            Ok(g) => g,
            Err(e) => {
                let freed = waiting.trySend(0);
                return Err(ClientError.Net(NetErrors.fromAsync(e)));
            },
        };
        let s = guard.data();
        let i = match (this.originIndex(s, url)) {
            Ok(i) => i,
            Err(e) => {
                let freed = waiting.trySend(0);
                return Err(e);
            },
        };
        return Ok(this.newestIdle(borrow mut s.origins[i]));
    }

    /// The origin's newest idle connection within the idle timeout, the older ones closed; `Slot` if there is none.
    /// An idle connection holds no slot: its request gave the slot back with it.
    fn newestIdle(borrow this, o: borrow mut Origin) -> Taken {
        let now = Timer.now();
        loop {
            let idle = match (o.idle.pop()) {
                Some(x) => x,
                null => { return Taken.Slot; },
            };
            if (now - idle.since <= this.idleTimeoutMs) {
                return Taken.Reused(idle.conn, idle.carry);
            }
        }
    }

    /// A clone of the origin's slot semaphore.
    async fn slots(borrow this, url: borrow Url) -> Result<Channel<u8>, ClientError> {
        var guard = locked(await this.state.lock())?;
        let s = guard.data();
        if (s.closed) {
            return Err(ClientError.Shutdown);
        }
        let i = this.originIndex(s, url)?;
        return Ok(s.origins[i].slots.clone());
    }

    /// Returns a reusable connection and frees its request's slot; the connection is closed instead when the pool is
    /// shut down or full of idle ones.
    async fn give(borrow this, url: borrow Url, conn: Box<dyn Transport + Send>, carry: OwnedBuffer) {
        var guard = match (await this.state.lock()) {
            Ok(g) => g,
            Err(_) => { return; },
        };
        let s = guard.data();
        let i = match (this.originIndex(s, url)) {
            Ok(i) => i,
            Err(_) => { return; },
        };
        let o = borrow mut s.origins[i];
        if (s.closed || o.idle.length >= this.maxIdle as usize) {
            let freed = o.slots.trySend(0);
            return;
        }
        // The connection first, then the slot: a request that the slot wakes finds the connection.
        let pushed = o.idle.push(Idle { conn: conn, since: Timer.now(), carry: carry });
        let freed = o.slots.trySend(0);
    }

    /// Whether the origin's retry budget allows one more retry; it is spent if so.
    async fn mayRetry(borrow this, url: borrow Url, policy: borrow RetryPolicy) -> bool {
        var guard = match (await this.state.lock()) {
            Ok(g) => g,
            Err(_) => { return false; },
        };
        let s = guard.data();
        let i = match (this.originIndex(s, url)) {
            Ok(i) => i,
            Err(_) => { return false; },
        };
        let o = borrow mut s.origins[i];
        let earned = policy.budgetInitial as u64 + o.requests * policy.budgetPercent as u64 / 100;
        if (o.retries >= earned) {
            return false;
        }
        o.retries += 1;
        return true;
    }

    /// Closes every idle connection; later requests fail with `Shutdown`.
    async fn shutdown(borrow this) {
        var guard = match (await this.state.lock()) {
            Ok(g) => g,
            Err(_) => { return; },
        };
        let s = guard.data();
        s.closed = true;
        for (i in 0..s.origins.length) {
            let o = borrow mut s.origins[i];
            while (o.idle.length > 0) {
                let dropped = o.idle.pop();
            }
            o.slots.close(); // waiters for a slot wake and see the shutdown
        }
    }

    /// The origin's index, made if new.
    fn originIndex(borrow this, s: borrow mut PoolState, url: borrow Url) -> Result<usize, ClientError> {
        for (i in 0..s.origins.length) {
            let o = borrow s.origins[i];
            if (o.secure == url.isSecure() && o.port == url.port() && same(o.host.view(), url.host())) {
                return Ok(i);
            }
        }
        let slots = match (Channel<u8>.create(this.maxPerOrigin as usize)) {
            Ok(c) => c,
            Err(_) => { return Err(ClientError.Net(NetError.OutOfMemory)); },
        };
        for (k in 0..this.maxPerOrigin) {
            let filled = slots.trySend(0);
        }
        var host = Vector<u8>.create();
        match (host.extend(url.host())) {
            Ok() => {}
            Err(_) => { return Err(ClientError.Net(NetError.OutOfMemory)); }
        }
        let o = Origin {
            secure: url.isSecure(),
            host: host,
            port: url.port(),
            idle: Vector<Idle>.create(),
            slots: slots,
            requests: 0,
            retries: 0,
        };
        match (s.origins.push(o)) {
            Ok() => { return Ok(s.origins.length - 1); }
            Err(_) => { return Err(ClientError.Net(NetError.OutOfMemory)); }
        }
    }
}

fn locked<T>(r: Result<T, AsyncError>) -> Result<T, ClientError> {
    match (r) {
        Ok(g) => { return Ok(g); }
        Err(e) => { return Err(ClientError.Net(NetErrors.fromAsync(e))); }
    }
}

fn same(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}
