// The connection server (implementation plan M1, docs/milestones/M1.md): a fixed set of connection workers, each
// looping accept → handshake → serve on one shared source. A CeeSafe scope spawns only in its body (spec §40.5), so
// the workers are the admission limit: when all are busy, nobody accepts and the kernel's backlog holds the rest.
// One idle worker at a time waits for the next connection (`Turns`), and the turn passes to the worker idle the
// shortest time: a worker's frame is allocated whole at spawn, and its pages become resident when it first serves,
// so taking turns oldest-first (as the accepts queued in the kernel would) touched every worker's frame and made the
// resident size follow the limit, not the connections served at once (cee-proxy's soak: 2,048 workers, +22 MB).
// A drain stops the accepting workers at once, lets connections in flight finish for a grace period, then cancels.
import web_core;

/// Where connections come from: a TCP listener, or a queue of mocks in tests. Shared by every worker.
public interface Incoming {
    /// The next connection. `Err(Closed)` when the source has ended (no more will come).
    async fn next(borrow this) -> Result<PlainStream, NetError>;
}

impl Incoming for Listener {
    async fn next(borrow this) -> Result<PlainStream, NetError> {
        return await this.accept();
    }
}

/// Serves one connection: the protocol driver (HTTP/1.1, M2) or a test's handler.
public interface ConnectionHandler {
    /// Serves `conn` until done. Between requests, a handler races its idle wait against the drain
    /// (`drainStarted(ctx.drain())`) and returns `Ok` when the drain wins. `Ok` lets the server close gracefully; an
    /// error drops the connection.
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError>;
}

/// A queue of scripted connections for tests: push mocks, then close it to end the server's source.
@noncopy
public struct MockIncoming {
    private queue: Channel<MockTransport>;

    /// A queue holding up to `capacity` connections not yet accepted.
    public fn create(capacity: usize) -> Result<MockIncoming, NetError> {
        match (Channel<MockTransport>.create(capacity)) {
            Ok(c) => { return Ok(MockIncoming { queue: c }); }
            Err(e) => { return Err(NetErrors.fromAlloc(e)); }
        }
    }

    /// Queues a connection; `Err(LimitExceeded)` if the queue is full or closed.
    public fn push(borrow this, m: MockTransport) -> Result<void, NetError> {
        match (this.queue.trySend(m)) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(NetError.LimitExceeded); }
        }
    }

    /// No more connections: once the queue is empty, `next` returns `Err(Closed)`.
    public fn close(borrow this) {
        this.queue.close();
    }
}

impl Incoming for MockIncoming {
    async fn next(borrow this) -> Result<PlainStream, NetError> {
        match (await this.queue.recvAsync()) {
            Ok(Some(m)) => { return Ok(PlainStream.mock(m)); }
            Ok(null) => { return Err(NetError.Closed); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }
}

/// What a server did, counted by every worker.
public struct ServerReport {
    /// Connections taken from the source.
    public accepted: u64;
    /// Connections whose acceptor step failed or timed out.
    public handshakesFailed: u64;
    /// Connections whose handler returned `Ok`.
    public served: u64;
    /// Connections whose handler returned an error.
    public failed: u64;
    /// Failed accepts (the worker paused and tried again).
    public acceptErrors: u64;
    /// `run`: workers that took at least one connection, the ones whose frames became resident (`Turns`).
    /// `runIsolated`: the most connections served at once.
    public workersUsed: u64;
    /// Tasks that trapped and ended alone (CeeSafe ADR 0175): under `runIsolated` connections, whose memory and
    /// descriptor are leaked; under either, a connection's isolated requests and streams (Web ADR 0016 §2.3, Web ADR
    /// 0017 §2.2), each answered 500 or reset. `Isolation.report()` counts the memory they left.
    public crashed: u64;
    /// Whether the grace period ran out and connections in flight were cancelled.
    public forced: bool;
}

/// The workers' shared counters.
struct Counters {
    accepted: AtomicU64;
    handshakesFailed: AtomicU64;
    served: AtomicU64;
    failed: AtomicU64;
    acceptErrors: AtomicU64;
    workersUsed: AtomicU64;
    crashed: AtomicU64;
    /// The crashes of connections' requests and streams, which their contexts count (`ConnectionContext.countCrash`).
    requests: Arc<AtomicU64>;
    /// `runIsolated`: connections being served now.
    live: AtomicU64;

    fn create() -> Result<Counters, NetError> {
        let requests = match (Arc<AtomicU64>.create(AtomicU64.create(0))) {
            Ok(r) => r,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        return Ok(Counters {
            accepted: AtomicU64.create(0),
            handshakesFailed: AtomicU64.create(0),
            served: AtomicU64.create(0),
            failed: AtomicU64.create(0),
            acceptErrors: AtomicU64.create(0),
            workersUsed: AtomicU64.create(0),
            crashed: AtomicU64.create(0),
            requests: requests,
            live: AtomicU64.create(0),
        });
    }

    fn report(borrow this, forced: bool) -> ServerReport => ServerReport {
        accepted: this.accepted.load(),
        handshakesFailed: this.handshakesFailed.load(),
        served: this.served.load(),
        failed: this.failed.load(),
        acceptErrors: this.acceptErrors.load(),
        workersUsed: this.workersUsed.load(),
        crashed: this.crashed.load() + this.requests.get().load(),
        forced: forced,
    };
}

/// Whose turn it is to wait for the next connection: one idle worker at a time; the others wait on their own
/// channel, last in first out, so the workers that serve are the ones that served last.
struct Turns {
    state: AsyncMutex<TurnState>; // held for a few instructions, never across another await
    wake: Vector<Channel<bool>>;  // a worker's: `true` hands it the turn, `false` (or closed) ends it
}

struct TurnState {
    free: bool;        // nobody holds the turn: the next worker to want it takes it
    idle: Vector<u32>; // the workers waiting for it, the latest last
    ended: bool;       // the source ended: no more turns
}

impl Turns {
    fn create(workers: u32) -> Result<Turns, NetError> {
        var idle = Vector<u32>.create();
        match (idle.reserve(workers as usize)) {
            Ok() => {}
            Err(e) => { return Err(NetErrors.fromAlloc(e)); }
        }
        var wake = Vector<Channel<bool>>.create();
        for (k in 0..workers) {
            match (Channel<bool>.create(1)) {
                Ok(c) => {
                    match (wake.push(c)) {
                        Ok() => {}
                        Err(e) => { return Err(NetErrors.fromAlloc(e)); }
                    }
                }
                Err(e) => { return Err(NetErrors.fromAlloc(e)); }
            }
        }
        let state = match (AsyncMutex<TurnState>.create(TurnState { free: true, idle: idle, ended: false })) {
            Ok(m) => m,
            Err(e) => { return Err(NetErrors.fromAlloc(e)); },
        };
        return Ok(Turns { state: state, wake: wake });
    }

    /// Takes the turn, at once when it is free, else when a worker passes it: `true`. `false` once the source has
    /// ended. `Err(Cancelled)` when the drain starts first (or the task is cancelled).
    async fn take(borrow this, me: u32, drain: borrow Drain) -> Result<bool, NetError> {
        {
            var guard = await this.locked()?;
            let s = guard.data();
            if (s.ended) {
                return Ok(false);
            }
            if (s.free) {
                s.free = false;
                return Ok(true);
            }
            match (s.idle.push(me)) {
                Ok() => {} // reserved for every worker: never allocates
                Err(_) => { return Err(NetError.OutOfMemory); }
            }
        }
        let channel = borrow this.wake[me as usize];
        let r: Result<Raced<bool>, NetError> = await Async.race(
            async () => await turnGiven(channel),
            async () => await drainStarted<bool>(drain),
        );
        return match (r) {
            Ok(raced) => Ok(raced.value),
            Err(e) => Err(e),
        };
    }

    /// Passes the turn to the worker idle the shortest time, or leaves it free when none is.
    async fn pass(borrow this) -> Result<void, NetError> {
        var guard = await this.locked()?;
        let s = guard.data();
        match (s.idle.pop()) {
            Some(w) => { let sent = this.wake[w as usize].trySend(true); }
            null => { s.free = true; }
        }
        return Ok();
    }

    /// The source has ended: no worker will take the turn again, and the idle ones end now.
    async fn end(borrow this) -> Result<void, NetError> {
        var guard = await this.locked()?;
        let s = guard.data();
        s.ended = true;
        loop {
            match (s.idle.pop()) {
                Some(w) => { let sent = this.wake[w as usize].trySend(false); }
                null => { break; }
            }
        }
        return Ok();
    }

    async fn locked(borrow this) -> Result<AsyncMutexGuard<TurnState>, NetError> {
        return match (await this.state.lock()) {
            Ok(g) => Ok(g),
            Err(e) => Err(NetErrors.fromAsync(e)),
        };
    }
}

/// Waits on a worker's channel: what it is sent, or `false` when it is closed.
async fn turnGiven(channel: borrow Channel<bool>) -> Result<bool, NetError> {
    return match (await channel.recvAsync()) {
        Ok(Some(given)) => Ok(given),
        Ok(null) => Ok(false),
        Err(e) => Err(NetErrors.fromAsync(e)),
    };
}

/// Runs connection servers.
public struct ConnectionServer {
    /// Serves connections from `incoming` with `limits.workers` workers until the drain finishes, or until `incoming`
    /// ends and every connection is done. Once `drain` starts, idle workers stop at once and connections in flight
    /// have `limits.graceMs` to finish; then they are cancelled (`forced` in the report). A connection's failure ends
    /// that connection only.
    public async fn run(
        incoming: borrow dyn Incoming,
        acceptor: borrow dyn Acceptor,
        handler: borrow dyn ConnectionHandler,
        limits: borrow ConnectionLimits,
        drain: borrow Drain,
    ) -> Result<ServerReport, NetError> {
        let counters = Counters.create()?;
        let turns = Turns.create(limits.workers)?;
        let r: Result<Raced<bool>, NetError> = await Async.race(
            async () => {
                await Async.scope(NetError.OutOfMemory, (s) => {
                    for (k in 0..limits.workers) {
                        s.spawn(
                            async () => await worker(incoming, acceptor, handler, limits, drain, counters, turns, k),
                        );
                    }
                })?;
                return Ok(false);
            },
            async () => {
                await drain.wait()?;
                match (await Timer.sleep(limits.graceMs)) {
                    Ok() => { return Ok(true); }
                    Err(e) => { return Err(NetErrors.fromAsync(e)); }
                }
            },
        );
        match (r) {
            Ok(raced) => { return Ok(counters.report(raced.value)); }
            Err(e) => { return Err(e); }
        }
    }

    /// Serves connections from `incoming` as `run` does, each in a task of its own that is isolated (Web ADR 0016,
    /// CeeSafe ADR 0175): a trap in a connection's acceptor step or handler ends that connection, whose socket is shut,
    /// and the server goes on. At most `limits.workers` are served at once. A crash is counted in the report's
    /// `crashed`; what the connection held is leaked, and `Isolation.report()` counts its memory. A trap under C (a
    /// TLS callback) or in a `Critical` still ends the process.
    public async fn runIsolated(
        incoming: borrow dyn Incoming,
        acceptor: Arc<Box<dyn Acceptor + Send + Share>>,
        handler: Arc<Box<dyn ConnectionHandler + Send + Share>>,
        limits: borrow ConnectionLimits,
        drain: borrow Drain,
    ) -> Result<ServerReport, NetError> {
        let counters = match (Arc<Counters>.create(Counters.create()?)) {
            Ok(c) => c,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        let copied = match (limits.copy()) {
            Ok(l) => l,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        let shared = match (Arc<ConnectionLimits>.create(copied)) {
            Ok(l) => l,
            Err(_) => { return Err(NetError.OutOfMemory); },
        };
        let workers = if (limits.workers == 0) 1u32 else limits.workers;
        // The set's crashes, and the connections that finished. Each is sent with `trySend`, so neither may fill:
        // while the accepting task waits in `spawnIsolated` every running connection may end, and the one it then
        // starts may end before `spawnIsolated` returns, so `workers + 1` can arrive before it reads them. A lost
        // finish would keep its entry in `kept`, and the drain would wait out the grace for it.
        let crashes = channel<TaskCrash>(2 * workers as usize)?;
        let finished = channel<u64>(2 * workers as usize)?;
        let r: Result<Raced<bool>, NetError> = await Async.race(
            async () => {
                let served = await Async.tasks(workers, NetError.Reset, async (set) =>
                    await acceptIsolated(set, incoming, acceptor, handler, shared, drain, counters, crashes, finished));
                // A crashed task is the set's `Reset`, which no connection's own result is: `serveConnection` fails
                // only when cancelled.
                match (served) {
                    Ok() => { return Ok(false); }
                    Err(NetError.Reset) => { return Ok(false); }
                    Err(e) => { return Err(e); }
                }
            },
            async () => {
                await drain.wait()?;
                match (await Timer.sleep(limits.graceMs)) {
                    Ok() => { return Ok(true); }
                    Err(e) => { return Err(NetErrors.fromAsync(e)); }
                }
            },
        );
        match (r) {
            Ok(raced) => { return Ok(counters.get().report(raced.value)); }
            Err(e) => { return Err(e); }
        }
    }
}

/// One worker: accept, hand shake, serve, close; again until the drain starts or the source ends. Only cancellation
/// ends a worker with an error.
async fn worker(
    incoming: borrow dyn Incoming,
    acceptor: borrow dyn Acceptor,
    handler: borrow dyn ConnectionHandler,
    limits: borrow ConnectionLimits,
    drain: borrow Drain,
    counters: borrow Counters,
    turns: borrow Turns,
    me: u32,
) -> Result<void, NetError> {
    var scratch = [0u8; 64];
    var used = false;
    loop {
        if (drain.isDraining()) {
            return Ok();
        }
        match (await turns.take(me, drain)) {
            Ok(true) => {}
            Ok(false) => { return Ok(); } // the source ended
            Err(NetError.Cancelled) => {
                if (drain.isDraining()) {
                    return Ok();
                }
                return Err(NetError.Cancelled);
            }
            Err(e) => { return Err(e); }
        }
        let next: Result<Raced<PlainStream>, NetError> = await Async.race(
            async () => await incoming.next(),
            async () => await drainStarted<PlainStream>(drain),
        );
        var stream = match (next) {
            Ok(raced) => {
                await turns.pass()?; // before the handshake, which may take its whole deadline
                raced.value
            },
            Err(NetError.Closed) => {
                await turns.end()?; // the source ended
                return Ok();
            }
            Err(NetError.Cancelled) => {
                if (drain.isDraining()) {
                    return Ok();
                }
                return Err(NetError.Cancelled);
            }
            Err(NetError.OutOfMemory) => {
                let passed = await turns.pass();
                return Err(NetError.OutOfMemory);
            }
            Err(_) => {
                let failed = counters.acceptErrors.fetchAdd(1);
                match (await Timer.sleep(limits.acceptBackoffMs)) {
                    Ok() => {}
                    Err(e) => { return Err(NetErrors.fromAsync(e)); }
                }
                await turns.pass()?;
                continue;
            }
        };
        let id = counters.accepted.fetchAdd(1);
        if (!used) {
            used = true;
            let first = counters.workersUsed.fetchAdd(1);
        }
        await serveConnection(stream, acceptor, handler, limits, drain, counters, id, mut scratch[..])?;
    }
}

/// One connection, from the accepted stream to its close: the PROXY header where the limits ask for one, the
/// acceptor's step, the handler, the graceful close. A failure is counted and ends this connection only; only
/// cancellation is an error.
async fn serveConnection(
    given: PlainStream,
    acceptor: borrow dyn Acceptor,
    handler: borrow dyn ConnectionHandler,
    limits: borrow ConnectionLimits,
    drain: borrow Drain,
    counters: borrow Counters,
    id: u64,
    scratch: SliceMut<u8>,
) -> Result<void, NetError> {
    var stream = given;
    let handshake = Deadline.after(limits.handshakeMs);
    // Behind a balancer that speaks the PROXY protocol (Web ADR 0012 §3.6, amendment 2): from a source it lists,
    // the header first, read exactly, within the handshake's time; any other source is closed unread.
    var said = ProxyHeader.Local;
    if (!limits.proxyProtocolFrom.isEmpty()) {
        var s = stream;
        let from = match (s.peerAddress()) {
            Some(a) => limits.proxyProtocolFrom.trusts(a),
            null => false,
        };
        if (!from) {
            let failed = counters.handshakesFailed.fetchAdd(1);
            return Ok();
        }
        match (await readProxyHeader(mut s, handshake)) {
            Ok(h) => { said = h; }
            Err(NetError.Cancelled) => { return Err(NetError.Cancelled); }
            Err(_) => {
                let failed = counters.handshakesFailed.fetchAdd(1);
                return Ok();
            }
        }
        stream = s;
    }
    var conn = match (await acceptor.accept(stream, handshake)) {
        Ok(c) => c,
        Err(NetError.Cancelled) => { return Err(NetError.Cancelled); }
        Err(_) => {
            let failed = counters.handshakesFailed.fetchAdd(1);
            return Ok();
        }
    };
    var identity = PeerIdentity.empty();
    let verified = conn.peerIdentity(mut identity); // a TLS client certificate, copied before `conn` is lent out
    var peer = conn.peerAddress();
    var local = conn.localAddress();
    match (said) {
        ProxyHeader.Proxied(from, to) => {
            peer = Some(from);
            local = Some(to);
        }
        ProxyHeader.Local => {}
    }
    let ctx = ConnectionContext.acceptedNow(id, drain)
        .withAddresses(peer, local)
        .withPeerIdentity(identity)
        .withCrashCounter(Some(counters.requests.clone()));
    match (await handler.serve(mut conn, ctx)) {
        Ok() => {
            let done = counters.served.fetchAdd(1);
            match (await Transports.closeGracefully(mut conn, scratch, Deadline.after(limits.closeLingerMs))) {
                Err(NetError.Cancelled) => { return Err(NetError.Cancelled); }
                _ => {} // the peer lingered or failed: the drop closes the socket anyway
            }
        }
        Err(NetError.Cancelled) => { return Err(NetError.Cancelled); }
        Err(_) => {
            let failed = counters.failed.fetchAdd(1);
        }
    }
    return Ok();
}

/// A connection in an isolated task, as the accepting task keeps it (Web ADR 0016 §2.2): its number, the task's
/// number, and the closer that ends it for the peer if the task traps.
struct Isolated {
    connection: u64;
    task: u64;
    closer: StreamCloser?;
}

/// What the accepting task of `runIsolated` waits for.
enum Arrival {
    Stream(PlainStream),
    /// A crash, a finished connection, or both: a race that both sides won gives both.
    Events(TaskCrash?, u64?),
    /// The source ended (`Closed`), or the drain started: no more connections are taken.
    NoMore,
    /// An accept failed (out of descriptors, say): paused, then tried again.
    AcceptFailed,
}

/// The next stream, or why there is none.
async fn nextStream(incoming: borrow dyn Incoming, drain: borrow Drain) -> Result<Arrival, NetError> {
    let next: Result<Raced<PlainStream>, NetError> = await Async.race(
        async () => await incoming.next(),
        async () => await drainStarted<PlainStream>(drain),
    );
    return match (next) {
        Ok(raced) => Ok(Arrival.Stream(raced.value)),
        Err(NetError.Closed) => Ok(Arrival.NoMore),
        Err(NetError.Cancelled) => if (drain.isDraining()) Ok(Arrival.NoMore) else Err(NetError.Cancelled),
        Err(NetError.OutOfMemory) => Err(NetError.OutOfMemory),
        Err(_) => Ok(Arrival.AcceptFailed),
    };
}

/// The next crash or finished connection, or both.
async fn nextEvent(crashes: borrow Channel<TaskCrash>, finished: borrow Channel<u64>) -> Result<Arrival, NetError> {
    let r: Result<Raced<Arrival>, NetError> = await Async.race(
        async () => match (await crashes.recvAsync()) {
            Ok(Some(c)) => Ok(Arrival.Events(Some(c), null)),
            Ok(null) => Err(NetError.Closed),
            Err(e) => Err(NetErrors.fromAsync(e)),
        },
        async () => match (await finished.recvAsync()) {
            Ok(Some(n)) => Ok(Arrival.Events(null, Some(n))),
            Ok(null) => Err(NetError.Closed),
            Err(e) => Err(NetErrors.fromAsync(e)),
        },
    );
    let raced = r?;
    var crash: TaskCrash? = null;
    var done: u64? = null;
    match (raced.value) {
        Arrival.Events(c, n) => {
            crash = c;
            done = n;
        }
        _ => {}
    }
    match (raced.other) {
        Some(Arrival.Events(c, n)) => {
            if (c.isSome()) {
                crash = c;
            }
            if (n.isSome()) {
                done = n;
            }
        }
        _ => {}
    }
    return Ok(Arrival.Events(crash, done));
}

/// What happened to the connections the accepting task keeps: a finished one's closer is dropped, a crashed one's is
/// shut first, so the peer sees the end.
fn settle(kept: borrow mut Vector<Isolated>, crash: TaskCrash?, done: u64?, counters: borrow Counters) {
    match (done) {
        Some(n) => {
            for (i in 0..kept.length) {
                if (kept[i].connection == n) {
                    let gone = kept.swapRemove(i);
                    break;
                }
            }
        }
        null => {}
    }
    match (crash) {
        Some(c) => {
            let crashed = counters.crashed.fetchAdd(1);
            let left = counters.live.fetchSub(1); // the task never took itself off
            for (i in 0..kept.length) {
                if (kept[i].task == c.task && c.task != 0) {
                    match (borrow kept[i].closer) {
                        Some(closer) => {
                            let _ = closer.shutdown();
                        }
                        null => {}
                    }
                    let gone = kept.swapRemove(i);
                    break;
                }
            }
        }
        null => {}
    }
}

/// The accepting task of `runIsolated`: takes connections and starts an isolated task for each, until the source
/// ends or the drain starts, and then, until every task has ended, settles what they leave.
async fn acceptIsolated(
    set: borrow TaskSet<NetError>,
    incoming: borrow dyn Incoming,
    acceptor: borrow Arc<Box<dyn Acceptor + Send + Share>>,
    handler: borrow Arc<Box<dyn ConnectionHandler + Send + Share>>,
    limits: borrow Arc<ConnectionLimits>,
    drain: borrow Drain,
    counters: borrow Arc<Counters>,
    crashes: borrow Channel<TaskCrash>,
    finished: borrow Channel<u64>,
) -> Result<void, NetError> {
    let room = limits.get().workers as usize;
    if (!Isolation.watch(set, crashes)) {
        return Err(NetError.OutOfMemory);
    }
    var kept = Vector<Isolated>.create();
    if (kept.reserve(room).isErr()) {
        return Err(NetError.OutOfMemory);
    }
    var taking = true;
    loop {
        // What arrived while this task was not waiting for it, first: the channels hold `room` each.
        loop {
            match (crashes.tryRecv()) {
                Some(c) => { settle(mut kept, Some(c), null, counters.get()); }
                null => { break; }
            }
        }
        loop {
            match (finished.tryRecv()) {
                Some(n) => { settle(mut kept, null, Some(n), counters.get()); }
                null => { break; }
            }
        }
        if (taking && drain.isDraining()) {
            taking = false;
        }
        if (!taking && kept.length == 0) {
            return Ok();
        }
        // Up to two arrivals: a race whose both sides returned gives both, and neither may be lost.
        var arrivals = Vector<Arrival>.create();
        if (arrivals.reserve(2).isErr()) {
            return Err(NetError.OutOfMemory);
        }
        if (taking) {
            let r: Result<Raced<Arrival>, NetError> = await Async.race(
                async () => await nextStream(incoming, drain),
                async () => await nextEvent(crashes, finished),
            );
            let raced = r?;
            match (raced.other) {
                Some(o) => {
                    let _ = arrivals.push(o);
                }
                null => {}
            }
            let _ = arrivals.push(raced.value);
        } else {
            let _ = arrivals.push(await nextEvent(crashes, finished)?);
        }
        loop {
            let arrival = arrivals.pop() ?? { break; };
            match (arrival) {
                Arrival.Stream(stream) => {
                    let number = counters.get().accepted.fetchAdd(1);
                    let closer = stream.closer();
                    let a = acceptor.clone();
                    let h = handler.clone();
                    let l = limits.clone();
                    let c = counters.clone();
                    let d = drain.share();
                    let f = finished.clone();
                    // Kept before the task starts, which may end before `spawnIsolated` returns; its task's number is
                    // filled in after.
                    match (kept.push(Isolated { connection: number, task: 0, closer: closer })) {
                        Ok() => {}
                        Err(_) => { return Err(NetError.OutOfMemory); }
                    }
                    // Waits while `workers` connections are served: the admission limit, as the workers are for `run`.
                    let task = await set.spawnIsolated(NetError.Reset, async move () => {
                        var scratch = [0u8; 64];
                        let now = c.get().live.fetchAdd(1) + 1;
                        if (now > c.get().workersUsed.load()) {
                            c.get().workersUsed.store(now); // the tasks of one set run on one thread
                        }
                        let ended = await serveConnection(
                            stream,
                            a.get(),
                            h.get(),
                            l.get(),
                            d,
                            c.get(),
                            number,
                            mut scratch[..],
                        );
                        let left = c.get().live.fetchSub(1);
                        let _ = f.trySend(number);
                        return ended;
                    })?;
                    for (i in 0..kept.length) {
                        if (kept[i].connection == number) {
                            kept[i].task = task;
                        }
                    }
                }
                Arrival.NoMore => { taking = false; }
                Arrival.AcceptFailed => {
                    let failed = counters.get().acceptErrors.fetchAdd(1);
                    match (await Timer.sleep(limits.get().acceptBackoffMs)) {
                        Ok() => {}
                        Err(e) => { return Err(NetErrors.fromAsync(e)); }
                    }
                }
                Arrival.Events(crash, done) => { settle(mut kept, crash, done, counters.get()); }
            }
        }
    }
}

fn channel<T: Send>(n: usize) -> Result<Channel<T>, NetError> {
    match (Channel<T>.create(if (n == 0) 1usize else n)) {
        Ok(c) => { return Ok(c); }
        Err(_) => { return Err(NetError.OutOfMemory); }
    }
}
