// The PROXY protocol, versions 1 and 2 (HAProxy's proxy-protocol.txt; Web ADR 0012 §3.6, amendment 2): a load
// balancer in front of a listener sends the client's addresses before anything else on the connection. The connection
// worker reads the header from the sources in `ConnectionLimits.proxyProtocolFrom`, exactly and no further, before the
// acceptor's TLS handshake, and gives the connection's context the header's addresses. Also the blocks of trusted
// addresses that list, and `web_proxy`'s forwarding fields, are made of.
import web_core;

/// A block of addresses: `10.0.0.0/8`, `2001:db8::/32`, or one address (`192.0.2.1`, a /32 or /128).
public struct Cidr {
    private bytes: [u8; 16];
    private v4: bool;
    private prefix: u8;

    /// The block `text` names; null if it is not an address with an optional `/prefix` within its family's length.
    public fn parse(text: Slice<u8>) -> Cidr? {
        var slash = text.length;
        for (i in 0..text.length) {
            if (text[i] == 47) {
                slash = i;
                break;
            }
        }
        let addressText = match (StringView.fromUtf8(text[0..slash])) {
            Some(t) => t,
            null => { return null; },
        };
        let address = SocketAddresses.parseIp(addressText, 0)?;
        var bytes = [0u8; 16];
        var v4 = false;
        var bits: u64 = 0;
        match (address) {
            SocketAddress.V4(a, _) => {
                v4 = true;
                for (k in 0..4usize) {
                    bytes[k] = a[k];
                }
                bits = 32;
            }
            SocketAddress.V6(a, _, scope) => {
                if (scope != 0) {
                    return null; // a zone names a link, not a block
                }
                bytes = a;
                bits = 128;
            }
        }
        var prefix = bits;
        if (slash < text.length) {
            prefix = decimal(text[slash + 1..])?;
            if (prefix > bits) {
                return null;
            }
        }
        return Some(Cidr { bytes: bytes, v4: v4, prefix: truncate<u8>(prefix) });
    }

    /// Whether `address` is in the block. An IPv4-mapped IPv6 address (`::ffff:a.b.c.d`) is matched as IPv4.
    public fn contains(borrow this, address: SocketAddress) -> bool {
        var bytes = [0u8; 16];
        var v4 = false;
        match (address) {
            SocketAddress.V4(a, _) => {
                v4 = true;
                for (k in 0..4usize) {
                    bytes[k] = a[k];
                }
            }
            SocketAddress.V6(a, _, _) => {
                if (mapped(a)) {
                    v4 = true;
                    for (k in 0..4usize) {
                        bytes[k] = a[12 + k];
                    }
                } else {
                    bytes = a;
                }
            }
        }
        if (v4 != this.v4) {
            return false;
        }
        var left = this.prefix as usize;
        var k: usize = 0;
        while (left >= 8) {
            if (bytes[k] != this.bytes[k]) {
                return false;
            }
            left -= 8;
            k += 1;
        }
        if (left == 0) {
            return true;
        }
        let mask = truncate<u8>(0xFF00u32 >> truncate<u32>(left));
        return bytes[k] & mask == this.bytes[k] & mask;
    }
}

/// Whether `a` is an IPv4-mapped IPv6 address (RFC 4291 §2.5.5.2).
fn mapped(a: [u8; 16]) -> bool {
    for (k in 0..10usize) {
        if (a[k] != 0) {
            return false;
        }
    }
    return a[10] == 255 && a[11] == 255;
}

/// Trusted addresses as CIDR blocks: the balancers a listener takes PROXY headers from, or the proxies whose forwarding
/// fields `web_proxy` believes. None by default.
public struct TrustedProxies {
    private blocks: Vector<Cidr>;

    /// No proxy is trusted: every peer is the client.
    public fn none() -> TrustedProxies => TrustedProxies { blocks: Vector<Cidr>.create() };

    /// Trusts the block `text` (`Cidr.parse`); false if it is not one.
    public fn add(borrow mut this, text: StringView) -> Result<bool, AllocError> {
        let block = match (Cidr.parse(text.bytes())) {
            Some(b) => b,
            null => { return Ok(false); },
        };
        this.blocks.push(block)?;
        return Ok(true);
    }

    /// Whether there are no blocks.
    public fn isEmpty(borrow this) -> bool => this.blocks.length == 0;

    /// Whether `address` is in one of the blocks.
    public fn trusts(borrow this, address: SocketAddress) -> bool {
        for (i in 0..this.blocks.length) {
            if (this.blocks[i].contains(address)) {
                return true;
            }
        }
        return false;
    }
}

/// What a header says.
public enum ProxyHeader {
    /// The connection's real source and destination.
    Proxied(SocketAddress, SocketAddress),
    /// v2's LOCAL command (the balancer's own connection, a health check), or v1's UNKNOWN, or a family other than
    /// IPv4 and IPv6: the socket's own addresses stand.
    Local,
}

/// Why a header was refused.
public enum ProxyError {
    /// The bytes do not start like a PROXY header.
    NotProxy,
    /// They start like one but break its grammar.
    Malformed,
    /// Longer than v1's 107 bytes, or v2's header past `ProxyProtocol.maxV2Bytes`.
    TooLong,
}

/// v2's signature (§2.2): `\r\n\r\n\0\r\nQUIT\n`.
fn signature() -> [u8; 12] => [13u8, 10, 13, 10, 0, 13, 10, 81, 85, 73, 84, 10];

/// Parsing.
public struct ProxyProtocol {
    /// The bytes a v2 header may take with its TLVs; past this it is refused (the spec lets a receiver bound it).
    public fn maxV2Bytes() -> usize => 4096;

    /// How many more bytes the header needs after `got`, the bytes read so far: 0 when it is complete. Reading exactly
    /// this many never takes a byte past the header. With nothing read it is 15, the shortest header of either
    /// version ("PROXY UNKNOWN\r\n"; v2's is 16).
    public fn more(got: Slice<u8>) -> Result<usize, ProxyError> {
        if (got.length == 0) {
            return Ok(15);
        }
        if (got[0] == 80) {
            // v1: "PROXY " ... "\r\n", 107 bytes at most (§2.1).
            let p = "PROXY ".bytes();
            for (i in 0..(if (got.length < p.length) got.length else p.length)) {
                if (got[i] != p[i]) {
                    return Err(ProxyError.NotProxy);
                }
            }
            if (got.length >= 2 && got[got.length - 2] == 13 && got[got.length - 1] == 10) {
                return Ok(0);
            }
            if (got.length >= 107) {
                return Err(ProxyError.TooLong);
            }
            return Ok(1);
        }
        let sig = signature();
        for (i in 0..(if (got.length < 12) got.length else 12usize)) {
            if (got[i] != sig[i]) {
                return Err(ProxyError.NotProxy);
            }
        }
        if (got.length < 16) {
            return Ok(16 - got.length);
        }
        let total = 16 + ((got[14] as usize) << 8 | got[15] as usize);
        if (total > ProxyProtocol.maxV2Bytes()) {
            return Err(ProxyError.TooLong);
        }
        return Ok(if (got.length >= total) 0 else total - got.length);
    }

    /// The header in `header`, which `more` says is complete.
    public fn parse(header: Slice<u8>) -> Result<ProxyHeader, ProxyError> {
        if (header.length > 0 && header[0] == 80) {
            return parseV1(header);
        }
        return parseV2(header);
    }
}

/// v1 (§2.1): `PROXY TCP4|TCP6 <src> <dst> <srcport> <dstport>\r\n`, single spaces; or `PROXY UNKNOWN...\r\n`.
fn parseV1(header: Slice<u8>) -> Result<ProxyHeader, ProxyError> {
    if (header.length < 15 || header[header.length - 2] != 13 || header[header.length - 1] != 10) {
        return Err(ProxyError.Malformed);
    }
    let line = header[6..header.length - 2];
    var starts = [0usize; 6];
    var ends = [0usize; 6];
    var n: usize = 0;
    var start: usize = 0;
    for (i in 0..line.length + 1) {
        if (i < line.length && line[i] != 32) {
            continue;
        }
        if (n == 6 || i == start) {
            return Err(ProxyError.Malformed); // too many fields, or two spaces in a row
        }
        starts[n] = start;
        ends[n] = i;
        n += 1;
        start = i + 1;
    }
    let family = line[starts[0]..ends[0]];
    if (equalsText(family, "UNKNOWN")) {
        return Ok(ProxyHeader.Local); // the rest of the line is ignored (§2.1)
    }
    let v6 = equalsText(family, "TCP6");
    if ((!v6 && !equalsText(family, "TCP4")) || n != 5) {
        return Err(ProxyError.Malformed);
    }
    let sourcePort = headerPort(line[starts[3]..ends[3]])?;
    let destinationPort = headerPort(line[starts[4]..ends[4]])?;
    let source = addressOf(line[starts[1]..ends[1]], sourcePort, v6)?;
    let destination = addressOf(line[starts[2]..ends[2]], destinationPort, v6)?;
    return Ok(ProxyHeader.Proxied(source, destination));
}

/// An address of the family the header named, without a zone.
fn addressOf(text: Slice<u8>, port: u16, v6: bool) -> Result<SocketAddress, ProxyError> {
    let t = match (StringView.fromUtf8(text)) {
        Some(t) => t,
        null => { return Err(ProxyError.Malformed); },
    };
    let a = match (SocketAddresses.parseIp(t, port)) {
        Some(a) => a,
        null => { return Err(ProxyError.Malformed); },
    };
    return match (a) {
        SocketAddress.V4(_, _) => if (v6) Err(ProxyError.Malformed) else Ok(a),
        SocketAddress.V6(_, _, scope) => if (!v6 || scope != 0) Err(ProxyError.Malformed) else Ok(a),
    };
}

/// A port: 0 to 65535 in decimal, without a leading zero (§2.1).
fn headerPort(text: Slice<u8>) -> Result<u16, ProxyError> {
    if (text.length == 0 || text.length > 5 || (text.length > 1 && text[0] == 48)) {
        return Err(ProxyError.Malformed);
    }
    var n: u32 = 0;
    for (b in text) {
        if (b < 48 || b > 57) {
            return Err(ProxyError.Malformed);
        }
        n = n * 10 + (b - 48) as u32;
    }
    if (n > 65535) {
        return Err(ProxyError.Malformed);
    }
    return Ok(truncate<u16>(n));
}

/// v2 (§2.2): the signature, version 2 and a command, the family and transport, the length, the addresses, TLVs.
fn parseV2(header: Slice<u8>) -> Result<ProxyHeader, ProxyError> {
    if (header.length < 16) {
        return Err(ProxyError.Malformed);
    }
    let sig = signature();
    for (i in 0..12usize) {
        if (header[i] != sig[i]) {
            return Err(ProxyError.NotProxy);
        }
    }
    if (header[12] >> 4 != 2) {
        return Err(ProxyError.Malformed); // version 2 only
    }
    let command = header[12] & 15;
    let length = (header[14] as usize) << 8 | header[15] as usize;
    if (header.length != 16 + length) {
        return Err(ProxyError.Malformed);
    }
    if (command == 0) {
        return Ok(ProxyHeader.Local); // LOCAL: whatever follows is ignored
    }
    if (command != 1) {
        return Err(ProxyError.Malformed);
    }
    let family = header[13] >> 4;
    let body = header[16..];
    if (family == 1) {
        if (length < 12) {
            return Err(ProxyError.Malformed);
        }
        var source = [0u8; 4];
        var destination = [0u8; 4];
        for (k in 0..4usize) {
            source[k] = body[k];
            destination[k] = body[4 + k];
        }
        return Ok(
            ProxyHeader.Proxied(
                SocketAddress.V4(source, port16(body, 8)),
                SocketAddress.V4(destination, port16(body, 10)),
            ),
        );
    }
    if (family == 2) {
        if (length < 36) {
            return Err(ProxyError.Malformed);
        }
        var source = [0u8; 16];
        var destination = [0u8; 16];
        for (k in 0..16usize) {
            source[k] = body[k];
            destination[k] = body[16 + k];
        }
        return Ok(ProxyHeader.Proxied(
            SocketAddress.V6(source, port16(body, 32), 0),
            SocketAddress.V6(destination, port16(body, 34), 0),
        ));
    }
    return Ok(ProxyHeader.Local); // AF_UNSPEC or AF_UNIX: no addresses to use
}

fn port16(b: Slice<u8>, at: usize) -> u16 => (b[at] as u16) << 8 | b[at + 1] as u16;

fn equalsText(a: Slice<u8>, text: StringView) -> bool {
    let t = text.bytes();
    if (a.length != t.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != t[i]) {
            return false;
        }
    }
    return true;
}

/// Reads a PROXY header from `conn` by `deadline`, exactly: each read asks for no more than `ProxyProtocol.more`
/// says, so the bytes after the header stay unread. `Err(Closed)` if what arrives is not a valid header.
public async fn readProxyHeader(conn: borrow mut dyn Transport, deadline: Deadline) -> Result<ProxyHeader, NetError> {
    var header = [0u8; 4096];
    var got: usize = 0;
    loop {
        let want = match (ProxyProtocol.more(header[0..got])) {
            Ok(n) => n,
            Err(_) => { return Err(NetError.Closed); },
        };
        if (want == 0) {
            break;
        }
        let n = await Transports.readWithin(conn, mut header[got..got + want], deadline)?;
        if (n == 0) {
            return Err(NetError.Closed);
        }
        got += n;
    }
    return match (ProxyProtocol.parse(header[0..got])) {
        Ok(h) => Ok(h),
        Err(_) => Err(NetError.Closed),
    };
}

/// `address`'s IP as text, without its port or brackets: `192.0.2.1`, `2001:db8::1` (RFC 5952's form).
public fn ipText(address: SocketAddress, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var buffer = [0u8; 64];
    var w = TextWriter.create(mut buffer[..]);
    let zeroPort = address.withPort(0);
    zeroPort.write(mut w);
    let n = w.length();
    let all = buffer[0..n];
    // "a.b.c.d:0" or "[v6%zone]:0": drop the port, then the brackets and any zone.
    var end = n;
    while (end > 0 && all[end - 1] != 58) {
        end -= 1;
    }
    end -= 1;
    var start: usize = 0;
    if (all[0] == 91) {
        start = 1;
        end -= 1;
        var k = start;
        while (k < end && all[k] != 37) {
            k += 1;
        }
        end = k;
    }
    return appendText(out, all[start..end]);
}

fn appendText(out: borrow mut Vector<u8>, bytes: Slice<u8>) -> Result<void, AllocError> {
    for (b in bytes) {
        out.push(b)?;
    }
    return Ok();
}

/// A decimal number of at most 3 digits (a prefix length); null if it is not one.
fn decimal(text: Slice<u8>) -> u64? {
    if (text.length == 0 || text.length > 3) {
        return null;
    }
    var n: u64 = 0;
    for (b in text) {
        if (b < 48 || b > 57) {
            return null;
        }
        n = n * 10 + (b - 48) as u64;
    }
    return Some(n);
}
