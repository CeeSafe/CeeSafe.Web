// TCP (Web ADR 0001 §3.3): lib/std's async TCP stream as a Transport, and a listener that produces them. Addresses,
// IPv6 and the socket options are CeeSafe's ADR 0044 (upstream U1).
import web_core;

/// A TCP connection as a Transport. It owns its socket; dropping it closes the socket.
public struct TcpTransport {
    private stream: AsyncTcpStream;
    private poisoned: bool;
    private shut: bool;
    private peer: SocketAddress?;
    private local: SocketAddress?;

    /// The transport over an accepted or connected stream. Its addresses are read now, once: null if the kernel no
    /// longer knows them (the peer already reset).
    public fn fromStream(stream: AsyncTcpStream) -> TcpTransport {
        let peer = match (stream.peerAddress()) {
            Ok(a) => Some(a),
            Err(_) => null,
        };
        let local = match (stream.localAddress()) {
            Ok(a) => Some(a),
            Err(_) => null,
        };
        return TcpTransport { stream: stream, poisoned: false, shut: false, peer: peer, local: local };
    }

    /// Connects to `address` (IPv4 or IPv6 text) and `port`.
    public async fn connect(address: StringView, port: u16) -> Result<TcpTransport, NetError> {
        match (await AsyncTcpStream.connect(address, port)) {
            Ok(s) => { return Ok(TcpTransport.fromStream(s)); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }

    /// Connects to `address`.
    public async fn connectTo(address: SocketAddress) -> Result<TcpTransport, NetError> {
        match (await AsyncTcpStream.connectTo(address)) {
            Ok(s) => { return Ok(TcpTransport.fromStream(s)); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }

    /// TCP_NODELAY: small writes go out at once (Nagle's algorithm off).
    public fn setNoDelay(borrow this, on: bool) -> Result<void, NetError> {
        match (this.stream.setNoDelay(on)) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// Closes abortively: the peer gets a reset (RST) instead of the end of the stream, and unsent bytes are
    /// discarded (SO_LINGER 0). For a connection that broke the protocol, and for tests of a peer's reset.
    public fn abort(this) {
        match (this.stream.setLinger(Some(0u32))) {
            Ok() => {}
            Err(_) => {} // the socket is closing anyway; a plain close is the next best thing
        }
    }

    /// Whether a failed or cancelled write poisoned it (Web ADR 0001 §3.4).
    public fn isPoisoned(borrow this) -> bool => this.poisoned;

    /// Writes all of `bytes`, poisoning on failure.
    async fn writeBytes(borrow mut this, bytes: Slice<u8>) -> Result<void, NetError> {
        if (this.poisoned || this.shut) {
            return Err(NetError.Closed);
        }
        match (await this.stream.write(bytes)) {
            Ok() => { return Ok(); }
            Err(e) => {
                this.poisoned = true;
                return Err(NetErrors.fromAsync(e));
            }
        }
    }
}

impl Transport for TcpTransport {
    async fn read(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, NetError> {
        if (buffer.length == 0) {
            return Err(NetError.LimitExceeded);
        }
        match (await this.stream.read(buffer)) {
            Ok(n) => { return Ok(n); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }

    async fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, NetError> => await this.writeBytes(bytes);

    /// One `sendmsg`-style step (lib/std `AsyncTcpStream.writeVectored`, ADR 0045 §3.2), poisoning on failure.
    async fn writeVectored(borrow mut this, parts: borrow IoParts) -> Result<usize, NetError> {
        if (this.poisoned || this.shut) {
            return Err(NetError.Closed);
        }
        match (await this.stream.writeVectored(parts)) {
            Ok(n) => { return Ok(n); }
            Err(e) => {
                this.poisoned = true;
                return Err(NetErrors.fromAsync(e));
            }
        }
    }

    async fn shutdownWrite(borrow mut this) -> Result<void, NetError> {
        if (this.poisoned) {
            return Err(NetError.Closed);
        }
        match (this.stream.shutdownWrite()) {
            Ok() => {
                this.shut = true;
                return Ok();
            }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    @effects()
    fn alpn(borrow this) -> Alpn => Alpn.None;

    @effects()
    fn peerAddress(borrow this) -> SocketAddress? => this.peer;

    @effects()
    fn localAddress(borrow this) -> SocketAddress? => this.local;
}

/// A TCP listener producing PlainStreams, for `ConnectionServer` (its `Incoming`). Accepted connections have
/// TCP_NODELAY on: a server writes whole responses, and Nagle's algorithm would hold back their last segment.
public struct Listener {
    private listener: AsyncTcpListener;
    private noDelay: bool;

    /// Listens on `address` (IPv4 or IPv6 text) and `port` (0: any free port), with `ListenOptions.defaults()`.
    public fn bind(address: StringView, port: u16) -> Result<Listener, NetError> {
        match (AsyncTcpListener.bind(address, port)) {
            Ok(l) => { return Ok(Listener { listener: l, noDelay: true }); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// Listens on `address` with `options`: the backlog, address and port reuse, and dual stack (CeeSafe ADR 0044
    /// §3.2).
    public fn bindWith(address: SocketAddress, options: ListenOptions) -> Result<Listener, NetError> {
        match (AsyncTcpListener.bindWith(address, options)) {
            Ok(l) => { return Ok(Listener { listener: l, noDelay: true }); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// The same listener, accepting with TCP_NODELAY `on` (the default) or off.
    public fn withNoDelay(this, on: bool) -> Listener => Listener { listener: this.listener, noDelay: on };

    /// The address it listens on.
    public fn localAddress(borrow this) -> Result<SocketAddress, NetError> {
        match (this.listener.localAddress()) {
            Ok(a) => { return Ok(a); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// The port it listens on.
    public fn port(borrow this) -> Result<u16, NetError> {
        match (this.listener.port()) {
            Ok(p) => { return Ok(p); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// The next connection; the task waits until one arrives.
    public async fn accept(borrow this) -> Result<PlainStream, NetError> {
        match (await this.listener.accept()) {
            Ok(s) => {
                let t = TcpTransport.fromStream(s);
                if (this.noDelay) {
                    match (t.setNoDelay(true)) {
                        Ok() => {}
                        Err(_) => {} // the peer already left: the connection's first read or write says so
                    }
                }
                return Ok(PlainStream.tcp(t));
            }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }
}
