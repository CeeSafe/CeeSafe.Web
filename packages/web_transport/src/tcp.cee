// TCP (Web ADR 0001 §3.3): lib/std's async TCP stream as a Transport, and a listener that produces them. IPv4 text
// addresses only until CeeSafe's SocketAddress (upstream U1) is released; M1 adds admission control and draining.
import web_core;

/// A TCP connection as a Transport. It owns its socket; dropping it closes the socket.
public struct TcpTransport {
    private stream: AsyncTcpStream;
    private poisoned: bool;
    private shut: bool;

    /// The transport over an accepted or connected stream.
    public fn fromStream(stream: AsyncTcpStream) -> TcpTransport =>
        TcpTransport { stream: stream, poisoned: false, shut: false };

    /// Connects to `address` (dotted IPv4) and `port`.
    public async fn connect(address: StringView, port: u16) -> Result<TcpTransport, NetError> {
        match (await AsyncTcpStream.connect(address, port)) {
            Ok(s) => { return Ok(TcpTransport.fromStream(s)); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }

    /// Whether a failed or cancelled write poisoned it (Web ADR 0001 §3.4).
    public fn isPoisoned(borrow this) -> bool => this.poisoned;

    /// Writes all of `bytes`, poisoning on failure.
    async fn writeBytes(borrow mut this, bytes: Slice<u8>) -> Result<void, NetError> {
        if (this.poisoned || this.shut) {
            return Err(NetError.Closed);
        }
        match (await this.stream.write(bytes)) {
            Ok() => { return Ok(); }
            Err(e) => {
                this.poisoned = true;
                return Err(NetErrors.fromAsync(e));
            }
        }
    }
}

impl Transport for TcpTransport {
    async fn read(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, NetError> {
        if (buffer.length == 0) {
            return Err(NetError.LimitExceeded);
        }
        match (await this.stream.read(buffer)) {
            Ok(n) => { return Ok(n); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }

    async fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, NetError> => await this.writeBytes(bytes);

    /// Until CeeSafe has a vectored send (upstream U3), one step writes the first non-empty part whole.
    async fn writeVectored(borrow mut this, parts: borrow IoParts) -> Result<usize, NetError> {
        for (i in 0..parts.parts()) {
            let p = parts.part(truncate<u32>(i));
            if (p.length > 0) {
                await this.writeBytes(p)?;
                return Ok(p.length);
            }
        }
        if (this.poisoned || this.shut) {
            return Err(NetError.Closed);
        }
        return Ok(0);
    }

    async fn shutdownWrite(borrow mut this) -> Result<void, NetError> {
        if (this.poisoned) {
            return Err(NetError.Closed);
        }
        match (this.stream.shutdownWrite()) {
            Ok() => {
                this.shut = true;
                return Ok();
            }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    @effects()
    fn alpn(borrow this) -> Alpn => Alpn.None;
}

/// A TCP listener producing PlainStreams. M1 adds the bounded accept loop, admission control and draining
/// (implementation plan §7, M1).
public struct Listener {
    private listener: AsyncTcpListener;

    /// Listens on `address` (dotted IPv4) and `port` (0: any free port).
    public fn bind(address: StringView, port: u16) -> Result<Listener, NetError> {
        match (AsyncTcpListener.bind(address, port)) {
            Ok(l) => { return Ok(Listener { listener: l }); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// The port it listens on.
    public fn port(borrow this) -> Result<u16, NetError> {
        match (this.listener.port()) {
            Ok(p) => { return Ok(p); }
            Err(e) => { return Err(NetErrors.fromIo(e)); }
        }
    }

    /// The next connection; the task waits until one arrives.
    public async fn accept(borrow this) -> Result<PlainStream, NetError> {
        match (await this.listener.accept()) {
            Ok(s) => { return Ok(PlainStream.tcp(TcpTransport.fromStream(s))); }
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
    }
}
