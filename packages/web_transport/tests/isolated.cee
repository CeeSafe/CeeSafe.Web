// ConnectionServer.runIsolated (Web ADR 0016): every connection served as `run` serves it, admission by `workers`,
// the drain (connections in flight finish, idle ones close, those that ignore it are cancelled after the grace), and
// a trap in a connection's handler, which ends that connection only; over real TCP, its peer sees the end. A test
// whose isolated task traps passes under `ceesafec test` from 0.77.1 (B22, B24).
import web_core;

/// Echoes each connection whole, and counts the most served at once; the connections numbered in `traps` (by
/// arrival, from 1) trap instead (an index out of bounds), after reading.
struct TrapHandler {
    arrived: AtomicU64;
    /// A bit per connection number that traps.
    traps: u64;
    echoed: AtomicU64;
    active: AtomicU64;
    peak: AtomicU64;
}

impl ConnectionHandler for TrapHandler {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        let n = this.arrived.fetchAdd(1) + 1;
        let now = this.active.fetchAdd(1) + 1;
        if (now > this.peak.load()) {
            this.peak.store(now);
        }
        var buf = [0u8; 64];
        var got: usize = 0;
        loop {
            let r = await Transports.readWithin(conn, mut buf[got..], Deadline.after(2000));
            let k = match (r) {
                Ok(k) => k,
                Err(e) => {
                    let left = this.active.fetchSub(1);
                    return Err(e);
                },
            };
            if (k == 0) {
                break;
            }
            got += k;
            if (got == 26) {
                break;
            }
        }
        if (n < 64 && ((this.traps >> n) & 1) == 1) {
            let small = [0u8; 2];
            let at = got + n as usize;
            buf[0] = small[at]; // the trap: the task's unit ends here, and `active` keeps its count
        }
        await nap(5)?; // so that connections overlap
        let left = this.active.fetchSub(1);
        await conn.write(buf[0..got])?;
        let done = this.echoed.fetchAdd(1);
        return Ok();
    }
}

fn trapHandler(traps: u64) -> Result<Arc<Box<dyn ConnectionHandler + Send + Share>>, TestFailure> {
    let h = TrapHandler {
        arrived: AtomicU64.create(0),
        traps: traps,
        echoed: AtomicU64.create(0),
        active: AtomicU64.create(0),
        peak: AtomicU64.create(0),
    };
    let boxed: Box<dyn ConnectionHandler + Send + Share> = match (Box.create(h)) {
        Ok(b) => b,
        Err(_) => { return Err(TestFailure.create("no memory")); },
    };
    match (Arc.create(boxed)) {
        Ok(a) => { return Ok(a); }
        Err(_) => { return Err(TestFailure.create("no memory")); }
    }
}

fn plainAcceptor() -> Result<Arc<Box<dyn Acceptor + Send + Share>>, TestFailure> {
    let boxed: Box<dyn Acceptor + Send + Share> = match (Box.create(PlainAcceptor {})) {
        Ok(b) => b,
        Err(_) => { return Err(TestFailure.create("no memory")); },
    };
    match (Arc.create(boxed)) {
        Ok(a) => { return Ok(a); }
        Err(_) => { return Err(TestFailure.create("no memory")); }
    }
}

/// `runIsolated` until `incoming` ends.
async fn serveIsolated(
    incoming: borrow MockIncoming,
    handler: borrow Arc<Box<dyn ConnectionHandler + Send + Share>>,
    l: borrow ConnectionLimits,
) -> Result<ServerReport, TestFailure> {
    let acceptor = plainAcceptor()?;
    let drain = net(Drain.create())?;
    return net(await ConnectionServer.runIsolated(incoming, acceptor, handler.clone(), l, drain));
}

fn limitsOf(workers: u32) -> ConnectionLimits {
    var l = ConnectionLimits.defaults();
    l.workers = workers;
    l.graceMs = 1000;
    l.closeLingerMs = 100;
    l.handshakeMs = 20;
    return l;
}

@test
async fn isolated_serves_every_connection() -> Result<void, TestFailure> {
    let incoming = net(MockIncoming.create(16))?;
    let m = alphabet();
    for (k in 0..12u64) {
        netDone(incoming.push(net(mockOf(m[..]))?.withSeededSplits(k + 1, 5)))?;
    }
    incoming.close();
    let h = trapHandler(0)?;
    let l = limitsOf(4);
    let r = await serveIsolated(incoming, h, l)?;
    Check.isTrue(r.accepted == 12 && r.served == 12 && r.failed == 0, "12 connections accepted and served")?;
    Check.isTrue(r.crashed == 0 && !r.forced, "none crashed, none forced")?;
    Check.isTrue(r.workersUsed >= 2 && r.workersUsed <= 4, "admission: never more than 4 at once")?;
    return Ok();
}


/// `handler` as `runIsolated` takes it.
fn arcOf<H: ConnectionHandler + Send + Share>(handler: H) -> Result<Arc<Box<dyn ConnectionHandler + Send + Share>>, TestFailure> {
    let boxed: Box<dyn ConnectionHandler + Send + Share> = match (Box.create(handler)) {
        Ok(b) => b,
        Err(_) => { return Err(TestFailure.create("no memory")); },
    };
    match (Arc.create(boxed)) {
        Ok(a) => { return Ok(a); }
        Err(_) => { return Err(TestFailure.create("no memory")); }
    }
}

/// `runIsolated` with a drain started after `drainAfterMs`.
async fn drainIsolated(
    incoming: borrow MockIncoming,
    handler: Arc<Box<dyn ConnectionHandler + Send + Share>>,
    l: borrow ConnectionLimits,
    drainAfterMs: u64,
    report: borrow mut ServerReport,
) -> Result<void, NetError> {
    let drain = Drain.create()?;
    let acceptor = match (plainAcceptor()) {
        Ok(a) => a,
        Err(_) => { return Err(NetError.OutOfMemory); },
    };
    await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            report = await ConnectionServer.runIsolated(incoming, acceptor.clone(), handler.clone(), l, drain)?;
            return Ok();
        });
        s.spawn(async () => {
            await nap(drainAfterMs)?;
            drain.start();
            return Ok();
        });
    })?;
    return Ok();
}

@test
async fn isolated_drain_lets_in_flight_finish() -> Result<void, TestFailure> {
    let m = alphabet();
    let incoming = net(MockIncoming.create(4))?;
    netDone(incoming.push(net(mockOf(m[..]))?))?;
    netDone(incoming.push(net(mockOf(m[..]))?))?;
    let l = serverLimits(4, 5000);
    var r = emptyReport();
    let started = Timer.now();
    netDone(await drainIsolated(incoming, arcOf(SlowHandler { ms: 60 })?, l, 10, mut r))?;
    let took = Timer.now() - started;
    Check.isTrue(r.served == 2 && !r.forced && r.crashed == 0, "requests in flight finish during the drain")?;
    Check.isTrue(took >= 60 && took < 2000, "the drain ends when they do")?;
    return Ok();
}

@test
async fn isolated_drain_closes_idle_connections() -> Result<void, TestFailure> {
    let m = alphabet();
    let incoming = net(MockIncoming.create(4))?;
    netDone(incoming.push(net(mockOf(m[0..0]))?.withHang()))?;
    netDone(incoming.push(net(mockOf(m[0..0]))?.withHang()))?;
    let l = serverLimits(4, 5000);
    var r = emptyReport();
    let started = Timer.now();
    netDone(await drainIsolated(incoming, arcOf(IdleHandler {})?, l, 10, mut r))?;
    let took = Timer.now() - started;
    Check.isTrue(r.served == 2 && !r.forced && took < 2000, "idle keep-alive connections close on drain")?;
    return Ok();
}

@test
async fn isolated_grace_runs_out() -> Result<void, TestFailure> {
    let m = alphabet();
    let incoming = net(MockIncoming.create(4))?;
    netDone(incoming.push(net(mockOf(m[0..0]))?.withHang()))?;
    netDone(incoming.push(net(mockOf(m[0..0]))?.withHang()))?;
    let l = serverLimits(4, 50);
    var r = emptyReport();
    let started = Timer.now();
    netDone(await drainIsolated(incoming, arcOf(StubbornHandler {})?, l, 10, mut r))?;
    let took = Timer.now() - started;
    Check.isTrue(r.forced && r.served == 0, "connections ignoring the drain are cancelled after the grace")?;
    Check.isTrue(took >= 60 && took < 1000, "shutdown within drain + grace + epsilon")?;
    return Ok();
}

@test
async fn isolated_trap_ends_its_connection_only() -> Result<void, TestFailure> {
    let incoming = net(MockIncoming.create(16))?;
    let m = alphabet();
    for (k in 0..5u64) {
        netDone(incoming.push(net(mockOf(m[..]))?))?;
    }
    incoming.close();
    let h = trapHandler(1 << 3)?; // the third connection traps
    let l = limitsOf(2);
    let r = await serveIsolated(incoming, h, l)?;
    Check.isTrue(r.accepted == 5, "5 accepted")?;
    Check.isTrue(r.crashed == 1, "one crashed")?;
    Check.isTrue(r.served == 4 && r.failed == 0, "the other 4 served, none counted as failed")?;
    Check.isTrue(Isolation.report().crashes >= 1, "the process counts the crash")?;
    return Ok();
}

@test
async fn isolated_traps_do_not_stop_the_server() -> Result<void, TestFailure> {
    let incoming = net(MockIncoming.create(32))?;
    let m = alphabet();
    for (k in 0..20u64) {
        netDone(incoming.push(net(mockOf(m[..]))?.withSeededSplits(k + 1, 3)))?;
    }
    incoming.close();
    // every other connection traps
    var traps: u64 = 0;
    for (n in 1..21u64) {
        if (n % 2 == 0) {
            traps = traps | (1u64 << n);
        }
    }
    let h = trapHandler(traps)?;
    let l = limitsOf(3);
    let r = await serveIsolated(incoming, h, l)?;
    Check.isTrue(r.accepted == 20 && r.crashed == 10 && r.served == 10, "10 crashed, 10 served")?;
    Check.isFalse(r.forced, "the server ended when the source did, not by the grace")?;
    return Ok();
}

/// A TCP client that sends the alphabet without ending its side first, then reads to the end: true if it got the
/// alphabet back, false if the connection ended with nothing (as a trapped one does), or was reset.
async fn plainClient(port: u16, halfClose: bool) -> Result<bool, NetError> {
    var c = await TcpTransport.connect("127.0.0.1", port)?;
    let m = alphabet();
    await c.write(m[..])?;
    if (halfClose) {
        await c.shutdownWrite()?;
    }
    var buf = [0u8; 32];
    var got: usize = 0;
    loop {
        let n = match (await Transports.readWithin(mut c, mut buf[got..], Deadline.after(3000))) {
            Ok(n) => n,
            Err(NetError.TimedOut) => { return Err(NetError.TimedOut); }, // the server never ended it
            Err(_) => { return Ok(false); },
        };
        if (n == 0) {
            break;
        }
        got += n;
    }
    return Ok(got == m.length);
}

/// Whether this system gives a stream a closer: not under `ceesafec run --interp` (CeeSafe ADR 0175 §10), where a
/// trapped connection's socket cannot be shut for its peer. Asked of a connection of its own.
async fn closersWork() -> Result<bool, TestFailure> {
    let probe = net(Listener.bind("127.0.0.1", 0))?;
    let port = net(probe.port())?;
    let c = net(await TcpTransport.connect("127.0.0.1", port))?;
    return Ok(c.closer().isSome());
}

/// Over TCP: the peers of connections whose handler traps read the end, one of them having half-closed first (on
/// macOS that needed ceesafec 0.77.0, B21), and a client after them is echoed. Where there are no closers, the peers
/// are not told, and only the server's side is checked.
async fn trapOverTcpChecks() -> Result<void, TestFailure> {
    let told = await closersWork()?;
    let listener = net(Listener.bind("127.0.0.1", 0))?;
    let port = net(listener.port())?;
    let drain = net(Drain.create())?;
    let h = trapHandler((1 << 1) | (1 << 2))?; // the first two connections trap
    let a = plainAcceptor()?;
    let l = limitsOf(4);
    var r = emptyReport();
    var first: bool? = null;
    var second: bool? = null;
    var third: bool? = null;
    netDone(await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            r = await ConnectionServer.runIsolated(listener, a.clone(), h.clone(), l, drain)?;
            return Ok();
        });
        s.spawn(async () => {
            first = match (await plainClient(port, false)) {
                Ok(echoed) => Some(echoed),
                Err(NetError.TimedOut) => null, // nobody shut it: no closers here
                Err(e) => { return Err(e); },
            };
            second = match (await plainClient(port, true)) {
                Ok(echoed) => Some(echoed),
                Err(NetError.TimedOut) => null,
                Err(e) => { return Err(e); },
            };
            third = Some(await plainClient(port, true)?);
            drain.start();
            return Ok();
        });
    }))?;
    if (told) {
        Check.isTrue(first == Some(false), "a trapped connection ended, and its client was not left waiting")?;
        Check.isTrue(second == Some(false), "so did one whose client had half-closed")?;
    }
    Check.isTrue(third == Some(true), "the next connection is echoed")?;
    Check.isTrue(r.accepted == 3 && r.crashed == 2 && r.served == 1, "TCP report: 2 crashed, 1 served")?;
    return Ok();
}

// Sync, as the other TCP tests, to count descriptors: each crashed connection's socket is leaked (CeeSafe ADR 0175
// §2.4), so the process holds exactly two more afterwards (the probe's are closed).
@test
fn isolated_trap_over_tcp() -> Result<void, TestFailure> {
    let before = openDescriptors();
    match (Async.run(trapOverTcpChecks())) {
        Ok() => {}
        Err(failure) => { return Err(failure); }
    }
    match (before) {
        Some(b) => {
            match (openDescriptors()) {
                Some(after) => { Check.isTrue(after == b + 2, "two descriptors leaked: the crashed connections' sockets")?; }
                null => {}
            }
        }
        null => {}
    }
    return Ok();
}
