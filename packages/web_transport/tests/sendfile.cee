// `Transport.sendFile` (Web ADR 0013 §3.3) on TcpTransport over loopback, which hands the file to the platform
// (lib/std's `sendFileAll`: `sendfile` on Linux and macOS, `TransmitFile` on Windows' IOCP, a copy on WSAPoll), and on
// MockTransport, which copies (`Transports.copyFile`). The file is `written` bytes of `pattern`, then extended by
// `setLength`: the rest reads as zeros (POSIX `ftruncate`, Windows `SetEndOfFile`), and on Linux and macOS is a hole.
// So a send from past 4 GiB must return zeros; an offset cut to 32 bits would return the pattern, which has none.
// Expected bytes come from `pattern` and the file's layout, not from the code under test.
import web_core;

/// Byte `p` of the written part of every test file: a repeating alphabet, never 0.
fn pattern(p: u64) -> u8 => 97 + truncate<u8>(p % 26);

/// 4 GiB: offsets past it need more than 32 bits.
fn fourGiB() -> u64 => 4294967296;

/// True if `got` is the file's bytes from `offset`: the pattern below `written`, zeros above.
fn isFileFrom(got: Slice<u8>, offset: u64, written: u64) -> bool {
    for (i in 0..got.length) {
        let p = offset + i as u64;
        let want: u8 = if (p < written) pattern(p) else 0;
        if (got[i] != want) {
            return false;
        }
    }
    return true;
}

fn io<T>(r: Result<T, AsyncError>, what: StringView) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create(what)); }
    }
}

/// A file in a new temporary directory: `written` pattern bytes, then `length` in all.
struct TestFile {
    dir: String;
    path: String;
}

async fn madeFile(written: usize, length: u64) -> Result<TestFile, TestFailure> {
    let dir = match (await Async.blocking(() => Directory.temporary())) {
        Ok(d) => d,
        Err(_) => { return Err(TestFailure.create("a temporary directory")); },
    };
    var path = String.create();
    match (path.append(dir.view())) {
        Ok() => {}
        Err(_) => { return Err(TestFailure.create("out of memory")); }
    }
    match (path.append("/body")) {
        Ok() => {}
        Err(_) => { return Err(TestFailure.create("out of memory")); }
    }
    var file = io(await AsyncFiles.create(path.view()), "creating the file")?;
    var block = [0u8; 4096];
    var at: usize = 0;
    while (at < written) {
        let n = if (written - at < 4096) written - at else 4096;
        for (i in 0..n) {
            block[i] = pattern((at + i) as u64);
        }
        io(await AsyncFiles.write(mut file, block[0..n]), "writing the file")?;
        at += n;
    }
    io(await AsyncFiles.setLength(mut file, length), "extending the file")?;
    return Ok(TestFile { dir: dir, path: path });
}

async fn removed(file: borrow TestFile) {
    let f = await Async.blocking(() => File.remove(file.path.view()));
    let d = await Async.blocking(() => Directory.remove(file.dir.view()));
}

fn isInvalidInput(e: NetError?) -> bool => match (e) {
    Some(NetError.Io(IoError.InvalidInput)) => true,
    _ => false,
};

fn isClosed(e: NetError?) -> bool => match (e) {
    Some(NetError.Closed) => true,
    _ => false,
};

/// What a send did: the bytes the peer received, `sendFile`'s error, and a write's error after a failed `sendFile`.
struct Sent {
    got: Vector<u8>;
    error: NetError?;
    after: NetError?;
}

/// Sends `length` bytes of the file at `path` from `offset` over loopback TCP, then ends the stream.
async fn sentOverTcp(path: StringView, offset: u64, length: u64) -> Result<Sent, NetError> {
    let listener = Listener.bind("127.0.0.1", 0)?;
    let port = listener.port()?;
    var got = Vector<u8>.create();
    var error: NetError? = null;
    var after: NetError? = null;
    await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            var conn = await listener.accept()?;
            var file = match (await AsyncFiles.open(path)) {
                Ok(f) => f,
                Err(e) => { return Err(NetErrors.fromAsync(e)); },
            };
            match (await conn.sendFile(mut file, offset, length)) {
                Ok() => { await conn.shutdownWrite()?; }
                Err(e) => {
                    error = Some(e);
                    match (await conn.write("x".bytes())) {
                        Ok() => {}
                        Err(w) => { after = Some(w); }
                    }
                }
            }
            return Ok();
        });
        s.spawn(async () => {
            var c = await TcpTransport.connect("127.0.0.1", port)?;
            var buf = [0u8; 65536];
            loop {
                let n = await Async.deadline(
                    Deadline.after(10000).instant(),
                    NetError.TimedOut,
                    async () => await c.read(mut buf[..]),
                )?;
                if (n == 0) {
                    return Ok();
                }
                match (got.extend(buf[0..n])) {
                    Ok() => {}
                    Err(e) => { return Err(NetErrors.fromAlloc(e)); }
                }
            }
        });
    })?;
    return Ok(Sent { got: got, error: error, after: after });
}

/// The same through a MockTransport.
async fn sentThroughMock(path: StringView, offset: u64, length: u64) -> Result<Sent, NetError> {
    let none = [0u8; 1];
    var m = mockOf(none[0..0])?;
    var file = match (await AsyncFiles.open(path)) {
        Ok(f) => f,
        Err(e) => { return Err(NetErrors.fromAsync(e)); },
    };
    var error: NetError? = null;
    var after: NetError? = null;
    match (await m.sendFile(mut file, offset, length)) {
        Ok() => {}
        Err(e) => {
            error = Some(e);
            match (await m.write("x".bytes())) {
                Ok() => {}
                Err(w) => { after = Some(w); }
            }
        }
    }
    var got = Vector<u8>.create();
    match (got.extend(m.written())) {
        Ok() => {}
        Err(e) => { return Err(NetErrors.fromAlloc(e)); }
    }
    return Ok(Sent { got: got, error: error, after: after });
}

/// Sends from a file of `written` pattern bytes and `length` in all, over TCP or through the mock.
async fn sendOf(
    tcp: bool,
    written: usize,
    length: u64,
    offset: u64,
    count: u64,
) -> Result<Sent, TestFailure> {
    let file = await madeFile(written, length)?;
    let r = if (tcp) await sentOverTcp(file.path.view(), offset, count) else await sentThroughMock(
        file.path.view(),
        offset,
        count,
    );
    await removed(file);
    return net(r);
}

/// 600 000 bytes from offset 1 000: more than two of copyFile's 256 KiB pieces, and not aligned to any.
async fn aRange(tcp: bool) -> Result<void, TestFailure> {
    let s = await sendOf(tcp, 601000, 601000, 1000, 600000)?;
    Check.isTrue(s.error == null, "no error")?;
    Check.equalU64(600000, s.got.length as u64)?;
    Check.isTrue(isFileFrom(s.got.view(), 1000, 601000), "the file's bytes from offset 1000")?;
    return Ok();
}

/// 300 000 bytes from 4 GiB + 5 of a file whose first 64 KiB are the pattern: zeros, not the pattern from 5.
async fn pastFourGiB(tcp: bool) -> Result<void, TestFailure> {
    let s = await sendOf(tcp, 65536, fourGiB() + 400000, fourGiB() + 5, 300000)?;
    Check.isTrue(s.error == null, "no error")?;
    Check.equalU64(300000, s.got.length as u64)?;
    Check.isTrue(isFileFrom(s.got.view(), fourGiB() + 5, 65536), "zeros: the offset kept its high bits")?;
    return Ok();
}

/// 5 000 bytes asked of a 1 000-byte file: the 1 000 sent, then `Io(InvalidInput)`, and the transport poisoned.
async fn aShortFile(tcp: bool) -> Result<void, TestFailure> {
    let s = await sendOf(tcp, 1000, 1000, 0, 5000)?;
    Check.isTrue(isInvalidInput(s.error), "Io(InvalidInput)")?;
    Check.isTrue(isClosed(s.after), "a write after it is Closed: the transport is poisoned")?;
    Check.equalU64(1000, s.got.length as u64)?;
    Check.isTrue(isFileFrom(s.got.view(), 0, 1000), "the file's 1000 bytes, nothing after")?;
    return Ok();
}

@test
async fn tcp_sends_a_range_of_a_file() -> Result<void, TestFailure> => await aRange(true);

@test
async fn tcp_sends_from_past_4_gib() -> Result<void, TestFailure> => await pastFourGiB(true);

@test
async fn tcp_a_short_file_is_invalid_input_and_poisons() -> Result<void, TestFailure> => await aShortFile(true);

@test
async fn mock_copies_a_range_of_a_file() -> Result<void, TestFailure> => await aRange(false);

@test
async fn mock_copies_from_past_4_gib() -> Result<void, TestFailure> => await pastFourGiB(false);

@test
async fn mock_a_short_file_is_invalid_input_and_poisons() -> Result<void, TestFailure> => await aShortFile(false);
