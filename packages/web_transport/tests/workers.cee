// The connection-worker pattern (M1's design question, docs/milestones/M0.md): a scope cannot spawn after its body,
// so a server runs a fixed set of workers, each looping accept → serve on one shared listener. Here 4 workers serve
// 12 clients that connect at once; every client gets its own echo back, and finishing the clients cancels the idle
// workers through Async.race. Ported from tests/web_transport/workers.
import web_core;

/// One connection: echo until the peer ends its side.
async fn workerEcho(conn: borrow mut dyn Transport) -> Result<void, NetError> {
    var buf = [0u8; 32];
    loop {
        let n = await conn.read(mut buf[..])?;
        if (n == 0) {
            return await conn.shutdownWrite();
        }
        await conn.write(buf[0..n])?;
    }
}

/// A worker: accepts and serves connections one after another, for ever (until cancelled).
async fn acceptLoop(listener: borrow Listener, served: borrow mut u32) -> Result<void, NetError> {
    let acceptor = PlainAcceptor {};
    loop {
        let stream = await listener.accept()?;
        var conn = await acceptor.accept(stream, Deadline.never())?;
        // Each connection holds its worker a while, so the others must accept meanwhile. Without it, on Linux one
        // worker can drain the whole backlog before another wakes (seen on Debian 12, 2026-11-03).
        match (await Timer.sleep(20)) {
            Ok() => {}
            Err(e) => { return Err(NetErrors.fromAsync(e)); }
        }
        await workerEcho(mut conn)?;
        served += 1;
    }
}

/// A client: sends its number and checks the echo.
async fn workerClient(port: u16, k: u32) -> Result<bool, NetError> {
    var c = await TcpTransport.connect("127.0.0.1", port)?;
    let msg = [65u8 + truncate<u8>(k), 0x2D, 0x6F, 0x6B]; // "A-ok", "B-ok", …
    await c.write(msg[..])?;
    await c.shutdownWrite()?;
    var buf = [0u8; 8];
    var got: usize = 0;
    loop {
        let n = await c.read(mut buf[got..])?;
        if (n == 0) {
            break;
        }
        got += n;
    }
    return Ok(got == 4 && buf[0] == msg[0] && buf[3] == msg[3]);
}

@test
async fn four_workers_serve_twelve_clients() -> Result<void, TestFailure> {
    let listener = net(Listener.bind("127.0.0.1", 0))?;
    let port = net(listener.port())?;
    var s0: u32 = 0;
    var s1: u32 = 0;
    var s2: u32 = 0;
    var s3: u32 = 0;
    var good: u32 = 0;
    var results = [false; 12];
    let r: Result<Raced<u32>, NetError> = await Async.race(
        async () => {
            await Async.scope(NetError.OutOfMemory, (s) => {
                s.spawn(async () => await acceptLoop(listener, mut s0));
                s.spawn(async () => await acceptLoop(listener, mut s1));
                s.spawn(async () => await acceptLoop(listener, mut s2));
                s.spawn(async () => await acceptLoop(listener, mut s3));
            })?;
            return Ok(0u32);
        },
        async () => {
            await Async.scope(NetError.OutOfMemory, (s) => {
                for (k in 0..results.length) {
                    let slot = borrow mut results[k];
                    let n = truncate<u32>(k);
                    s.spawn(async move () => {
                        slot = await workerClient(port, n)?;
                        return Ok();
                    });
                }
            })?;
            return Ok(1u32);
        },
    );
    for (ok in results) {
        if (ok) {
            good += 1;
        }
    }
    Check.isTrue(match (r) {
        Ok(raced) => raced.winner == 1,
        Err(_) => false,
    }, "clients finish first; workers cancelled")?;
    // 12 clients echoed
    Check.equalU64(12, good as u64)?;
    // 4 workers served 12 connections
    Check.equalU64(12, (s0 + s1 + s2 + s3) as u64)?;
    Check.isTrue(
        (if (s0 > 0) 1 else 0) + (if (s1 > 0) 1 else 0) + (if (s2 > 0) 1 else 0) + (if (s3 > 0) 1 else 0) > 1,
        "more than one worker served",
    )?;
    return Ok();
}
