// The opening handshake (RFC 6455 §4): the server's side checks an upgrade request, its origin (Web ADR 0010 §3.4)
// and the subprotocol, and answers with Sec-WebSocket-Accept; the client's side checks the server's 101 (§4.1).
// Sans-I/O.
import web_http;

/// Why an upgrade request is refused, and with which status.
public enum UpgradeRefusal {
    /// 400: not a valid upgrade (§4.2.1).
    BadRequest,
    /// 426 with `Sec-WebSocket-Version: 13` (§4.4).
    Version,
    /// 403: an origin that is neither the server's own nor allowed (§10.2).
    Origin,
}

/// Why a client fails the connection after the server's answer (RFC 6455 §4.1, "the client MUST _Fail the WebSocket
/// Connection_").
public enum HandshakeFailure {
    /// The status was not 101: the server did not switch (it may have refused, redirected or asked for credentials).
    NotSwitched(u16),
    /// `Upgrade: websocket` or `Connection: upgrade` is missing (rules 2 and 3).
    Upgrade,
    /// `Sec-WebSocket-Accept` is missing, repeated, or not the key's (rule 4).
    Accept,
    /// An extension the client did not offer, or permessage-deflate with parameters it cannot accept (rule 5).
    Extension,
    /// A subprotocol the client did not offer, or more than one (rule 6).
    Subprotocol,
}

/// What the server agreed to, once its answer has passed every check.
public struct HandshakeAnswer {
    /// permessage-deflate, if the server accepted the offer.
    public deflate: DeflateAgreement?;
    /// The index in the client's offered subprotocols of the one the server chose, if any.
    public protocol: usize?;
}

/// The opening handshake's checks and computations (RFC 6455 §4).
public struct Handshake {
    /// `Sec-WebSocket-Accept` for `key`: base64(SHA-1(key + the GUID)) (§4.2.2 step 5.4), 28 bytes.
    public fn acceptKey(key: Slice<u8>) -> Result<Vector<u8>, AllocError> {
        var sha = Sha1.create();
        sha.update(key);
        sha.update("258EAFA5-E914-47DA-95CA-C5AB0DC85B11".bytes());
        let digest = sha.finish();
        var out = Vector<u8>.withCapacity(28)?;
        Base64.encode(digest[..], mut out)?;
        return Ok(out);
    }

    /// The client's check of the server's answer (§4.1): status 101, `Upgrade: websocket`, `Connection: upgrade`,
    /// `Sec-WebSocket-Accept` matching `key` (the base64 text the client sent), extensions only as offered
    /// (`deflateOffered`: permessage-deflate, once), and a subprotocol only from `offered`.
    public fn checkAnswer(
        status: u16,
        headers: borrow HeaderList,
        key: Slice<u8>,
        deflateOffered: bool,
        offered: borrow Vector<Vector<u8>>,
    ) -> Result<HandshakeAnswer, HandshakeFailure> {
        if (status != 101) {
            return Err(HandshakeFailure.NotSwitched(status));
        }
        if (!headers.hasToken(HeaderName.Upgrade, "websocket") || !headers.hasToken(HeaderName.Connection, "upgrade")) {
            return Err(HandshakeFailure.Upgrade);
        }
        let expected = match (Handshake.acceptKey(key)) {
            Ok(v) => v,
            Err(_) => { return Err(HandshakeFailure.Accept); }, // cannot check it, so cannot accept it
        };
        var accepts: u32 = 0;
        var matched = false;
        var deflate: DeflateAgreement? = null;
        var protocol: usize? = null;
        var protocols: u32 = 0;
        for (i in 0..headers.count()) {
            let name = headers.nameBytes(i);
            let v = headers.value(i);
            if (Ascii.equalsIgnoringCase(name, "sec-websocket-accept")) {
                accepts += 1;
                matched = same(trim(v), expected.view());
            } else if (Ascii.equalsIgnoringCase(name, "sec-websocket-extensions")) {
                var start: usize = 0;
                for (k in 0..v.length + 1) {
                    if (k < v.length && v[k] != 44) {
                        continue;
                    }
                    let element = trim(v[start..k]);
                    start = k + 1;
                    if (element.length == 0) {
                        continue; // an empty list element (RFC 9110 §5.6.1)
                    }
                    let agreed = match (Extensions.deflateAnswer(element)) {
                        Some(a) => a,
                        null => { return Err(HandshakeFailure.Extension); },
                    };
                    let again = match (deflate) {
                        Some(_) => true,
                        null => false,
                    };
                    if (!deflateOffered || again) {
                        return Err(HandshakeFailure.Extension);
                    }
                    deflate = Some(agreed);
                }
            } else if (Ascii.equalsIgnoringCase(name, "sec-websocket-protocol")) {
                protocols += 1;
                let chosen = trim(v);
                var found: usize? = null;
                for (k in 0..offered.length) {
                    if (same(chosen, offered[k].view())) {
                        found = Some(k);
                    }
                }
                if (found == null) {
                    return Err(HandshakeFailure.Subprotocol);
                }
                protocol = found;
            }
        }
        if (accepts != 1 || !matched) {
            return Err(HandshakeFailure.Accept);
        }
        if (protocols > 1) {
            return Err(HandshakeFailure.Subprotocol);
        }
        return Ok(HandshakeAnswer { deflate: deflate, protocol: protocol });
    }

    /// Whether `request` is a WebSocket upgrade at all (`Upgrade: websocket`), before checking it fully.
    public fn isUpgrade(request: borrow Request) -> bool =>
        request.headers().hasToken(HeaderName.Upgrade, "websocket");

    /// Checks an upgrade request (§4.2.1): `GET` over HTTP/1.1 with a `Host`, `Upgrade: websocket`, `Connection:
    /// upgrade`, a `Sec-WebSocket-Key` of 16 bytes in base64, `Sec-WebSocket-Version: 13`, and an allowed origin.
    /// `secure` says whether the connection is TLS, for the origin's scheme.
    public fn check(
        request: borrow Request,
        secure: bool,
        allowedOrigins: borrow Vector<Vector<u8>>,
    ) -> Result<void, UpgradeRefusal> {
        let headers = request.headers();
        let isGet = match (request.method()) {
            Method.Get => true,
            _ => false,
        };
        let is11 = match (request.version()) {
            Version.Http11 => true,
            _ => false,
        };
        if (!isGet || !is11 || headers.countOf(HeaderName.Host) != 1) {
            return Err(UpgradeRefusal.BadRequest);
        }
        if (!headers.hasToken(HeaderName.Upgrade, "websocket") || !headers.hasToken(HeaderName.Connection, "upgrade")) {
            return Err(UpgradeRefusal.BadRequest);
        }
        let key = match (headers.getNamed("sec-websocket-key")) {
            Some(k) => k,
            null => { return Err(UpgradeRefusal.BadRequest); },
        };
        var decoded = Vector<u8>.create();
        match (Base64.decode(trim(key), mut decoded)) {
            Ok(true) => {}
            _ => { return Err(UpgradeRefusal.BadRequest); }
        }
        if (decoded.length != 16) {
            return Err(UpgradeRefusal.BadRequest);
        }
        match (headers.getNamed("sec-websocket-version")) {
            Some(v) => {
                if (!same(trim(v), "13".bytes())) {
                    return Err(UpgradeRefusal.Version);
                }
            }
            null => { return Err(UpgradeRefusal.BadRequest); }
        }
        match (headers.get(HeaderName.Origin)) {
            Some(origin) => {
                let host = match (headers.get(HeaderName.Host)) {
                    Some(h) => h,
                    null => { return Err(UpgradeRefusal.BadRequest); },
                };
                if (!Handshake.originAllowed(trim(origin), trim(host), secure, allowedOrigins)) {
                    return Err(UpgradeRefusal.Origin);
                }
            }
            null => {} // not a browser
        }
        return Ok();
    }

    /// Whether `origin` (`scheme://host[:port]`) is the server's own (`host` from the Host field, with `secure`'s
    /// scheme; default ports ignored) or one of `allowed` (exact, ignoring ASCII case).
    public fn originAllowed(
        origin: Slice<u8>,
        host: Slice<u8>,
        secure: bool,
        allowed: borrow Vector<Vector<u8>>,
    ) -> bool {
        for (a in allowed) {
            if (sameIgnoringCase(origin, a.view())) {
                return true;
            }
        }
        let scheme = if (secure) "https://".bytes() else "http://".bytes();
        if (origin.length < scheme.length || !sameIgnoringCase(origin[0..scheme.length], scheme)) {
            return false;
        }
        let defaultPort = if (secure) ":443".bytes() else ":80".bytes();
        return sameIgnoringCase(withoutPort(origin[scheme.length..], defaultPort), withoutPort(host, defaultPort));
    }

    /// The index in `preferences` of the subprotocol to use: the first of the server's preferences that the client
    /// listed in `Sec-WebSocket-Protocol` (any number of fields, comma-separated). Null if none.
    public fn chooseSubprotocol(request: borrow Request, preferences: borrow Vector<Vector<u8>>) -> usize? {
        let headers = request.headers();
        for (p in 0..preferences.length) {
            for (i in 0..headers.count()) {
                if (!Ascii.equalsIgnoringCase(headers.nameBytes(i), "sec-websocket-protocol")) {
                    continue;
                }
                let v = headers.value(i);
                var start: usize = 0;
                for (k in 0..v.length + 1) {
                    if (k == v.length || v[k] == 44) {
                        if (same(trim(v[start..k]), preferences[p].view())) {
                            return Some(p);
                        }
                        start = k + 1;
                    }
                }
            }
        }
        return null;
    }
}

fn withoutPort<region r>(authority: Slice<r, u8>, defaultPort: Slice<u8>) -> Slice<r, u8> {
    if (authority.length > defaultPort.length &&
        same(authority[authority.length - defaultPort.length..], defaultPort)) {
        return authority[0..authority.length - defaultPort.length];
    }
    return authority;
}

fn trim(v: Slice<u8>) -> Slice<u8> {
    var a: usize = 0;
    var b = v.length;
    while (a < b && (v[a] == 32 || v[a] == 9)) {
        a += 1;
    }
    while (b > a && (v[b - 1] == 32 || v[b - 1] == 9)) {
        b -= 1;
    }
    return v[a..b];
}

fn same(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

fn lower(c: u8) -> u8 => if (c >= 65 && c <= 90) c + 32 else c;

fn sameIgnoringCase(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (lower(a[i]) != lower(b[i])) {
            return false;
        }
    }
    return true;
}

/// permessage-deflate as agreed (RFC 7692 §7.1).
public struct DeflateAgreement {
    /// We compress each message on its own (we keep no context in any case; this is said when the client asked).
    public serverNoContextTakeover: bool;
    /// The client compresses each message on its own, so our inflater keeps no window.
    public clientNoContextTakeover: bool;
    /// The window our compressor may use (the client's limit, else 15).
    public serverMaxWindowBits: u32;
    /// Whether the client's offer named `server_max_window_bits`, which the response must then repeat.
    public serverWindowNamed: bool;
    /// The window the client's compressor may use: what the server's response named, else 15.
    public clientMaxWindowBits: u32;
}

/// The parameters of one permessage-deflate offer or response, each checked as RFC 7692 §7.1 requires: known,
/// unrepeated, `*_no_context_takeover` without a value, and window bits 8-15.
struct DeflateParams {
    serverNoContextTakeover: bool;
    clientNoContextTakeover: bool;
    /// 0 when absent.
    serverMaxWindowBits: u32;
    clientWindowNamed: bool;
    /// 0 when absent or named without a value.
    clientMaxWindowBits: u32;
}

/// permessage-deflate's negotiation (RFC 7692 §7.1), for both ends.
public struct Extensions {
    /// The first permessage-deflate offer in `Sec-WebSocket-Extensions` (any number of fields) whose parameters are
    /// all known, unrepeated and in range (§7.1: an offer that is not is declined, and the next one considered).
    public fn negotiateDeflate(request: borrow Request) -> DeflateAgreement? {
        let headers = request.headers();
        for (i in 0..headers.count()) {
            if (!Ascii.equalsIgnoringCase(headers.nameBytes(i), "sec-websocket-extensions")) {
                continue;
            }
            let v = headers.value(i);
            var start: usize = 0;
            for (k in 0..v.length + 1) {
                if (k == v.length || v[k] == 44) {
                    match (Extensions.deflateOffer(v[start..k])) {
                        Some(a) => { return Some(a); }
                        null => {}
                    }
                    start = k + 1;
                }
            }
        }
        return null;
    }

    /// One offer (`permessage-deflate; param; param=value`) if it is permessage-deflate and acceptable.
    public fn deflateOffer(offer: Slice<u8>) -> DeflateAgreement? {
        let p = match (deflateParams(offer)) {
            Some(p) => p,
            null => { return null; },
        };
        // Our inflater keeps 15 bits, so any client window is fine, named with a value or without.
        return Some(DeflateAgreement {
            serverNoContextTakeover: p.serverNoContextTakeover,
            clientNoContextTakeover: p.clientNoContextTakeover,
            serverMaxWindowBits: if (p.serverMaxWindowBits == 0) 15 else p.serverMaxWindowBits,
            serverWindowNamed: p.serverMaxWindowBits != 0,
            clientMaxWindowBits: 15,
        });
    }

    /// The client's side: a server's `Sec-WebSocket-Extensions` response to `clientOffer()`, the agreement if it is
    /// permessage-deflate with acceptable parameters, else null and the client fails the connection (RFC 6455 §4.1
    /// rule 5; RFC 7692 §7.1). `client_max_window_bits` must have a value in a response (§7.1.2.2).
    public fn deflateAnswer(response: Slice<u8>) -> DeflateAgreement? {
        let p = match (deflateParams(response)) {
            Some(p) => p,
            null => { return null; },
        };
        if (p.clientWindowNamed && p.clientMaxWindowBits == 0) {
            return null;
        }
        return Some(DeflateAgreement {
            serverNoContextTakeover: p.serverNoContextTakeover,
            clientNoContextTakeover: p.clientNoContextTakeover,
            serverMaxWindowBits: if (p.serverMaxWindowBits == 0) 15 else p.serverMaxWindowBits,
            serverWindowNamed: p.serverMaxWindowBits != 0,
            clientMaxWindowBits: if (p.clientMaxWindowBits == 0) 15 else p.clientMaxWindowBits,
        });
    }

    /// The client's offer: permessage-deflate, letting the server choose our window (our inflater keeps 15 bits, so
    /// any server window is fine).
    public fn clientOffer() -> StringView => "permessage-deflate; client_max_window_bits";

    /// The response's `Sec-WebSocket-Extensions` value for `agreed`.
    public fn deflateResponse(agreed: borrow DeflateAgreement, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
        appendText(out, "permessage-deflate")?;
        if (agreed.serverNoContextTakeover) {
            appendText(out, "; server_no_context_takeover")?;
        }
        if (agreed.clientNoContextTakeover) {
            appendText(out, "; client_no_context_takeover")?;
        }
        if (agreed.serverWindowNamed) {
            appendText(out, "; server_max_window_bits=")?;
            if (agreed.serverMaxWindowBits >= 10) {
                out.push(49)?;
            }
            out.push(48 + truncate<u8>(agreed.serverMaxWindowBits % 10))?;
        }
        return Ok();
    }
}

/// The parameters of `offer` (`permessage-deflate; param; param=value`), or null if it is not permessage-deflate or
/// a parameter is unknown, repeated or out of range.
fn deflateParams(offer: Slice<u8>) -> DeflateParams? {
    var p = DeflateParams {
        serverNoContextTakeover: false,
        clientNoContextTakeover: false,
        serverMaxWindowBits: 0,
        clientWindowNamed: false,
        clientMaxWindowBits: 0,
    };
    var part: usize = 0;
    var start: usize = 0;
    for (k in 0..offer.length + 1) {
        if (k < offer.length && offer[k] != 59) {
            continue;
        }
        let item = trim(offer[start..k]);
        start = k + 1;
        if (part == 0) {
            if (!sameIgnoringCase(item, "permessage-deflate".bytes())) {
                return null;
            }
            part = 1;
            continue;
        }
        var eq: usize = 0;
        while (eq < item.length && item[eq] != 61) {
            eq += 1;
        }
        let name = trim(item[0..eq]);
        let hasValue = eq < item.length;
        let raw = if (hasValue) trim(item[eq + 1..]) else item[0..0];
        let quoted = raw.length >= 2 && raw[0] == 34 && raw[raw.length - 1] == 34;
        let value = if (quoted) raw[1..raw.length - 1] else raw; // a quoted-string, or a token
        if (sameIgnoringCase(name, "server_no_context_takeover".bytes())) {
            if (hasValue || p.serverNoContextTakeover) {
                return null;
            }
            p.serverNoContextTakeover = true;
        } else if (sameIgnoringCase(name, "client_no_context_takeover".bytes())) {
            if (hasValue || p.clientNoContextTakeover) {
                return null;
            }
            p.clientNoContextTakeover = true;
        } else if (sameIgnoringCase(name, "server_max_window_bits".bytes())) {
            let bits = windowBits(value);
            if (!hasValue || p.serverMaxWindowBits != 0 || bits == 0) {
                return null;
            }
            p.serverMaxWindowBits = bits;
        } else if (sameIgnoringCase(name, "client_max_window_bits".bytes())) {
            let bits = if (hasValue) windowBits(value) else 0;
            if (p.clientWindowNamed || (hasValue && bits == 0)) {
                return null;
            }
            p.clientWindowNamed = true;
            p.clientMaxWindowBits = bits;
        } else {
            return null; // an unknown parameter
        }
    }
    if (part == 0) {
        return null;
    }
    return Some(p);
}

/// 8-15 from a decimal value, else 0.
fn windowBits(v: Slice<u8>) -> u32 {
    if (v.length == 0 || v.length > 2 || (v.length == 2 && v[0] == 48)) {
        return 0;
    }
    var n: u32 = 0;
    for (c in v) {
        if (c < 48 || c > 57) {
            return 0;
        }
        n = n * 10 + (c - 48) as u32;
    }
    return if (n >= 8 && n <= 15) n else 0;
}

fn appendText(out: borrow mut Vector<u8>, text: StringView) -> Result<void, AllocError> {
    out.extend(text.bytes())?;
    return Ok();
}
