// An owned list of header fields (Web ADR 0011 §3.2): what HPACK decodes into and encodes from, and what an HTTP/2
// stream's head and its response's head travel as between a stream task and its connection.

/// Where one field's name and value are in a `HeaderBlock`'s bytes.
public struct FieldSpan {
    public nameAt: u32;
    public nameLength: u32;
    public valueAt: u32;
    public valueLength: u32;
    /// Sent as "never indexed" (§6.2.3): an intermediary must forward it the same way.
    public sensitive: bool;
}

/// A decoded header list: the fields in order, their bytes in one buffer.
@noncopy
public struct HeaderBlock {
    private bytes: Vector<u8>;
    private spans: Vector<FieldSpan>;
    private listSize: u64;

    /// An empty list.
    public fn create() -> HeaderBlock =>
        HeaderBlock { bytes: Vector<u8>.create(), spans: Vector<FieldSpan>.create(), listSize: 0 };

    /// Empties the list, keeping its memory.
    public fn clear(borrow mut this) {
        this.bytes.clear();
        this.spans.clear();
        this.listSize = 0;
    }

    /// How many fields.
    public fn count(borrow this) -> usize => this.spans.length;

    /// The `i`th field's name.
    public fn name(borrow this, i: usize) -> Slice<u8> {
        let s = this.spans[i];
        let all = this.bytes.view();
        return all[s.nameAt as usize..(s.nameAt + s.nameLength) as usize];
    }

    /// The `i`th field's value.
    public fn value(borrow this, i: usize) -> Slice<u8> {
        let s = this.spans[i];
        let all = this.bytes.view();
        return all[s.valueAt as usize..(s.valueAt + s.valueLength) as usize];
    }

    /// The `i`th field's span.
    public fn span(borrow this, i: usize) -> FieldSpan => this.spans[i];

    /// The list's size as RFC 9113 §6.5.2 counts it: each field's name and value, plus 32.
    public fn size(borrow this) -> u64 => this.listSize;

    /// All the names and values, which the spans index.
    public fn allBytes(borrow this) -> Slice<u8> => this.bytes.view();

    /// Whether a field named `name` (lowercase) is sent "never indexed" unless its sender says otherwise: credentials
    /// and cookies, whose values an attacker who shares the connection could otherwise probe through the
    /// compression context (RFC 7541 §7.1.3; Web ADR 0012 §3.10).
    public fn sensitiveByDefault(name: Slice<u8>) -> bool =>
        Ascii.equalsIgnoringCase(name, "authorization") || Ascii.equalsIgnoringCase(name, "proxy-authorization") ||
            Ascii.equalsIgnoringCase(name, "cookie") || Ascii.equalsIgnoringCase(name, "set-cookie");

    /// Appends the fields of an HTTP/1.1 field section, `name:value` lines each ending in CR LF, as the chunked
    /// decoder checked them (RFC 9112 §7.1.2): names lowercased, values without their leading and trailing whitespace
    /// (RFC 9110 §5.5).
    public fn pushLines(borrow mut this, lines: Slice<u8>) -> Result<void, AllocError> {
        var lower = Vector<u8>.create();
        var start: usize = 0;
        for (i in 0..lines.length) {
            if (lines[i] != 10) {
                continue;
            }
            let end = if (i > start && lines[i - 1] == 13) i - 1 else i;
            var colon = start;
            while (colon < end && lines[colon] != 58) {
                colon += 1;
            }
            if (colon < end) {
                lower.clear();
                for (c in lines[start..colon]) {
                    lower.push(if (c >= 65 && c <= 90) c + 32 else c)?;
                }
                var from = colon + 1;
                while (from < end && (lines[from] == 32 || lines[from] == 9)) {
                    from += 1;
                }
                var to = end;
                while (to > from && (lines[to - 1] == 32 || lines[to - 1] == 9)) {
                    to -= 1;
                }
                let name = lower.view();
                this.push(name, lines[from..to], HeaderBlock.sensitiveByDefault(name))?;
            }
            start = i + 1;
        }
        return Ok();
    }

    /// Appends a copy of every field of `other`.
    public fn pushAll(borrow mut this, other: borrow HeaderBlock) -> Result<void, AllocError> {
        for (i in 0..other.count()) {
            this.push(other.name(i), other.value(i), other.span(i).sensitive)?;
        }
        return Ok();
    }

    /// Appends a field.
    public fn push(borrow mut this, name: Slice<u8>, value: Slice<u8>, sensitive: bool) -> Result<void, AllocError> {
        let nameAt = this.bytes.length;
        appendBytes(mut this.bytes, name)?;
        let valueAt = this.bytes.length;
        appendBytes(mut this.bytes, value)?;
        this.spans.push(FieldSpan {
            nameAt: truncate<u32>(nameAt),
            nameLength: truncate<u32>(name.length),
            valueAt: truncate<u32>(valueAt),
            valueLength: truncate<u32>(value.length),
            sensitive: sensitive,
        })?;
        this.listSize += name.length as u64 + value.length as u64 + 32;
        return Ok();
    }
}

fn appendBytes(out: borrow mut Vector<u8>, bytes: Slice<u8>) -> Result<void, AllocError> {
    out.extend(bytes)?;
    return Ok();
}
