// One request's exchange with its connection (Web ADR 0003 §3.3, §3.5, amendment 3): the request body to read and the
// response to write, over one transport. A handler gets one `borrow mut Exchange`, not a body and a writer, because
// both use the transport mutably and CeeSafe lends a value mutably once at a time; and neither can be `dyn`, since a
// type with a region cannot implement an interface (N0267). So it is one concrete type with both sets of methods.
//
// Writing: body bytes collect in `pending` (the connection's response buffer). A response that ends before `pending`
// fills is sent with an exact Content-Length; one that outgrows it, or is flushed, is sent with the length the handler
// declared, or chunked (HTTP/1.1), or until close (HTTP/1.0). Finished responses collect in `out`, so the driver can
// send several pipelined responses in one write (implementation plan §7, M2 task 4).
import web_core;

/// How a handler failed (Web ADR 0007 §3.1).
public enum HandlerError {
    /// Respond with this status, if no head was sent yet.
    Status(StatusCode),
    /// The connection failed: close it.
    Io(NetError),
    /// A bug or an unexpected state: 500 if no head was sent, else close the connection.
    Internal,
}

/// What a connection's driver runs for each request: `web_server`'s server, or a test. Not generic, so a driver
/// needs no type parameter.
public interface Application {
    /// Handles one request: read its body and write its response through `exchange`.
    async fn handle(borrow this, request: borrow Request, exchange: borrow mut Exchange, connection: borrow ConnectionContext,) -> Result<void, HandlerError>;

    /// Runs just before a response head is sent, when the handler writes past the buffer or returns: middleware's
    /// `after` hooks add their fields here (Web ADR 0007 §3.2, amendment 1).
    async fn beforeHead(borrow this, request: borrow Request, head: borrow mut ResponseHead) -> Result<void, HandlerError>;
}

/// The state of the request body.
enum BodyState {
    Done,
    Length,
    Chunked,
    /// A multiplexed stream's: read through its `StreamSink` until it ends.
    Stream,
}

/// One request's body and response, over its connection.
public struct Exchange<region r> {
    private conn: borrow mut(r) dyn Transport;
    /// A multiplexed stream's body and response go through `stream` (Web ADR 0011 §3.2); an HTTP/1.1 exchange's
    /// through `conn`, with a `NoStream` here.
    private stream: borrow mut(r) dyn StreamSink;
    private multiplexed: bool;
    private carry: borrow mut(r) OwnedBuffer;
    private out: borrow mut(r) OwnedBuffer;
    private pending: borrow mut(r) OwnedBuffer;
    private response: borrow mut(r) ResponseHead;
    private app: borrow(r) dyn Application;
    private request: borrow(r) Request<r>;
    private limits: borrow(r) Limits;
    private date: borrow mut(r) DateCache;

    private body: BodyState;
    private left: u64;
    /// A multiplexed request's declared length less what has been read, or null without a declaration.
    private streamLeft: u64?;
    private decoder: ChunkDecoder;
    private rate: MinRate;
    private continuePending: bool;
    private bodyBroken: bool;

    private sent: bool;
    private framing: ResponseFraming;
    private streaming: bool;
    private written: u64;
    private keep: bool;
    private done: bool;
    private upgraded: bool;
    /// The request's trailer section: its lines as they arrive (HTTP/1.1), then its fields once the body has ended.
    private trailerLines: Vector<u8>;
    private trailerFields: HeaderBlock;
    /// The response's trailer fields, sent at its end (`trailer`).
    private responseTrailers: HeaderBlock;

    /// An exchange for `request`, whose body is framed by `framing`. `carry` holds the bytes received after the head;
    /// `out` the responses not yet sent; `pending` and `response` are reset here. `keepAlive` is the request's own
    /// verdict (version and Connection).
    public fn create(
        conn: borrow mut(r) dyn Transport,
        stream: borrow mut(r) dyn StreamSink,
        carry: borrow mut(r) OwnedBuffer,
        out: borrow mut(r) OwnedBuffer,
        pending: borrow mut(r) OwnedBuffer,
        response: borrow mut(r) ResponseHead,
        app: borrow(r) dyn Application,
        request: borrow(r) Request<r>,
        limits: borrow(r) Limits,
        date: borrow mut(r) DateCache,
        framing: BodyFraming,
        expectContinue: bool,
        keepAlive: bool,
    ) -> Exchange<r> {
        pending.clear();
        response.reset();
        let state = match (framing) {
            BodyFraming.None => BodyState.Done,
            BodyFraming.Length(_) => BodyState.Length,
            BodyFraming.Chunked => BodyState.Chunked,
        };
        let length = match (framing) {
            BodyFraming.Length(n) => n,
            _ => 0,
        };
        let rate = if (limits.minBodyRate == 0) MinRate.off() else MinRate.startingNow(
            limits.minBodyRate,
            limits.minBodyRateGraceMs,
        );
        let decoder = ChunkDecoder.create(limits);
        let hasBody = match (state) {
            BodyState.Done => false,
            _ => true,
        };
        return Exchange {
            conn: conn,
            stream: stream,
            multiplexed: false,
            carry: carry,
            out: out,
            pending: pending,
            response: response,
            app: app,
            request: request,
            limits: limits,
            date: date,
            body: state,
            left: length,
            streamLeft: null,
            decoder: decoder,
            rate: rate,
            continuePending: expectContinue && hasBody,
            bodyBroken: false,
            sent: false,
            framing: ResponseFraming.NoContent,
            streaming: false,
            written: 0,
            keep: keepAlive,
            done: false,
            upgraded: false,
            trailerLines: Vector<u8>.create(),
            trailerFields: HeaderBlock.create(),
            responseTrailers: HeaderBlock.create(),
        };
    }

    /// An exchange for a request that came on a multiplexed stream (Web ADR 0011 §3.2): its body is read and its
    /// response written through `stream`. `conn` is a `NoTransport`, and `carry` and `out` are unused; `pending`
    /// collects the body before the head is sent, as over HTTP/1.1. `hasBody` is false when the request ended with
    /// its head (END_STREAM).
    public fn forStream(
        stream: borrow mut(r) dyn StreamSink,
        conn: borrow mut(r) dyn Transport,
        carry: borrow mut(r) OwnedBuffer,
        out: borrow mut(r) OwnedBuffer,
        pending: borrow mut(r) OwnedBuffer,
        response: borrow mut(r) ResponseHead,
        app: borrow(r) dyn Application,
        request: borrow(r) Request<r>,
        limits: borrow(r) Limits,
        date: borrow mut(r) DateCache,
        hasBody: bool,
    ) -> Exchange<r> {
        pending.clear();
        response.reset();
        let decoder = ChunkDecoder.create(limits);
        // The engine has checked a declared length against the DATA (RFC 9113 §8.1.1).
        let declared = match (request.headers().get(HeaderName.ContentLength)) {
            Some(v) => Ascii.parseDecimal(v),
            null => null,
        };
        return Exchange {
            conn: conn,
            stream: stream,
            multiplexed: true,
            carry: carry,
            out: out,
            pending: pending,
            response: response,
            app: app,
            request: request,
            limits: limits,
            date: date,
            body: if (hasBody) BodyState.Stream else BodyState.Done,
            left: 0,
            streamLeft: if (hasBody) declared else null,
            decoder: decoder,
            rate: MinRate.off(),
            continuePending: false,
            bodyBroken: false,
            sent: false,
            framing: ResponseFraming.NoContent,
            streaming: false,
            written: 0,
            keep: false,
            done: false,
            upgraded: false,
            trailerLines: Vector<u8>.create(),
            trailerFields: HeaderBlock.create(),
            responseTrailers: HeaderBlock.create(),
        };
    }

    // ---- The request body ----

    /// Reads body bytes into `buffer`: at least one, or 0 at the end of the body. The first read sends `100
    /// Continue` if the client asked for it (RFC 9110 §10.1.1). A malformed or too large body is
    /// `Status(400 or 413)`, a client too slow `Status(408)`; either closes the connection afterwards.
    public async fn read(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, HandlerError> {
        if (buffer.length == 0) {
            return Err(HandlerError.Internal);
        }
        if (this.bodyBroken) {
            return Err(HandlerError.Status(Status.badRequest()));
        }
        match (this.body) {
            BodyState.Done => { return Ok(0); }
            _ => {}
        }
        if (this.multiplexed) {
            let n = await this.stream.readBody(buffer)?;
            match (this.streamLeft) {
                Some(left) => {
                    let got = n as u64;
                    this.streamLeft = Some(if (got < left) left - got else 0u64);
                }
                null => {}
            }
            if (n == 0) {
                this.body = BodyState.Done;
                grown(this.stream.copyTrailers(mut this.trailerFields))?;
            }
            return Ok(n);
        }
        if (this.continuePending) {
            this.continuePending = false;
            if (!this.sent) {
                await this.flushOut()?;
                await this.writeBytes("HTTP/1.1 100 Continue\r\n\r\n".bytes())?;
            }
        }
        loop {
            if (this.carry.isEmpty()) {
                await this.receive()?;
            }
            match (this.body) {
                BodyState.Length => {
                    let available = this.carry.readable();
                    var n = if (buffer.length < available.length) buffer.length else available.length;
                    if (n as u64 > this.left) {
                        n = truncate<usize>(this.left);
                    }
                    for (i in 0..n) {
                        buffer[i] = available[i];
                    }
                    this.consumeCarry(n)?;
                    this.left -= n as u64;
                    if (this.left == 0) {
                        this.body = BodyState.Done;
                    }
                    return Ok(n);
                }
                BodyState.Chunked => {
                    let input = this.carry.readable();
                    let step = match (this.decoder.decode(input, buffer.length)) {
                        Ok(s) => s,
                        Err(e) => {
                            this.bodyBroken = true;
                            this.keep = false;
                            return Err(HandlerError.Status(ProtocolErrors.status(e)));
                        },
                    };
                    for (i in 0..step.dataLength) {
                        buffer[i] = input[step.dataStart + i];
                    }
                    for (i in 0..step.trailerLength) {
                        grown(this.trailerLines.push(input[step.trailerStart + i]))?;
                    }
                    this.consumeCarry(step.consumed)?;
                    if (step.finished) {
                        this.body = BodyState.Done;
                        grown(this.trailerFields.pushLines(this.trailerLines.view()))?;
                        this.trailerLines.clear();
                    }
                    if (step.dataLength > 0) {
                        return Ok(step.dataLength);
                    }
                    if (step.finished) {
                        return Ok(0);
                    }
                }
                BodyState.Done => { return Ok(0); }
                BodyState.Stream => { return Ok(0); } // a stream's is read above
            }
        }
    }

    /// The request's trailer fields (RFC 9110 §6.5): empty until `read` has returned 0, and empty if the request had
    /// none. Over HTTP/1.1 they come from a chunked body's trailer section; over HTTP/2 from the HEADERS that ended the
    /// stream (RFC 9113 §8.1). Names are lowercase.
    public fn trailers(borrow this) -> borrow HeaderBlock => borrow this.trailerFields;

    /// Adds a trailer field to the response (RFC 9110 §6.5), sent after its content: over HTTP/2 as HEADERS ending the
    /// stream, over HTTP/1.1 in the last chunk of a chunked response. A response with a declared length over HTTP/1.1
    /// has nowhere to put trailers (RFC 9112 §7.1.2), so they are dropped, as for a response without content. A name
    /// that is not a token, a value with a control byte, and the fields that frame or route a message
    /// (`content-length`, `transfer-encoding`, `host`, `connection`, `te`, `trailer`) are `Internal`.
    public fn trailer(borrow mut this, name: StringView, value: Slice<u8>) -> Result<void, HandlerError> {
        let n = name.bytes();
        if (!Ascii.isToken(n) || Ascii.equalsIgnoringCase(n, "content-length") ||
            Ascii.equalsIgnoringCase(n, "transfer-encoding") || Ascii.equalsIgnoringCase(n, "host") ||
            Ascii.equalsIgnoringCase(n, "connection") || Ascii.equalsIgnoringCase(n, "te") ||
            Ascii.equalsIgnoringCase(n, "trailer")) {
            return Err(HandlerError.Internal);
        }
        for (b in value) {
            if (!Ascii.isFieldValueChar(b)) {
                return Err(HandlerError.Internal);
            }
        }
        var lower = Vector<u8>.create();
        for (c in n) {
            grown(lower.push(Ascii.lower(c)))?;
        }
        let l = lower.view();
        grown(this.responseTrailers.push(l, value, HeaderBlock.sensitiveByDefault(l)))?;
        return Ok();
    }

    /// Reads the rest of the body into `into`. `Status(413)` if it would exceed `into`'s room.
    public async fn readToEnd(borrow mut this, into: borrow mut OwnedBuffer) -> Result<void, HandlerError> {
        loop {
            into.compact();
            if (into.spareLength() == 0) {
                var probe = [0u8; 1];
                let n = await this.read(mut probe[..])?;
                if (n == 0) {
                    return Ok();
                }
                return Err(HandlerError.Status(Status.contentTooLarge()));
            }
            let n = await this.read(into.spare())?;
            if (n == 0) {
                return Ok();
            }
            match (into.commit(n)) {
                Ok() => {}
                Err(_) => { return Err(HandlerError.Internal); }
            }
        }
    }

    /// Returns when the client has closed or reset the connection; never while it is open and quiet, so it belongs
    /// inside a `race` (Web ADR 0008 §3.1). The body must be read first (`Internal` otherwise). Bytes the client
    /// sends meanwhile are kept for the driver; once that buffer is full this waits until it is cancelled, and a
    /// failed write finds the close instead. Cancelling it loses nothing.
    public async fn peerClosed(borrow mut this) -> Result<void, HandlerError> {
        if (this.multiplexed) {
            // A stream's reset cancels its whole task (Web ADR 0011 §3.2), so this only waits to be cancelled.
            loop {
                match (await Timer.sleep(3600000)) {
                    Ok() => {}
                    Err(_) => { return Err(HandlerError.Io(NetError.Cancelled)); }
                }
            }
        }
        match (this.body) {
            BodyState.Done => {}
            _ => { return Err(HandlerError.Internal); }
        }
        loop {
            this.carry.compact();
            if (this.carry.spareLength() == 0) {
                match (await Timer.sleep(3600000)) {
                    Ok() => {}
                    Err(_) => { return Err(HandlerError.Io(NetError.Cancelled)); }
                }
                continue; // nothing to do until the race ends this
            }
            let n = match (await this.conn.read(this.carry.spare())) {
                Ok(n) => n,
                Err(NetError.Cancelled) => { return Err(HandlerError.Io(NetError.Cancelled)); },
                Err(_) => 0, // a reset is a close
            };
            if (n == 0) {
                this.keep = false;
                return Ok();
            }
            match (this.carry.commit(n)) {
                Ok() => {}
                Err(_) => { return Err(HandlerError.Internal); }
            }
        }
    }

    /// The body bytes not yet read, if the body has a length (over HTTP/2, a declared `content-length`); 0 once it is
    /// read; null for a chunked body or an HTTP/2 body without a declared length.
    public fn remaining(borrow this) -> u64? => match (this.body) {
        BodyState.Done => Some(0u64),
        BodyState.Length => Some(this.left),
        BodyState.Chunked => null,
        BodyState.Stream => this.streamLeft,
    };

    /// Reads more of the connection into `carry`, bounded by the minimum-rate deadline.
    async fn receive(borrow mut this) -> Result<void, HandlerError> {
        this.carry.compact();
        let n = match (await Transports.readWithin(this.conn, this.carry.spare(), this.rate.deadline())) {
            Ok(n) => n,
            Err(NetError.TimedOut) => {
                this.bodyBroken = true;
                this.keep = false;
                return Err(HandlerError.Status(Status.requestTimeout()));
            },
            Err(e) => {
                this.bodyBroken = true;
                this.keep = false;
                return Err(HandlerError.Io(e));
            },
        };
        if (n == 0) {
            this.bodyBroken = true; // the client ended before its body did
            this.keep = false;
            return Err(HandlerError.Io(NetError.Closed));
        }
        this.rate.record(n);
        match (this.carry.commit(n)) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(HandlerError.Internal); }
        }
    }

    fn consumeCarry(borrow mut this, n: usize) -> Result<void, HandlerError> {
        match (this.carry.consume(n)) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(HandlerError.Internal); }
        }
    }

    // ---- The response ----

    /// Sets the status; ignored once the head was sent.
    public fn setStatus(borrow mut this, status: StatusCode) {
        if (!this.sent) {
            this.response.setStatus(status);
        }
    }

    /// Adds a response field. `Internal` for a bad name or value, a framing field, or no room; after the head was
    /// sent, `Internal` too.
    public fn header(borrow mut this, name: StringView, value: Slice<u8>) -> Result<void, HandlerError> {
        if (this.sent) {
            return Err(HandlerError.Internal);
        }
        match (this.response.add(name, value)) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(HandlerError.Internal); }
        }
    }

    /// Declares the body's length, so it is sent with Content-Length even when it outgrows the buffer.
    public fn setContentLength(borrow mut this, n: u64) {
        if (!this.sent) {
            this.response.setContentLength(n);
        }
    }

    /// Asks for the connection to close after this response.
    public fn closeConnection(borrow mut this) {
        this.keep = false;
    }

    /// Whether the head has been sent (or queued to send).
    public fn headSent(borrow this) -> bool => this.sent;

    /// Writes body bytes. They wait in the response buffer; a full buffer sends the head and the bytes so far.
    public async fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, HandlerError> {
        if (this.done) {
            return Err(HandlerError.Internal);
        }
        var at: usize = 0;
        while (at < bytes.length) {
            if (this.pending.spareLength() == 0) {
                this.pending.compact();
            }
            if (this.pending.spareLength() == 0) {
                await this.sendPending()?;
                continue;
            }
            let room = this.pending.spareLength();
            let n = if (bytes.length - at < room) bytes.length - at else room;
            match (this.pending.append(bytes[at..at + n])) {
                Ok() => {}
                Err(_) => { return Err(HandlerError.Internal); }
            }
            at += n;
        }
        return Ok();
    }

    /// Sends everything written so far now: the head, and the body as it stands (a streaming response). The rest
    /// of the response follows chunked unless a length was declared.
    public async fn flush(borrow mut this) -> Result<void, HandlerError> {
        this.streaming = true;
        await this.sendPending()?;
        if (!this.multiplexed) {
            await this.flushOut()?;
        }
        return Ok();
    }

    /// Sets `status`, the length of `body`, writes it: a whole small response in one call.
    public async fn send(borrow mut this, status: StatusCode, body: Slice<u8>) -> Result<void, HandlerError> {
        this.setStatus(status);
        this.setContentLength(body.length as u64);
        return await this.write(body);
    }

    /// Sends the head if it was not sent, then moves `pending` to the wire: into `out` if it fits, else written with
    /// `out` in one vectored step.
    async fn sendPending(borrow mut this) -> Result<void, HandlerError> {
        if (this.multiplexed) {
            return await this.streamPending(false);
        }
        if (!this.sent) {
            await this.sendHead(this.response.contentLength())?;
        }
        let n = this.pending.length();
        if (n == 0) {
            return Ok();
        }
        this.written += n as u64;
        if (Methods.same(this.request.method(), Method.Head)) {
            this.pending.clear(); // HEAD: the length GET would send, and no content (RFC 9110 §9.3.2)
            return Ok();
        }
        match (this.framing) {
            ResponseFraming.NoContent => {
                this.pending.clear(); // 204, 304: counted, not sent
                return Ok();
            }
            ResponseFraming.Length(total) => {
                if (this.written > total) {
                    this.keep = false; // more than declared: the framing would be wrong
                    return Err(HandlerError.Internal);
                }
            }
            ResponseFraming.Chunked => {
                if (this.out.spareLength() < 18) {
                    await this.flushOut()?;
                }
                match (Encoder.chunkHeader(n, this.out)) {
                    Ok() => {}
                    Err(_) => { return Err(HandlerError.Internal); }
                }
            }
            ResponseFraming.UntilClose => {}
        }
        let chunked = match (this.framing) {
            ResponseFraming.Chunked => true,
            _ => false,
        };
        if (this.out.spareLength() >= n + 2) {
            match (this.out.append(this.pending.readable())) {
                Ok() => {}
                Err(_) => { return Err(HandlerError.Internal); }
            }
            if (chunked) {
                match (Encoder.chunkEnd(this.out)) {
                    Ok() => {}
                    Err(_) => { return Err(HandlerError.Internal); }
                }
            }
            this.pending.clear();
            return Ok();
        }
        // Too big to copy: send `out`, the body and the chunk's CRLF together.
        let crlf = "\r\n";
        let crlfBytes = crlf.bytes();
        let tail = if (chunked) crlfBytes else crlfBytes[0..0];
        let first = match (IoParts.of(this.out.readable()).then(this.pending.readable())) {
            Some(p) => p,
            null => { return Err(HandlerError.Internal); },
        };
        let parts = match (first.then(tail)) {
            Some(p) => p,
            null => { return Err(HandlerError.Internal); },
        };
        match (await Transports.writeAllVectoredWithin(this.conn, parts, Deadline.after(this.limits.writeTimeoutMs))) {
            Ok() => {}
            Err(e) => {
                this.keep = false;
                return Err(HandlerError.Io(e));
            }
        }
        this.out.clear();
        this.pending.clear();
        return Ok();
    }

    /// A stream's response head (RFC 9113 §8.3.2): `:status`, the handler's fields with their names in lower case
    /// (§8.2.1), `content-length` when `length` is known and the status allows content, and `date` unless the handler set
    /// one. The application's
    /// hook runs first when `hooks`.
    async fn streamHead(borrow mut this, length: u64?, end: bool, hooks: bool) -> Result<void, HandlerError> {
        if (hooks) {
            await this.app.beforeHead(this.request, this.response)?;
        }
        var fields = HeaderBlock.create();
        let status = this.response.status();
        let code = status.code();
        var digits = [48 + truncate<u8>(code / 100), 48 + truncate<u8>(code / 10 % 10), 48 + truncate<u8>(code % 10)];
        grown(fields.push(":status".bytes(), digits[..], false))?;
        let all = this.response.fieldBytes();
        var lower = Vector<u8>.create();
        var start: usize = 0;
        for (i in 0..all.length) {
            if (all[i] != 10) {
                continue;
            }
            let line = all[start..i - 1]; // without CR LF
            start = i + 1;
            var colon: usize = 0;
            while (colon < line.length && line[colon] != 58) {
                colon += 1;
            }
            lower.clear();
            for (c in line[0..colon]) {
                grown(lower.push(if (c >= 65 && c <= 90) c + 32 else c))?;
            }
            let name = lower.view();
            grown(fields.push(name, line[colon + 2..], HeaderBlock.sensitiveByDefault(name)))?;
        }
        match (length) {
            Some(n) => {
                if (status.allowsContent()) {
                    var text = [0u8; 20];
                    var at: usize = 20;
                    var v = n;
                    loop {
                        at -= 1;
                        text[at] = 48 + truncate<u8>(v % 10);
                        v /= 10;
                        if (v == 0) {
                            break;
                        }
                    }
                    grown(fields.push("content-length".bytes(), text[at..], false))?;
                }
            }
            null => {}
        }
        // One `Date` (RFC 9110 §6.6.1): the handler's when it set one (a proxy relays its origin's), else ours.
        if (!this.response.has("date")) {
            this.date.refresh();
            match (this.date.bytes()) {
                Some(d) => { grown(fields.push("date".bytes(), d, false))?; }
                null => {}
            }
        }
        this.sent = true;
        return await this.stream.sendHead(fields, end);
    }

    /// A stream's buffered body as DATA (the head first, if not sent), ending the response if `end`.
    async fn streamPending(borrow mut this, end: bool) -> Result<void, HandlerError> {
        if (!this.sent) {
            await this.streamHead(this.response.contentLength(), false, true)?;
        }
        let n = this.pending.length();
        if (n == 0 && !end) {
            return Ok();
        }
        this.written += n as u64;
        if (Methods.same(this.request.method(), Method.Head) || !this.response.status().allowsContent()) {
            this.pending.clear(); // counted, not sent
            if (end) {
                await this.stream.sendData("".bytes(), true)?;
            }
            return Ok();
        }
        await this.stream.sendData(this.pending.readable(), end)?;
        this.pending.clear();
        return Ok();
    }

    /// Over a stream, the response's trailers as HEADERS ending it, if `trailing`.
    async fn streamTrailers(borrow mut this, trailing: bool) -> Result<void, HandlerError> {
        if (!trailing) {
            return Ok();
        }
        var fields = HeaderBlock.create();
        grown(fields.pushAll(this.responseTrailers))?;
        return await this.stream.sendHead(fields, true);
    }

    /// Runs the application's hook, chooses the framing, and queues the head in `out`.
    async fn sendHead(borrow mut this, length: u64?) -> Result<void, HandlerError> {
        await this.app.beforeHead(this.request, this.response)?;
        let status = this.response.status();
        this.framing = Encoder.framing(status, this.request.method(), this.request.version(), length);
        match (this.framing) {
            ResponseFraming.UntilClose => { this.keep = false; }
            _ => {}
        }
        if (this.response.closes()) {
            this.keep = false;
        }
        if (this.continuePending) {
            // The handler answers without reading a body the client is waiting to be asked for: the client may send
            // it or not, so the connection cannot carry another request (and says so).
            this.keep = false;
        }
        this.date.refresh();
        match (Encoder.head(this.response, this.framing, this.keep, this.date.bytes(), this.out)) {
            Ok() => {}
            Err(_) => {
                await this.flushOut()?;
                match (Encoder.head(this.response, this.framing, this.keep, this.date.bytes(), this.out)) {
                    Ok() => {}
                    Err(_) => { return Err(HandlerError.Internal); } // the head alone is larger than the buffer
                }
            }
        }
        this.sent = true;
        // A body must not follow a response without content; an interim status is not a final response.
        return Ok();
    }

    /// Writes `out` to the connection and empties it.
    async fn flushOut(borrow mut this) -> Result<void, HandlerError> {
        if (this.out.isEmpty()) {
            return Ok();
        }
        match (await Transports.writeWithin(
            this.conn,
            this.out.readable(),
            Deadline.after(this.limits.writeTimeoutMs),
        )) {
            Ok() => {}
            Err(e) => {
                this.keep = false;
                return Err(HandlerError.Io(e));
            }
        }
        this.out.clear();
        return Ok();
    }

    async fn writeBytes(borrow mut this, bytes: Slice<u8>) -> Result<void, HandlerError> {
        match (await Transports.writeWithin(this.conn, bytes, Deadline.after(this.limits.writeTimeoutMs))) {
            Ok() => { return Ok(); }
            Err(e) => {
                this.keep = false;
                return Err(HandlerError.Io(e));
            }
        }
    }

    // ---- Another protocol (Web ADR 0010 §3.2) ----

    /// Answers 101 Switching Protocols to `protocol` (a token, such as `websocket`) with the fields the handler added,
    /// and sends it now. Afterwards the connection belongs to the handler, through `readRaw` and `writeRaw`, and the
    /// server closes it when the handler returns. `Internal` if anything was sent already, if the request has a body,
    /// or if it is not HTTP/1.1.
    public async fn switchProtocols(borrow mut this, protocol: StringView) -> Result<void, HandlerError> {
        if (this.multiplexed) {
            return Err(HandlerError.Internal); // no upgrade on a stream (RFC 9113 §8.6)
        }
        let is11 = match (this.request.version()) {
            Version.Http11 => true,
            _ => false,
        };
        let noBody = match (this.body) {
            BodyState.Done => true,
            _ => false,
        };
        if (this.sent || this.done || !is11 || !noBody || this.pending.length() > 0) {
            return Err(HandlerError.Internal);
        }
        this.response.setStatus(Status.switchingProtocols());
        match (this.response.upgradeTo(protocol)) {
            Ok() => {}
            Err(_) => { return Err(HandlerError.Internal); }
        }
        this.keep = true; // so the head says `connection: upgrade`, not `close`
        await this.sendHead(null)?;
        this.keep = false; // never another request on this connection
        this.done = true;
        this.upgraded = true;
        await this.flushOut()?;
        return Ok();
    }

    /// After `switchProtocols`: bytes from the client, those received after the request's head first. 0 at the end
    /// of the stream. Cancelling it loses nothing (Web ADR 0001 §3.4).
    public async fn readRaw(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, HandlerError> {
        if (!this.upgraded) {
            return Err(HandlerError.Internal);
        }
        if (!this.carry.isEmpty()) {
            let held = this.carry.readable();
            let n = if (held.length < buffer.length) held.length else buffer.length;
            for (i in 0..n) {
                buffer[i] = held[i];
            }
            match (this.carry.consume(n)) {
                Ok() => {}
                Err(_) => { return Err(HandlerError.Internal); }
            }
            return Ok(n);
        }
        match (await this.conn.read(buffer)) {
            Ok(n) => { return Ok(n); }
            Err(e) => { return Err(HandlerError.Io(e)); }
        }
    }

    /// After `switchProtocols`: writes `bytes` to the client, within `Limits.writeTimeoutMs`. A failed or cancelled
    /// write leaves the connection unusable (Web ADR 0001 §3.4).
    public async fn writeRaw(borrow mut this, bytes: Slice<u8>) -> Result<void, HandlerError> {
        if (!this.upgraded) {
            return Err(HandlerError.Internal);
        }
        return await this.writeBytes(bytes);
    }

    /// After `switchProtocols`: ends this side's writing to the client (TCP FIN, or TLS close_notify then FIN), which
    /// may still send; a tunnel does this when its other side has finished sending (Web ADR 0012 §3.8).
    public async fn shutdownRaw(borrow mut this) -> Result<void, HandlerError> {
        if (!this.upgraded) {
            return Err(HandlerError.Internal);
        }
        match (await this.conn.shutdownWrite()) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(HandlerError.Io(e)); }
        }
    }

    /// Pushes a response to a GET for `path` (RFC 9113 §8.4; Web ADR 0011 §3.2): the client is promised it, and the
    /// application handles that request on its own stream as if the client had asked. False over HTTP/1.1, when the
    /// client refuses pushes, or when the connection cannot make one now.
    public async fn push(borrow mut this, path: StringView) -> Result<bool, HandlerError> {
        if (!this.multiplexed) {
            return Ok(false);
        }
        return await this.stream.push(path.bytes());
    }

    /// Whether the connection was switched to another protocol.
    public fn switched(borrow this) -> bool => this.upgraded;

    // ---- For the driver ----

    /// Ends the response after the handler returned `Ok`: a response that was never sent goes out whole with an
    /// exact Content-Length; a chunked one gets its last chunk. A response shorter than its declared length closes
    /// the connection. Streaming responses are flushed now.
    public async fn finish(borrow mut this) -> Result<void, HandlerError> {
        if (this.done) {
            return Ok();
        }
        this.done = true;
        if (this.multiplexed) {
            let bodyless = Methods.same(this.request.method(), Method.Head) || !this.response.status().allowsContent();
            let trailing = this.responseTrailers.count() > 0 && !bodyless;
            if (this.sent) {
                await this.streamPending(!trailing)?;
                return await this.streamTrailers(trailing);
            }
            let length = match (this.response.contentLength()) {
                Some(n) => n,
                null => this.pending.length() as u64,
            };
            if (bodyless || (this.pending.length() == 0 && !trailing)) {
                this.pending.clear();
                return await this.streamHead(Some(length), true, true);
            }
            await this.streamHead(if (trailing) this.response.contentLength() else Some(length), false, true)?;
            await this.streamPending(!trailing)?;
            return await this.streamTrailers(trailing);
        }
        if (!this.sent) {
            // Trailers need a chunked body (RFC 9112 §7.1.2), unless a length was declared, or there is no content.
            let bodyless = Methods.same(this.request.method(), Method.Head) || !this.response.status().allowsContent();
            let trailing = this.responseTrailers.count() > 0 && !bodyless;
            let length = match (this.response.contentLength()) {
                Some(n) => Some(n),
                null => if (trailing) null else Some(this.pending.length() as u64),
            };
            await this.sendHead(length)?;
        }
        await this.sendPending()?;
        match (this.framing) {
            ResponseFraming.Chunked => {
                // The last chunk, its trailer section (RFC 9112 §7.1.2), and the empty line.
                var size: usize = 5;
                for (i in 0..this.responseTrailers.count()) {
                    size += this.responseTrailers.name(i).length + this.responseTrailers.value(i).length + 4;
                }
                if (this.out.spareLength() < size) {
                    await this.flushOut()?;
                }
                if (this.out.spareLength() < size) {
                    return Err(HandlerError.Internal); // trailers larger than the write buffer
                }
                grown(netGrown(this.out.append("0\r\n".bytes())))?;
                for (i in 0..this.responseTrailers.count()) {
                    grown(netGrown(this.out.append(this.responseTrailers.name(i))))?;
                    grown(netGrown(this.out.append(": ".bytes())))?;
                    grown(netGrown(this.out.append(this.responseTrailers.value(i))))?;
                    grown(netGrown(this.out.append("\r\n".bytes())))?;
                }
                grown(netGrown(this.out.append("\r\n".bytes())))?;
            }
            ResponseFraming.Length(total) => {
                if (this.written != total && !Methods.same(this.request.method(), Method.Head)) {
                    this.keep = false; // fewer bytes than declared: the client would wait for the rest
                }
            }
            ResponseFraming.UntilClose => { this.keep = false; }
            ResponseFraming.NoContent => {}
        }
        if (this.streaming) {
            await this.flushOut()?;
        }
        return Ok();
    }

    /// Replaces an unsent response with an error response of `status` and no content, closing the connection if
    /// `close`. False if a head was already sent: the connection must close instead.
    public async fn respondError(borrow mut this, status: StatusCode, close: bool) -> bool {
        if (this.multiplexed) {
            if (this.sent) {
                return false; // the driver resets the stream instead
            }
            this.response.reset();
            this.response.setStatus(status);
            this.pending.clear();
            this.done = true;
            let length: u64? = if (status.allowsContent()) Some(0u64) else null;
            match (await this.streamHead(length, true, false)) {
                Ok() => { return true; }
                Err(_) => { return false; }
            }
        }
        if (this.sent) {
            this.keep = false;
            return false;
        }
        if (close) {
            this.keep = false;
        }
        this.response.reset();
        this.response.setStatus(status);
        this.pending.clear();
        let framing = if (status.allowsContent()) ResponseFraming.Length(0) else ResponseFraming.NoContent;
        this.date.refresh();
        match (Encoder.head(this.response, framing, this.keep, this.date.bytes(), this.out)) {
            Ok() => {}
            Err(_) => {
                // No room beside the responses waiting in `out`: send them, then try again.
                match (await this.flushOut()) {
                    Ok() => {}
                    Err(_) => { return false; }
                }
                match (Encoder.head(this.response, framing, this.keep, this.date.bytes(), this.out)) {
                    Ok() => {}
                    Err(_) => {
                        this.keep = false;
                        return false;
                    }
                }
            }
        }
        this.sent = true;
        this.done = true;
        this.framing = framing;
        return true;
    }

    /// After the response: reads and discards what the handler left of the body, up to `Limits.drainBytes`, so the
    /// next request can be read; past that, or on an error, the connection closes instead (Web ADR 0003 §3.3).
    public async fn finishBody(borrow mut this) {
        if (this.multiplexed) {
            return; // the stream's driver discards what was not read
        }
        if (this.bodyBroken) {
            this.keep = false;
            return;
        }
        if (!this.keep) {
            return; // closing anyway: no need to read what is left
        }
        match (this.body) {
            BodyState.Done => { return; }
            _ => {}
        }
        if (this.continuePending) {
            // The client waits for 100 Continue that will never come; it may send the body or not, so the
            // connection cannot be reused safely.
            this.keep = false;
            return;
        }
        var drained: u64 = 0;
        var scratch = [0u8; 512];
        while (drained <= this.limits.drainBytes) {
            match (await this.read(mut scratch[..])) {
                Ok(0) => { return; }
                Ok(n) => { drained += n as u64; }
                Err(_) => {
                    this.keep = false;
                    return;
                }
            }
        }
        this.keep = false;
    }

    /// Whether the connection may carry another request.
    public fn keepAlive(borrow this) -> bool => this.keep;

    /// Whether this response was streamed (flushed by the handler): the driver sends it before reading on.
    public fn streamed(borrow this) -> bool => this.streaming;
}

fn grown(r: Result<void, AllocError>) -> Result<void, HandlerError> {
    match (r) {
        Ok() => { return Ok(); }
        Err(_) => { return Err(HandlerError.Internal); }
    }
}

fn netGrown(r: Result<void, NetError>) -> Result<void, AllocError> {
    match (r) {
        Ok() => { return Ok(); }
        Err(_) => { return Err(AllocError.OutOfMemory); }
    }
}
