// Who the client is, and what a proxy tells its upstream (Web ADR 0012 §3.4): trusted proxies as CIDR blocks; the
// `Forwarded` field (RFC 7239) and `X-Forwarded-For` read right to left past trusted hops; and the fields sent on.
// Sans-I/O: fields in, values out.
import web_core;
import web_http;

/// A block of addresses: `10.0.0.0/8`, `2001:db8::/32`, or one address (`192.0.2.1`, a /32 or /128).
public struct Cidr {
    private bytes: [u8; 16];
    private v4: bool;
    private prefix: u8;

    /// The block `text` names; null if it is not an address with an optional `/prefix` within its family's length.
    public fn parse(text: Slice<u8>) -> Cidr? {
        var slash = text.length;
        for (i in 0..text.length) {
            if (text[i] == 47) {
                slash = i;
                break;
            }
        }
        let addressText = match (StringView.fromUtf8(text[0..slash])) {
            Some(t) => t,
            null => { return null; },
        };
        let address = SocketAddresses.parseIp(addressText, 0)?;
        var bytes = [0u8; 16];
        var v4 = false;
        var bits: u64 = 0;
        match (address) {
            SocketAddress.V4(a, _) => {
                v4 = true;
                for (k in 0..4usize) {
                    bytes[k] = a[k];
                }
                bits = 32;
            }
            SocketAddress.V6(a, _, scope) => {
                if (scope != 0) {
                    return null; // a zone names a link, not a block
                }
                bytes = a;
                bits = 128;
            }
        }
        var prefix = bits;
        if (slash < text.length) {
            prefix = Ascii.parseDecimal(text[slash + 1..])?;
            if (prefix > bits) {
                return null;
            }
        }
        return Some(Cidr { bytes: bytes, v4: v4, prefix: truncate<u8>(prefix) });
    }

    /// Whether `address` is in the block. An IPv4-mapped IPv6 address (`::ffff:a.b.c.d`) is matched as IPv4.
    public fn contains(borrow this, address: SocketAddress) -> bool {
        var bytes = [0u8; 16];
        var v4 = false;
        match (address) {
            SocketAddress.V4(a, _) => {
                v4 = true;
                for (k in 0..4usize) {
                    bytes[k] = a[k];
                }
            }
            SocketAddress.V6(a, _, _) => {
                if (mapped(a)) {
                    v4 = true;
                    for (k in 0..4usize) {
                        bytes[k] = a[12 + k];
                    }
                } else {
                    bytes = a;
                }
            }
        }
        if (v4 != this.v4) {
            return false;
        }
        var left = this.prefix as usize;
        var k: usize = 0;
        while (left >= 8) {
            if (bytes[k] != this.bytes[k]) {
                return false;
            }
            left -= 8;
            k += 1;
        }
        if (left == 0) {
            return true;
        }
        let mask = truncate<u8>(0xFF00u32 >> truncate<u32>(left));
        return bytes[k] & mask == this.bytes[k] & mask;
    }
}

/// Whether `a` is an IPv4-mapped IPv6 address (RFC 4291 §2.5.5.2).
fn mapped(a: [u8; 16]) -> bool {
    for (k in 0..10usize) {
        if (a[k] != 0) {
            return false;
        }
    }
    return a[10] == 255 && a[11] == 255;
}

/// The proxies whose forwarding fields are believed: their addresses as CIDR blocks. None by default.
public struct TrustedProxies {
    private blocks: Vector<Cidr>;

    /// No proxy is trusted: every peer is the client.
    public fn none() -> TrustedProxies => TrustedProxies { blocks: Vector<Cidr>.create() };

    /// Trusts the block `text` (`Cidr.parse`); false if it is not one.
    public fn add(borrow mut this, text: StringView) -> Result<bool, AllocError> {
        let block = match (Cidr.parse(text.bytes())) {
            Some(b) => b,
            null => { return Ok(false); },
        };
        this.blocks.push(block)?;
        return Ok(true);
    }

    /// Whether `address` is in one of the blocks.
    public fn trusts(borrow this, address: SocketAddress) -> bool {
        for (i in 0..this.blocks.length) {
            if (this.blocks[i].contains(address)) {
                return true;
            }
        }
        return false;
    }
}

/// One hop of a forwarding chain, as a `for=` value or an `X-Forwarded-For` element names it.
public enum Hop {
    /// An address (its port, if one was given; 0 otherwise).
    Address(SocketAddress),
    /// `unknown`, or an obfuscated identifier (`_hidden`, RFC 7239 §6.3): a hop that keeps its address to itself.
    Hidden,
    /// Text that is none of these, or an element without `for=`.
    Malformed,
}

/// Which field says who the client is, when the peer is trusted.
public enum ForwardedSource {
    /// `Forwarded` if the request has one, else `X-Forwarded-For` (Web ADR 0012 §3.4).
    ForwardedFirst,
    /// `X-Forwarded-For` if the request has one, else `Forwarded`.
    XForwardedForFirst,
}

/// Who the client is.
public enum ClientIs {
    /// This address.
    Address(SocketAddress),
    /// A hop that hid its address (`unknown`, or obfuscated).
    Hidden,
    /// Nobody knows: the peer's address itself is unknown (a test's transport).
    Unknown,
}

/// The hops of a chain, left (the first proxy's client) to right (the last proxy).
public struct Hops {
    private list: Vector<Hop>;

    /// The `for=` hops of every `Forwarded` field in `headers`, in order (RFC 7239 §4: several fields are one list).
    /// An element without `for=`, or one that does not parse, is `Malformed`.
    public fn fromForwarded(headers: borrow HeaderList) -> Result<Hops, AllocError> {
        var list = Vector<Hop>.create();
        for (i in 0..headers.count()) {
            if (!Ascii.equalsIgnoringCase(headers.nameBytes(i), "forwarded")) {
                continue;
            }
            let value = headers.value(i);
            var start: usize = 0;
            var quoted = false;
            for (k in 0..value.length + 1) {
                if (k < value.length) {
                    let b = value[k];
                    if (b == 34) {
                        quoted = !quoted;
                    }
                    if (quoted || b != 44) {
                        continue;
                    }
                }
                list.push(forElement(value[start..k]))?;
                start = k + 1;
            }
        }
        return Ok(Hops { list: list });
    }

    /// The hops of every `X-Forwarded-For` field in `headers`, in order: addresses, with or without a port (`[::1]:80`).
    public fn fromXForwardedFor(headers: borrow HeaderList) -> Result<Hops, AllocError> {
        var list = Vector<Hop>.create();
        for (i in 0..headers.count()) {
            if (!Ascii.equalsIgnoringCase(headers.nameBytes(i), "x-forwarded-for")) {
                continue;
            }
            let value = headers.value(i);
            var start: usize = 0;
            for (k in 0..value.length + 1) {
                if (k < value.length && value[k] != 44) {
                    continue;
                }
                list.push(node(trimWhitespace(value[start..k])))?;
                start = k + 1;
            }
        }
        return Ok(Hops { list: list });
    }

    /// How many hops.
    public fn count(borrow this) -> usize => this.list.length;

    /// The `i`th hop, from the left.
    public fn hop(borrow this, i: usize) -> Hop => this.list[i];
}

/// The `for=` hop of one `Forwarded` element (`for=…;proto=…`, RFC 7239 §4): parameter names are case-insensitive.
fn forElement(element: Slice<u8>) -> Hop {
    var found: Hop = Hop.Malformed;
    var start: usize = 0;
    var quoted = false;
    for (k in 0..element.length + 1) {
        if (k < element.length) {
            let b = element[k];
            if (b == 34) {
                quoted = !quoted;
            }
            if (quoted || b != 59) {
                continue;
            }
        }
        let pair = trimWhitespace(element[start..k]);
        start = k + 1;
        var eq: usize = 0;
        while (eq < pair.length && pair[eq] != 61) {
            eq += 1;
        }
        if (eq == pair.length) {
            if (pair.length > 0) {
                return Hop.Malformed;
            }
            continue;
        }
        if (!Ascii.isToken(pair[0..eq])) {
            return Hop.Malformed;
        }
        if (Ascii.equalsIgnoringCase(pair[0..eq], "for")) {
            var from = eq + 1;
            var to = pair.length;
            if (to - from >= 2 && pair[from] == 34 && pair[to - 1] == 34) {
                from += 1;
                to -= 1;
            } else if (to > from && (pair[from] == 91 || pair[from] == 34)) {
                return Hop.Malformed; // IPv6 must be quoted (RFC 7239 §6)
            }
            found = node(pair[from..to]);
        }
    }
    return found;
}

/// A node (RFC 7239 §6): an IPv4 address or `[IPv6]`, with an optional `:port`; `unknown`; or an obfuscated `_name`.
fn node(text: Slice<u8>) -> Hop {
    if (text.length == 0) {
        return Hop.Malformed;
    }
    if (Ascii.equalsIgnoringCase(text, "unknown") || text[0] == 95) {
        return Hop.Hidden;
    }
    var hostStart: usize = 0;
    var hostEnd = text.length;
    var port: u16 = 0;
    if (text[0] == 91) {
        var close: usize = 0;
        while (close < text.length && text[close] != 93) {
            close += 1;
        }
        if (close == text.length) {
            return Hop.Malformed;
        }
        hostStart = 1;
        hostEnd = close;
        if (close + 1 < text.length) {
            if (text[close + 1] != 58) {
                return Hop.Malformed;
            }
            port = match (portOf(text[close + 2..])) {
                Some(p) => p,
                null => { return Hop.Malformed; },
            };
        }
    } else {
        var colons: usize = 0;
        var last: usize = 0;
        for (k in 0..text.length) {
            if (text[k] == 58) {
                colons += 1;
                last = k;
            }
        }
        if (colons == 1) {
            hostEnd = last;
            port = match (portOf(text[last + 1..])) {
                Some(p) => p,
                null => { return Hop.Malformed; },
            };
        }
    }
    let hostText = match (StringView.fromUtf8(text[hostStart..hostEnd])) {
        Some(t) => t,
        null => { return Hop.Malformed; },
    };
    return match (SocketAddresses.parseIp(hostText, port)) {
        Some(a) => Hop.Address(a),
        null => Hop.Malformed,
    };
}

/// A port, `0` to `65535`; an obfuscated port (`_1`) is accepted as 0.
fn portOf(text: Slice<u8>) -> u16? {
    if (text.length > 0 && text[0] == 95) {
        return Some(0u16);
    }
    let n = Ascii.parseDecimal(text)?;
    if (n > 65535) {
        return null;
    }
    return Some(truncate<u16>(n));
}

/// Who the client is (Web ADR 0012 §3.4). A peer that is not trusted is the client, whatever its fields say. Past a
/// trusted peer the chain is read from the right: each trusted address is skipped, and the first untrusted one is the
/// client; a hidden hop is the client, unnamed; a malformed hop ends the walk with the last trusted address; if every
/// hop is trusted, the left-most is the client.
public fn clientOf(
    peer: SocketAddress?,
    headers: borrow HeaderList,
    trusted: borrow TrustedProxies,
    source: ForwardedSource,
) -> Result<ClientIs, AllocError> {
    let p = match (peer) {
        Some(a) => a,
        null => { return Ok(ClientIs.Unknown); },
    };
    if (!trusted.trusts(p)) {
        return Ok(ClientIs.Address(p));
    }
    let forwarded = Hops.fromForwarded(headers)?;
    let xff = Hops.fromXForwardedFor(headers)?;
    let hops = match (source) {
        ForwardedSource.ForwardedFirst => if (forwarded.count() > 0) forwarded else xff,
        ForwardedSource.XForwardedForFirst => if (xff.count() > 0) xff else forwarded,
    };
    var last = p;
    var i = hops.count();
    while (i > 0) {
        i -= 1;
        match (hops.hop(i)) {
            Hop.Address(a) => {
                if (!trusted.trusts(a)) {
                    return Ok(ClientIs.Address(a));
                }
                last = a;
            }
            Hop.Hidden => { return Ok(ClientIs.Hidden); }
            Hop.Malformed => { return Ok(ClientIs.Address(last)); }
        }
    }
    return Ok(ClientIs.Address(last));
}

/// What the proxy sends upstream about the request's origin (Web ADR 0012 §3.4): each value, or empty to send none.
public struct ForwardingFields {
    /// `Forwarded`: a trusted peer's chain with this hop appended, or this hop alone.
    public forwarded: Vector<u8>;
    /// `X-Forwarded-For`: likewise, addresses only.
    public forwardedFor: Vector<u8>;
    /// `X-Forwarded-Proto`: a trusted peer's, else this hop's scheme.
    public forwardedProto: Vector<u8>;
    /// `X-Forwarded-Host`: a trusted peer's, else the request's host.
    public forwardedHost: Vector<u8>;
}

/// The forwarding fields for a request that came from `peer` over `scheme` (`http` or `https`) for `host`. The
/// incoming fields are kept and extended only when `peer` is trusted; from any other peer they are replaced, never
/// extended. `forwarded` and `xForwarded` choose which families are produced.
public fn forwardingFields(
    peer: SocketAddress?,
    headers: borrow HeaderList,
    trusted: borrow TrustedProxies,
    scheme: StringView,
    host: Slice<u8>,
    forwarded: bool,
    xForwarded: bool,
) -> Result<ForwardingFields, AllocError> {
    let believed = match (peer) {
        Some(p) => trusted.trusts(p),
        null => false,
    };
    var out = ForwardingFields {
        forwarded: Vector<u8>.create(),
        forwardedFor: Vector<u8>.create(),
        forwardedProto: Vector<u8>.create(),
        forwardedHost: Vector<u8>.create(),
    };
    if (forwarded) {
        if (believed) {
            joinAll(mut out.forwarded, headers, "forwarded")?;
        }
        if (out.forwarded.length > 0) {
            append(mut out.forwarded, ", ".bytes())?;
        }
        append(mut out.forwarded, "for=".bytes())?;
        match (peer) {
            Some(p) => {
                var ip = Vector<u8>.create();
                ipText(p, mut ip)?;
                match (p) {
                    SocketAddress.V6(_, _, _) => {
                        append(mut out.forwarded, "\"[".bytes())?;
                        append(mut out.forwarded, ip.view())?;
                        append(mut out.forwarded, "]\"".bytes())?;
                    }
                    _ => { append(mut out.forwarded, ip.view())?; }
                }
            }
            null => { append(mut out.forwarded, "unknown".bytes())?; }
        }
        append(mut out.forwarded, ";proto=".bytes())?;
        append(mut out.forwarded, scheme.bytes())?;
        if (host.length > 0) {
            append(mut out.forwarded, ";host=".bytes())?;
            if (Ascii.isToken(host)) {
                append(mut out.forwarded, host)?;
            } else {
                quote(mut out.forwarded, host)?;
            }
        }
    }
    if (xForwarded) {
        if (believed) {
            joinAll(mut out.forwardedFor, headers, "x-forwarded-for")?;
            joinAll(mut out.forwardedProto, headers, "x-forwarded-proto")?;
            joinAll(mut out.forwardedHost, headers, "x-forwarded-host")?;
        }
        match (peer) {
            Some(p) => {
                if (out.forwardedFor.length > 0) {
                    append(mut out.forwardedFor, ", ".bytes())?;
                }
                ipText(p, mut out.forwardedFor)?;
            }
            null => {}
        }
        if (out.forwardedProto.length == 0) {
            append(mut out.forwardedProto, scheme.bytes())?;
        }
        if (out.forwardedHost.length == 0) {
            append(mut out.forwardedHost, host)?;
        }
    }
    return Ok(out);
}

/// The values of every field named `name` in `headers`, joined with ", ".
fn joinAll(out: borrow mut Vector<u8>, headers: borrow HeaderList, name: StringView) -> Result<void, AllocError> {
    for (i in 0..headers.count()) {
        if (!Ascii.equalsIgnoringCase(headers.nameBytes(i), name)) {
            continue;
        }
        if (out.length > 0) {
            append(out, ", ".bytes())?;
        }
        append(out, headers.value(i))?;
    }
    return Ok();
}

/// `address`'s IP as text, without its port or brackets: `192.0.2.1`, `2001:db8::1` (RFC 5952's form).
public fn ipText(address: SocketAddress, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var buffer = [0u8; 64];
    var w = TextWriter.create(mut buffer[..]);
    let zeroPort = address.withPort(0);
    zeroPort.write(mut w);
    let n = w.length();
    let all = buffer[0..n];
    // "a.b.c.d:0" or "[v6%zone]:0": drop the port, then the brackets and any zone.
    var end = n;
    while (end > 0 && all[end - 1] != 58) {
        end -= 1;
    }
    end -= 1;
    var start: usize = 0;
    if (all[0] == 91) {
        start = 1;
        end -= 1;
        var k = start;
        while (k < end && all[k] != 37) {
            k += 1;
        }
        end = k;
    }
    return append(out, all[start..end]);
}

fn quote(out: borrow mut Vector<u8>, text: Slice<u8>) -> Result<void, AllocError> {
    out.push(34)?;
    for (b in text) {
        if (b == 34 || b == 92) {
            out.push(92)?;
        }
        out.push(b)?;
    }
    return out.push(34);
}

fn append(out: borrow mut Vector<u8>, bytes: Slice<u8>) -> Result<void, AllocError> {
    for (b in bytes) {
        out.push(b)?;
    }
    return Ok();
}
