// Two QuicConnections, a client and a server, exchanging datagrams in memory on a fake clock (Web ADR 0014 §4, stage
// 2). Expected outcomes are RFC 9000's and RFC 9001's:
// - the handshake completes on both sides;
// - ALPN `h3` is chosen, the only protocol both offer;
// - a client-initiated bidirectional stream is stream 0 (RFC 9000 §2.1);
// - its bytes arrive whole and in order with the FIN, and are echoed back;
// - a CONNECTION_CLOSE leaves the peer draining (§10.2).
// The server's certificate is the test CA's "localhost" (certs.cee), verified by the client.
import web_core;
import web_tls;

fn tls(r: Result<TlsConfig, TlsSetupError>) -> Result<TlsConfig, TlsFailure> => match (r) {
    Ok(c) => Ok(c),
    Err(_) => Err(TlsFailure.Setup),
};

enum TlsFailure {
    Setup,
}

fn ok<T>(r: Result<T, QuicError>, what: StringView) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(e) => {
            var m = String.create();
            let _ = m.append(what);
            let _ = m.append(": ");
            let _ = m.append(describe(e));
            match (e) {
                QuicError.Failed(code) => {
                    let _ = m.append(" ");
                    let _ = m.appendNumber(code as i64);
                }
                _ => {}
            }
            return Err(TestFailure.create(m.view()));
        }
    }
}

fn describe(e: QuicError) -> StringView => match (e) {
    QuicError.Draining => "Draining",
    QuicError.IdleTimeout => "IdleTimeout",
    QuicError.NotInitial => "NotInitial",
    QuicError.StreamsBlocked => "StreamsBlocked",
    QuicError.NoMemory => "NoMemory",
    QuicError.BufferTooSmall(_) => "BufferTooSmall",
    QuicError.Failed(_) => "Failed",
    QuicError.Tls => "Tls",
};

fn setup<T>(r: Result<T, TlsSetupError>, what: StringView) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create(what)); }
    }
}

/// Both sides' contexts: a server presenting "localhost" with ALPN h3, and a client trusting the test CA.
struct Pair {
    server: QuicTls;
    client: QuicTls;
    serverConfig: TlsConfig;
    clientConfig: TlsConfig;
}

fn pair() -> Result<Pair, TestFailure> {
    var serverConfig = setup(TlsConfig.server(serverPem().bytes(), serverKey().bytes()), "the server configuration")?;
    let alpn = [Alpn.Http3];
    setup(serverConfig.setAlpn(alpn[..]), "the server's ALPN")?;
    var clientConfig = setup(TlsConfig.client(), "the client configuration")?;
    setup(clientConfig.trustPem(caPem().bytes()), "the client's trust")?;
    setup(clientConfig.setAlpn(alpn[..]), "the client's ALPN")?;
    let server = ok(QuicTls.of(serverConfig), "the server's QUIC context")?;
    let client = ok(QuicTls.of(clientConfig), "the client's QUIC context")?;
    return Ok(Pair { server: server, client: client, serverConfig: serverConfig, clientConfig: clientConfig });
}

/// What one side received, so far.
struct Seen {
    handshake: bool;
    data: Vector<u8>;
    fin: bool;
    stream: i64;
    opened: i64;
    /// The code of the last RESET_STREAM and STOP_SENDING received, or -1.
    resetCode: i64;
    stopCode: i64;
}

fn seen() -> Seen => Seen {
    handshake: false,
    data: Vector<u8>.create(),
    fin: false,
    stream: -1,
    opened: -1,
    resetCode: -1,
    stopCode: -1,
};

fn drain(conn: borrow mut QuicConnection, buffer: SliceMut<u8>, into: borrow mut Seen) -> Result<void, TestFailure> {
    loop {
        let event = match (ok(conn.nextEvent(buffer), "an event")?) {
            Some(e) => e,
            null => { return Ok(); },
        };
        match (event) {
            QuicEvent.HandshakeDone => { into.handshake = true; }
            QuicEvent.StreamData(stream, length, fin) => {
                into.stream = stream;
                match (into.data.extend(buffer[0..length])) {
                    Ok() => {}
                    Err(_) => { return Err(TestFailure.create("out of memory")); }
                }
                if (fin) {
                    into.fin = true;
                }
            }
            QuicEvent.StreamOpened(stream) => { into.opened = stream; }
            QuicEvent.StreamReset(_, code) => { into.resetCode = truncate<i64>(code); }
            QuicEvent.StopSending(_, code) => { into.stopCode = truncate<i64>(code); }
            _ => {}
        }
    }
}

/// The two connections and what each has seen; the client's first datagram makes the server.
struct Link {
    client: QuicConnection;
    server: QuicConnection?;
    clientSeen: Seen;
    serverSeen: Seen;
    now: u64;
    /// Drop every `dropEvery`-th datagram, in either direction (0: none); `count` numbers them.
    dropEvery: u64;
    count: u64;
}

/// Whether the next datagram is dropped.
fn dropped(link: borrow mut Link) -> bool {
    link.count += 1;
    return link.dropEvery > 0 && link.count % link.dropEvery == 0;
}

fn clientAddress() -> QuicAddress {
    let a = SocketAddress.V4([127u8, 0, 0, 1], 50000);
    return QuicAddress.of(a);
}

fn serverAddress() -> QuicAddress {
    let a = SocketAddress.V4([127u8, 0, 0, 1], 4433);
    return QuicAddress.of(a);
}

/// One round: every datagram the client has goes to the server, then every one the server has goes to the client;
/// the clock moves on 1 ms.
fn round(link: borrow mut Link, p: borrow Pair, buffer: SliceMut<u8>, out: SliceMut<u8>) -> Result<void, TestFailure> {
    let local = clientAddress();
    let remote = serverAddress();
    loop {
        let sent = match (ok(link.client.datagram(out, link.now), "the client's datagram")?) {
            Some(d) => d,
            null => { break; },
        };
        if (link.server.isNull()) {
            let ids = ok(QuicIds.random(), "random IDs")?;
            let made = ok(
                QuicConnection.server(p.server, out[0..sent.length], remote, local, ids, link.now),
                "the server connection",
            )?;
            link.server = Some(made);
        }
        if (dropped(link)) {
            continue;
        }
        match (borrow mut link.server) {
            Some(s) => {
                ok(s.feed(local, sent.ecn, out[0..sent.length], link.now), "the server's read")?;
                drain(s, buffer, mut link.serverSeen)?;
            }
            null => {}
        }
    }
    match (borrow mut link.server) {
        Some(s) => {
            loop {
                let sent = match (ok(s.datagram(out, link.now), "the server's datagram")?) {
                    Some(d) => d,
                    null => { break; },
                };
                link.count += 1;
                if (link.dropEvery > 0 && link.count % link.dropEvery == 0) {
                    continue;
                }
                ok(link.client.feed(remote, sent.ecn, out[0..sent.length], link.now), "the client's read")?;
                drain(mut link.client, buffer, mut link.clientSeen)?;
            }
        }
        null => {}
    }
    drain(mut link.client, buffer, mut link.clientSeen)?;
    link.now += 1000000;
    // Timers due (loss recovery's among them): RFC 9002's probe timeout is what recovers a tail lost.
    match (link.client.nextTimeout()) {
        Some(t) => {
            if (t <= link.now) {
                ok(link.client.onTimeout(link.now), "the client's timer")?;
            }
        }
        null => {}
    }
    match (borrow mut link.server) {
        Some(s) => {
            match (s.nextTimeout()) {
                Some(t) => {
                    if (t <= link.now) {
                        ok(s.onTimeout(link.now), "the server's timer")?;
                    }
                }
                null => {}
            }
        }
        null => {}
    }
    return Ok();
}

fn linked(p: borrow Pair) -> Result<Link, TestFailure> {
    let ids = ok(QuicIds.random(), "random IDs")?;
    let local = clientAddress();
    let remote = serverAddress();
    let client = ok(QuicConnection.client(p.client, "localhost", local, remote, ids, 1000000000), "the client")?;
    return Ok(Link {
        client: client,
        server: null,
        clientSeen: seen(),
        serverSeen: seen(),
        now: 1000000000,
        dropEvery: 0,
        count: 0,
    });
}

@test
fn handshake_stream_echo_and_close() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    var buffer = Vector<u8>.create();
    match (buffer.resize(quicEventBufferSize(), 0)) {
        Ok() => {}
        Err(_) => { return Err(TestFailure.create("out of memory")); }
    }
    var out = [0u8; 1452];
    // The handshake: RFC 9001 needs a few round trips; 20 is far more than enough.
    var rounds = 0;
    while (rounds < 20 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.clientSeen.handshake, "the client's handshake completed")?;
    Check.isTrue(link.serverSeen.handshake, "the server's handshake completed")?;
    Check.isTrue(link.client.handshakeDone(), "handshakeDone, client")?;
    match (link.client.alpn()) {
        Alpn.Http3 => {}
        _ => { return Err(TestFailure.create("ALPN h3 on the client")); }
    }
    // A stream: the client's first bidirectional stream is 0 (RFC 9000 §2.1).
    let stream = ok(link.client.openStream(), "a stream")?;
    Check.isTrue(stream == 0, "the first client stream is 0")?;
    let message = "hello over QUIC, from CeeSafe.Web";
    Check.equalU64(
        message.length as u64,
        ok(link.client.writeStream(stream, message.bytes(), true), "the client's write")? as u64,
    )?;
    rounds = 0;
    while (rounds < 20 && !link.serverSeen.fin) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.serverSeen.fin, "the server received the stream's end")?;
    Check.isTrue(link.serverSeen.stream == 0, "the data came on stream 0")?;
    Check.isTrue(link.serverSeen.opened == 0, "the server saw stream 0 open")?;
    Check.equalBytes(message.bytes(), link.serverSeen.data.view())?;
    // The echo, on the same stream.
    match (borrow mut link.server) {
        Some(s) => {
            let echoed = link.serverSeen.data.view();
            Check.equalU64(
                echoed.length as u64,
                ok(s.writeStream(stream, echoed, true), "the server's write")? as u64,
            )?;
        }
        null => { return Err(TestFailure.create("no server")); }
    }
    rounds = 0;
    while (rounds < 20 && !link.clientSeen.fin) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.clientSeen.fin, "the client received the echo's end")?;
    Check.equalBytes(message.bytes(), link.clientSeen.data.view())?;
    // Close: the server, fed the client's CONNECTION_CLOSE, is draining (RFC 9000 §10.2).
    let n = ok(link.client.closeDatagram(Some(0), mut out[..], link.now), "the close")?;
    Check.isTrue(n > 0, "a CONNECTION_CLOSE was written")?;
    let local = clientAddress();
    match (borrow mut link.server) {
        Some(s) => {
            match (s.feed(local, 0, out[0..n], link.now)) {
                Err(QuicError.Draining) => {}
                _ => { return Err(TestFailure.create("the server is draining")); }
            }
        }
        null => {}
    }
    return Ok();
}

/// Byte `i` of the lossy transfer's stream.
fn lossyByte(i: usize) -> u8 => 97 + truncate<u8>(i % 26);

/// 3 MiB on one stream while every fifth datagram is dropped, both ways. RFC 9000 §2.2 and RFC 9002: the bytes arrive
/// whole and in order, so lost packets were retransmitted from the bytes the sender still held (held in chunks that
/// never move, Web ADR 0014 amendment 2), and data held behind a loss was delivered once the loss was repaired.
@test
fn lossy_transfer_is_whole_and_in_order() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    link.dropEvery = 5;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var out = [0u8; 1452];
    var rounds = 0;
    while (rounds < 2000 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.clientSeen.handshake && link.serverSeen.handshake, "the handshake, under loss")?;
    let total: usize = 3 * 1048576;
    var piece = [0u8; 16384];
    var written: usize = 0;
    let stream = ok(link.client.openStream(), "a stream")?;
    rounds = 0;
    while (rounds < 200000 && !link.serverSeen.fin) {
        // Write what the stream takes; it holds at most a megabyte unacknowledged.
        while (written < total) {
            let n: usize = if (total - written < piece.length) total - written else piece.length;
            for (i in 0..n) {
                piece[i] = lossyByte(written + i);
            }
            let taken = ok(link.client.writeStream(stream, piece[0..n], written + n == total), "the write")?;
            written += taken;
            if (taken < n) {
                break;
            }
        }
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.serverSeen.fin, "the stream's end arrived")?;
    Check.equalU64(total as u64, link.serverSeen.data.length as u64)?;
    let got = link.serverSeen.data.view();
    for (i in 0..got.length) {
        if (got[i] != lossyByte(i)) {
            return Err(TestFailure.create("the bytes, in order"));
        }
    }
    Check.isTrue(link.count > 0, "datagrams were dropped")?;
    return Ok();
}

/// 250 streams on one connection, one after another, each ended by both sides. RFC 9000 §4.6: a peer's stream limit
/// is raised as its streams close, so it may open more than `initial_max_streams_bidi` (100) in a connection's life.
/// Expected: every stream opens (IDs 0, 4, 8 …, §2.1) and every answer arrives.
@test
fn streams_past_the_initial_limit() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var out = [0u8; 1452];
    var rounds = 0;
    while (rounds < 20 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.clientSeen.handshake && link.serverSeen.handshake, "the handshake")?;
    for (k in 0..250) {
        // The stream; while the limit is reached, the rounds carry the MAX_STREAMS that raises it.
        var stream: i64 = -1;
        rounds = 0;
        while (stream < 0 && rounds < 50) {
            match (link.client.openStream()) {
                Ok(s) => { stream = s; }
                Err(QuicError.StreamsBlocked) => {
                    round(mut link, p, buffer.viewMut(), mut out[..])?;
                    rounds += 1;
                }
                Err(_) => { return Err(TestFailure.create("opening a stream")); }
            }
        }
        if (stream < 0) {
            return Err(TestFailure.create("a stream past the limit: still blocked after 50 rounds"));
        }
        Check.isTrue(stream == (k as i64) * 4, "client streams are 0, 4, 8 …")?;
        link.serverSeen.fin = false;
        link.clientSeen.fin = false;
        let _ = ok(link.client.writeStream(stream, "x".bytes(), true), "the request")?;
        rounds = 0;
        while (rounds < 20 && !link.serverSeen.fin) {
            round(mut link, p, buffer.viewMut(), mut out[..])?;
            rounds += 1;
        }
        Check.isTrue(link.serverSeen.fin, "the server received the request's end")?;
        match (borrow mut link.server) {
            Some(s) => { let _ = ok(s.writeStream(stream, "y".bytes(), true), "the answer")?; }
            null => { return Err(TestFailure.create("no server")); }
        }
        rounds = 0;
        while (rounds < 20 && !link.clientSeen.fin) {
            round(mut link, p, buffer.viewMut(), mut out[..])?;
            rounds += 1;
        }
        Check.isTrue(link.clientSeen.fin, "the client received the answer's end")?;
    }
    return Ok();
}

/// With `creditOnConsume`, the server gives credit back only as it consumes (Web ADR 0014 amendment 4 item 2). RFC
/// 9000 §4.1: a sender sends no more than the receiver's limit, here the stream's initial window of 1 MiB
/// (`initial_max_stream_data_bidi_remote`, the shim's `qs_params`). So, before any consumption, the server receives at
/// most 1 MiB of a 3 MiB stream however many rounds pass; once it consumes, the rest arrives.
@test
fn credit_waits_for_consume() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var out = [0u8; 1452];
    var rounds = 0;
    while (rounds < 20 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.clientSeen.handshake && link.serverSeen.handshake, "the handshake")?;
    match (borrow mut link.server) {
        Some(s) => { s.creditOnConsume(); }
        null => { return Err(TestFailure.create("no server")); }
    }
    let total: usize = 3 * 1048576;
    var piece = [0u8; 16384];
    var written: usize = 0;
    let stream = ok(link.client.openStream(), "a stream")?;
    var consumed: usize = 0;
    var consuming = false;
    rounds = 0;
    while (rounds < 20000 && !link.serverSeen.fin) {
        while (written < total) {
            let n: usize = if (total - written < piece.length) total - written else piece.length;
            for (i in 0..n) {
                piece[i] = lossyByte(written + i);
            }
            let taken = ok(link.client.writeStream(stream, piece[0..n], written + n == total), "the write")?;
            written += taken;
            if (taken < n) {
                break;
            }
        }
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
        if (!consuming) {
            Check.isTrue(link.serverSeen.data.length <= 1048576, "no more than the stream's window before consuming")?;
            if (rounds == 300) {
                // Long past what 1 MiB needs on this link: the window is full, and nothing more came.
                Check.equalU64(1048576, link.serverSeen.data.length as u64)?;
                consuming = true;
            }
        }
        if (consuming && link.serverSeen.data.length > consumed) {
            let more = link.serverSeen.data.length - consumed;
            match (borrow mut link.server) {
                Some(s) => { s.consume(stream, more as u64); }
                null => {}
            }
            consumed += more;
        }
    }
    Check.isTrue(link.serverSeen.fin, "the stream's end arrived once the server consumed")?;
    Check.equalU64(total as u64, link.serverSeen.data.length as u64)?;
    let got = link.serverSeen.data.view();
    for (i in 0..got.length) {
        if (got[i] != lossyByte(i)) {
            return Err(TestFailure.create("the bytes, in order"));
        }
    }
    return Ok();
}

/// Unidirectional streams (RFC 9000 §2.1): the client's first is 2 and the server's first is 3, and each carries its
/// bytes to the other side.
@test
fn unidirectional_streams() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var out = [0u8; 1452];
    var rounds = 0;
    while (rounds < 20 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    let up = ok(link.client.openUniStream(), "the client's unidirectional stream")?;
    Check.isTrue(up == 2, "the client's first unidirectional stream is 2")?;
    let _ = ok(link.client.writeStream(up, "control".bytes(), false), "the client's write")?;
    var down: i64 = -1;
    match (borrow mut link.server) {
        Some(s) => {
            down = ok(s.openUniStream(), "the server's unidirectional stream")?;
            let _ = ok(s.writeStream(down, "settings".bytes(), false), "the server's write")?;
        }
        null => { return Err(TestFailure.create("no server")); }
    }
    Check.isTrue(down == 3, "the server's first unidirectional stream is 3")?;
    rounds = 0;
    while (rounds < 20 && (link.serverSeen.data.length < 7 || link.clientSeen.data.length < 8)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.serverSeen.stream == 2, "the server's data came on stream 2")?;
    Check.equalBytes("control".bytes(), link.serverSeen.data.view())?;
    Check.isTrue(link.clientSeen.stream == 3, "the client's data came on stream 3")?;
    Check.equalBytes("settings".bytes(), link.clientSeen.data.view())?;
    return Ok();
}

/// One direction at a time (RFC 9000 §3.1, §3.5): the server resets its sending side, and the client still delivers
/// its bytes on the same stream; the client asks the server to stop sending, and the server is told so. Expected: the
/// codes arrive as sent (7 and 9), and the client's data and FIN arrive after the server's reset.
@test
fn one_direction_reset_and_stop() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var out = [0u8; 1452];
    var rounds = 0;
    while (rounds < 20 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    let first = ok(link.client.openStream(), "a stream")?;
    let _ = ok(link.client.writeStream(first, "a".bytes(), false), "the client's first byte")?;
    rounds = 0;
    while (rounds < 20 && link.serverSeen.data.length < 1) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    match (borrow mut link.server) {
        Some(s) => { ok(s.resetSending(first, 7), "the server's reset of its side")?; }
        null => { return Err(TestFailure.create("no server")); }
    }
    let _ = ok(link.client.writeStream(first, "b".bytes(), true), "the client's last byte")?;
    rounds = 0;
    while (rounds < 20 && !(link.serverSeen.fin && link.clientSeen.resetCode >= 0)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.clientSeen.resetCode == 7, "the client saw RESET_STREAM with code 7")?;
    Check.isTrue(link.serverSeen.fin, "the client's data still arrived after the server's reset")?;
    Check.equalBytes("ab".bytes(), link.serverSeen.data.view())?;
    // The other direction: the client stops reading a second stream; the server hears STOP_SENDING.
    let second = ok(link.client.openStream(), "a second stream")?;
    let _ = ok(link.client.writeStream(second, "c".bytes(), false), "the second stream's byte")?;
    ok(link.client.stopReading(second, 9), "the client's STOP_SENDING")?;
    rounds = 0;
    while (rounds < 20 && link.serverSeen.stopCode < 0) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.isTrue(link.serverSeen.stopCode == 9, "the server saw STOP_SENDING with code 9")?;
    return Ok();
}

/// `QuicTls.serverFromPem` and `clientFromPem` make contexts that complete a handshake with ALPN h3, as `QuicTls.of`'s
/// do; a key that is not PEM is refused with `QuicError.Tls`.
@test
fn contexts_from_pem() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let alpn = [Alpn.Http3];
    let server = ok(QuicTls.serverFromPem(serverPem().bytes(), serverKey().bytes(), alpn[..]), "the server's")?;
    let client = ok(QuicTls.clientFromPem(caPem().bytes(), alpn[..]), "the client's")?;
    Check.isTrue(server.isServer() && !client.isServer(), "each side's")?;
    match (QuicTls.serverFromPem(serverPem().bytes(), "not a key".bytes(), alpn[..])) {
        Err(QuicError.Tls) => {}
        _ => { return Err(TestFailure.create("a key that is not PEM is refused")); }
    }
    let ids = ok(QuicIds.random(), "random IDs")?;
    var c = ok(QuicConnection.client(client, "localhost", clientAddress(), serverAddress(), ids, 1000000000), "client")?;
    var out = [0u8; 1452];
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    let first = match (ok(c.datagram(mut out[..], 1000000000), "the Initial")?) {
        Some(d) => d,
        null => { return Err(TestFailure.create("an Initial")); },
    };
    let sids = ok(QuicIds.random(), "random IDs")?;
    var s = ok(
        QuicConnection.server(server, out[0..first.length], serverAddress(), clientAddress(), sids, 1000000000),
        "the server",
    )?;
    var now: u64 = 1000000000;
    ok(s.feed(clientAddress(), 0, out[0..first.length], now), "the server's read")?;
    var rounds = 0;
    while (rounds < 20 && !(c.handshakeDone() && s.handshakeDone())) {
        loop {
            let d = match (ok(s.datagram(mut out[..], now), "the server's datagram")?) {
                Some(d) => d,
                null => { break; },
            };
            ok(c.feed(serverAddress(), 0, out[0..d.length], now), "the client's read")?;
        }
        loop {
            let d = match (ok(c.datagram(mut out[..], now), "the client's datagram")?) {
                Some(d) => d,
                null => { break; },
            };
            ok(s.feed(clientAddress(), 0, out[0..d.length], now), "the server's read")?;
        }
        while (ok(c.nextEvent(buffer.viewMut()), "an event")?.isSome()) {}
        while (ok(s.nextEvent(buffer.viewMut()), "an event")?.isSome()) {}
        now += 1000000;
        rounds += 1;
    }
    Check.isTrue(c.handshakeDone() && s.handshakeDone(), "the handshake")?;
    match (c.alpn()) {
        Alpn.Http3 => {}
        _ => { return Err(TestFailure.create("ALPN h3")); }
    }
    return Ok();
}

/// Streams are written in the order they were made, whatever the order of the writes (Web ADR 0014 amendment 4
/// item 4): HTTP/3's QPACK encoder stream, made first, then goes out before a request stream whose header block needs
/// its instructions (RFC 9204 §2.1.2). Each datagram carries one stream's data (amendment 1 item 7), so the first
/// datagram after both writes must carry the older stream's bytes, though the newer was written first.
@test
fn older_streams_are_written_first() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    var link = linked(p)?;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var out = [0u8; 1452];
    var rounds = 0;
    while (rounds < 20 && !(link.clientSeen.handshake && link.serverSeen.handshake)) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    let older = ok(link.client.openUniStream(), "a unidirectional stream")?;
    let newer = ok(link.client.openStream(), "a bidirectional stream")?;
    let _ = ok(link.client.writeStream(older, "1".bytes(), false), "the older stream's first byte")?;
    let _ = ok(link.client.writeStream(newer, "2".bytes(), false), "the newer stream's first byte")?;
    rounds = 0;
    while (rounds < 20 && link.serverSeen.data.length < 2) {
        round(mut link, p, buffer.viewMut(), mut out[..])?;
        rounds += 1;
    }
    Check.equalU64(2, link.serverSeen.data.length as u64)?;
    // The newer stream written first, then the older.
    let _ = ok(link.client.writeStream(newer, "b".bytes(), false), "the newer stream's write")?;
    let _ = ok(link.client.writeStream(older, "a".bytes(), false), "the older stream's write")?;
    let first = match (ok(link.client.datagram(mut out[..], link.now), "the next datagram")?) {
        Some(d) => d,
        null => { return Err(TestFailure.create("a datagram")); },
    };
    match (borrow mut link.server) {
        Some(s) => {
            ok(s.feed(clientAddress(), 0, out[0..first.length], link.now), "the server's read")?;
            loop {
                match (ok(s.nextEvent(buffer.viewMut()), "an event")?) {
                    Some(QuicEvent.StreamData(stream, n, _)) => {
                        Check.isTrue(stream == older, "the first data is the older stream's")?;
                        Check.equalBytes("a".bytes(), buffer.view()[0..n])?;
                        return Ok();
                    }
                    Some(_) => {}
                    null => { return Err(TestFailure.create("stream data in the first datagram")); }
                }
            }
        }
        null => { return Err(TestFailure.create("no server")); }
    }
}

/// The client's next Initial at `now`: its datagram's length.
fn firstInitial(c: borrow mut QuicConnection, out: SliceMut<u8>, now: u64) -> Result<usize, TestFailure> {
    match (ok(c.datagram(out, now), "the client's Initial")?) {
        Some(d) => { return Ok(d.length); }
        null => { return Err(TestFailure.create("an Initial")); }
    }
}

/// Address validation with Retry (RFC 9000 §8.1), sans-I/O, as the listener does it. Expected:
///   - required, the client's first Initial gets a Retry (`SendRetry`);
///   - the client's next Initial, with the token, is admitted with the client's first destination ID as the original
///     (`AdmitRetried`, §7.3), and the handshake completes, which ngtcp2 allows only when the server's transport
///     parameters carry that original ID and the Retry's ID (§7.3); the client then sees `retried()`;
///   - the same Initial from another address is dropped: the token is bound to the address (§8.1.4);
///   - not required, a first Initial is admitted as it is, and the client does not see `retried()`.
@test
fn retry_validates_the_address() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "ngtcp2_crypto_ossl_init")?;
    let p = pair()?;
    let key = [5u8; 32];
    let ids = ok(QuicIds.random(), "random IDs")?;
    var client = ok(QuicConnection.client(p.client, "localhost", clientAddress(), serverAddress(), ids, 1000000000), "client")?;
    var out = [0u8; 1452];
    var retry = [0u8; 1452];
    let n = firstInitial(mut client, mut out[..], 1000000000)?;
    let sent = match (QuicRetry.check(key, out[0..n], clientAddress(), true, 1000000000, mut retry[..])) {
        QuicRetryCheck.SendRetry(m) => m,
        _ => { return Err(TestFailure.create("a Retry for the first Initial")); },
    };
    ok(client.feed(serverAddress(), 0, retry[0..sent], 1001000000), "the Retry")?;
    let m = firstInitial(mut client, mut out[..], 1001000000)?;
    // From another address, the token is refused.
    let elsewhere = SocketAddress.V4([127u8, 0, 0, 2], 50000);
    match (QuicRetry.check(key, out[0..m], QuicAddress.of(elsewhere), true, 1002000000, mut retry[..])) {
        QuicRetryCheck.Drop => {}
        _ => { return Err(TestFailure.create("the token is refused from another address")); }
    }
    var original = [0u8; 20];
    var length: usize = 0;
    match (QuicRetry.check(key, out[0..m], clientAddress(), true, 1002000000, mut retry[..])) {
        QuicRetryCheck.AdmitRetried(o, l) => {
            original = o;
            length = l;
        }
        _ => { return Err(TestFailure.create("the token's Initial is admitted")); }
    }
    Check.equalBytes(ids.dcid[..], original[0..length])?;
    let sids = ok(QuicIds.random(), "random IDs")?;
    var server = ok(
        QuicConnection.serverAfterRetry(p.server, out[0..m], serverAddress(), clientAddress(), sids, original[0..length], 1002000000),
        "the server",
    )?;
    ok(server.feed(clientAddress(), 0, out[0..m], 1002000000), "the server's read")?;
    var buffer = Vector<u8>.create();
    if (buffer.resize(quicEventBufferSize(), 0).isErr()) {
        return Err(TestFailure.create("out of memory"));
    }
    var now: u64 = 1003000000;
    var rounds = 0;
    while (rounds < 20 && !(client.handshakeDone() && server.handshakeDone())) {
        loop {
            let d = match (ok(server.datagram(mut out[..], now), "the server's datagram")?) {
                Some(d) => d,
                null => { break; },
            };
            ok(client.feed(serverAddress(), 0, out[0..d.length], now), "the client's read")?;
        }
        loop {
            let d = match (ok(client.datagram(mut out[..], now), "the client's datagram")?) {
                Some(d) => d,
                null => { break; },
            };
            ok(server.feed(clientAddress(), 0, out[0..d.length], now), "the server's read")?;
        }
        while (ok(client.nextEvent(buffer.viewMut()), "an event")?.isSome()) {}
        while (ok(server.nextEvent(buffer.viewMut()), "an event")?.isSome()) {}
        now += 1000000;
        rounds += 1;
    }
    Check.isTrue(client.handshakeDone() && server.handshakeDone(), "the handshake after the Retry")?;
    Check.isTrue(client.retried(), "the client sees the Retry in the server's parameters")?;
    // Not required: admitted as it is.
    let ids2 = ok(QuicIds.random(), "random IDs")?;
    var plain = ok(QuicConnection.client(p.client, "localhost", clientAddress(), serverAddress(), ids2, 1000000000), "client")?;
    let k = firstInitial(mut plain, mut out[..], 1000000000)?;
    match (QuicRetry.check(key, out[0..k], clientAddress(), false, 1000000000, mut retry[..])) {
        QuicRetryCheck.Admit => {}
        _ => { return Err(TestFailure.create("admitted without a Retry when none is required")); }
    }
    return Ok();
}
