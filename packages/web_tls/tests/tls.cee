// web_tls over loopback TCP (Web ADR 0002). Expected outcomes follow from TLS's rules, not from a run: the client
// verifies the server's chain to a trusted root, its validity period and the name (SAN only); a client that rejects
// the server aborts with an alert, which the server reads as one; the server picks its own first ALPN protocol that
// the client offers (RFC 7301 §3.2). OpenSSL 3 on both sides agrees on TLS 1.3 (0x0304, RFC 8446).
import web_core;
import web_transport;

@test
async fn handshake_and_echo() -> Result<void, TestFailure> {
    var s = setup();
    s.serverAlpn = [Alpn.Http11, Alpn.None];
    s.clientAlpn = [Alpn.Http11, Alpn.None];
    s.message = 100000;
    let o = await run(s)?;
    Check.isTrue(isNone(o.server) && isNone(o.client), "no errors")?;
    Check.isTrue(o.echoed, "100000 bytes came back")?;
    Check.isTrue(o.serverSawEnd, "the server read the client's close_notify as the end")?;
    Check.equalU64(0x0304, o.version as u64)?;
    Check.isTrue(isAlpn(o.serverAlpn, Alpn.Http11) && isAlpn(o.clientAlpn, Alpn.Http11), "http/1.1")?;
    return Ok();
}

@test
async fn alpn_is_the_servers_choice() -> Result<void, TestFailure> {
    var s = setup();
    s.serverAlpn = [Alpn.Http2, Alpn.Http11];
    s.clientAlpn = [Alpn.Http11, Alpn.Http2];
    let both = await run(s)?;
    Check.isTrue(isAlpn(both.serverAlpn, Alpn.Http2) && isAlpn(both.clientAlpn, Alpn.Http2), "h2: the server's first")?;
    s.clientAlpn = [Alpn.Http11, Alpn.None];
    let one = await run(s)?;
    Check.isTrue(isAlpn(one.serverAlpn, Alpn.Http11) && isAlpn(one.clientAlpn, Alpn.Http11), "http/1.1")?;
    s.clientAlpn = [Alpn.None, Alpn.None];
    let none = await run(s)?;
    Check.isTrue(isNone(none.server) && isNone(none.client), "no ALPN is no error")?;
    Check.isTrue(isAlpn(none.serverAlpn, Alpn.None) && isAlpn(none.clientAlpn, Alpn.None), "none")?;
    s.serverAlpn = [Alpn.Http11, Alpn.None];
    s.clientAlpn = [Alpn.Http2, Alpn.None];
    let disjoint = await run(s)?;
    Check.isTrue(isNone(disjoint.server) && isNone(disjoint.client), "no overlap: the server goes on without ALPN")?;
    Check.isTrue(isAlpn(disjoint.clientAlpn, Alpn.None), "none agreed")?;
    return Ok();
}

@test
async fn an_ip_address_is_checked_against_the_san() -> Result<void, TestFailure> {
    var s = setup();
    s.host = Host.Loopback;
    let ok = await run(s)?;
    Check.isTrue(isNone(ok.server) && isNone(ok.client), "127.0.0.1 is in the SAN")?;
    s.host = Host.OtherLoopback;
    let other = await run(s)?;
    Check.isTrue(isTls(other.client, TlsReason.Certificate), "127.0.0.2 is not")?;
    return Ok();
}

/// Every certificate the client must refuse: it fails with `Certificate`, and the server reads its alert.
@test
async fn bad_certificates_fail_closed() -> Result<void, TestFailure> {
    await refused(Cert.Server, Trust.OtherCa, Host.Localhost, "an untrusted root")?;
    await refused(Cert.Stranger, Trust.Ca, Host.Localhost, "an unknown CA")?;
    await refused(Cert.WrongHost, Trust.Ca, Host.Localhost, "the wrong host")?;
    await refused(Cert.Expired, Trust.Ca, Host.Localhost, "expired")?;
    await refused(Cert.Future, Trust.Ca, Host.Localhost, "not yet valid")?;
    await refused(Cert.Server, Trust.Ca, Host.LocalDomain, "a name not in the SAN")?;
    return Ok();
}

async fn refused(cert: Cert, trust: Trust, host: Host, what: StringView) -> Result<void, TestFailure> {
    var s = setup();
    s.cert = cert;
    s.trust = trust;
    s.host = host;
    s.message = 10;
    let o = await run(s)?;
    Check.isTrue(isTls(o.client, TlsReason.Certificate), what)?;
    Check.isTrue(isTls(o.server, TlsReason.Alert), what)?;
    Check.isTrue(!o.echoed, what)?;
    return Ok();
}

@test
async fn a_silent_client_hits_the_handshake_deadline() -> Result<void, TestFailure> {
    var s = setup();
    s.silentClient = true;
    s.serverDeadlineMs = 200;
    let started = Timer.now();
    let o = await run(s)?;
    let isTimeout = match (o.server) {
        Some(NetError.TimedOut) => true,
        _ => false,
    };
    Check.isTrue(isTimeout, "TimedOut")?;
    Check.isTrue(Timer.now() - started < 3000, "at the deadline, not later")?;
    return Ok();
}

@test
async fn plaintext_is_not_a_handshake() -> Result<void, TestFailure> {
    var s = setup();
    s.plaintextClient = true;
    let o = await run(s)?;
    Check.isTrue(isTls(o.server, TlsReason.Handshake), "an HTTP request where a ClientHello belongs")?;
    return Ok();
}

@test
fn bad_configurations() -> Result<void, TestFailure> {
    let mismatched = match (TlsConfig.server(serverPem().bytes(), clientKey().bytes())) {
        Err(TlsSetupError.BadCertificate) => true,
        _ => false,
    };
    Check.isTrue(mismatched, "a key that is not the certificate's")?;
    let garbage = match (TlsConfig.server("not a certificate".bytes(), serverKey().bytes())) {
        Err(TlsSetupError.BadCertificate) => true,
        _ => false,
    };
    Check.isTrue(garbage, "no certificate")?;
    var c = setupOk(TlsConfig.client())?;
    let noTrust = match (c.trustPem("nothing here".bytes())) {
        Err(TlsSetupError.BadTrust) => true,
        _ => false,
    };
    Check.isTrue(noTrust, "no root in the PEM")?;
    let notServer = match (TlsAcceptor.create(c)) {
        Err(_) => true,
        Ok(_) => false,
    };
    Check.isTrue(notServer, "an acceptor needs a server configuration")?;
    var version = [0u8; 64];
    let n = opensslVersion(mut version[..]);
    Check.isTrue(n > 8 && version[0] == 79, "OpenSSL's version text")?; // "OpenSSL …"
    return Ok();
}
