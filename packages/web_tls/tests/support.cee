// Helpers for web_tls's tests: a TLS server and client in one process over loopback TCP, each in its own task. The
// certificates are tests/certs.cee's, generated by tools/make_test_certs.py and checked with `openssl verify`.
import web_core;
import web_transport;

/// The server's certificate (tools/make_test_certs.py).
enum Cert {
    Server,
    Stranger,
    WrongHost,
    Expired,
    Future,
    BadSignature,
}

/// A client that does not speak TLS properly; it records the first byte the server sends back (a TLS alert record
/// is 0x15), or 0 if the server sends nothing before closing.
enum Raw {
    /// It speaks TLS.
    No,
    /// Connects, sends nothing, waits.
    Silent,
    /// An HTTP request where a ClientHello belongs.
    Plaintext,
    /// The header of a 512-byte handshake record and 50 bytes of it, then the end of its writing.
    Truncated,
    /// A handshake record header claiming 18 433 bytes: past TLS's 2^14 + 2048 (RFC 8446 §5.1, §5.2).
    Oversized,
}

/// The root the client trusts.
enum Trust {
    Ca,
    OtherCa,
}

/// The name the client connects to.
enum Host {
    Localhost,
    Loopback,
    OtherLoopback,
    LocalDomain,
}

fn chainOf(c: Cert) -> StringView => match (c) {
    Cert.Server => serverPem(),
    Cert.Stranger => strangerPem(),
    Cert.WrongHost => wronghostPem(),
    Cert.Expired => expiredPem(),
    Cert.Future => futurePem(),
    Cert.BadSignature => badsigPem(),
};

fn keyOf(c: Cert) -> StringView => match (c) {
    Cert.Server => serverKey(),
    Cert.Stranger => strangerKey(),
    Cert.WrongHost => wronghostKey(),
    Cert.Expired => expiredKey(),
    Cert.Future => futureKey(),
    Cert.BadSignature => badsigKey(),
};

fn trustOf(t: Trust) -> StringView => match (t) {
    Trust.Ca => caPem(),
    Trust.OtherCa => otherCaPem(),
};

fn nameOf(h: Host) -> StringView => match (h) {
    Host.Localhost => "localhost",
    Host.Loopback => "127.0.0.1",
    Host.OtherLoopback => "127.0.0.2",
    Host.LocalDomain => "localhost.localdomain",
};

/// One handshake (and optionally an exchange) between a server and a client.
struct Setup {
    cert: Cert;
    trust: Trust;
    host: Host;
    serverAlpn: [Alpn; 2];
    clientAlpn: [Alpn; 2];
    /// Bytes the client sends after the handshake (the server echoes them), then it closes.
    message: usize;
    /// The server's handshake deadline, in ms.
    serverDeadlineMs: u64;
    /// A client that does not speak TLS.
    raw: Raw;
}

fn setup() -> Setup => Setup {
    cert: Cert.Server,
    trust: Trust.Ca,
    host: Host.Localhost,
    serverAlpn: [Alpn.None, Alpn.None],
    clientAlpn: [Alpn.None, Alpn.None],
    message: 0,
    serverDeadlineMs: 5000,
    raw: Raw.No,
};

/// What each side saw.
struct Outcome {
    server: NetError?;
    client: NetError?;
    serverAlpn: Alpn;
    clientAlpn: Alpn;
    version: u32;
    /// The client got back exactly what it sent.
    echoed: bool;
    /// The server saw the client's close_notify (a read of 0) after the message.
    serverSawEnd: bool;
    /// A raw client's first byte back.
    firstBack: u8;
}

/// Runs `s`: a server task accepting one connection, and a client task.
async fn run(s: borrow Setup) -> Result<Outcome, TestFailure> {
    var serverConfig = setupOk(TlsConfig.server(chainOf(s.cert).bytes(), keyOf(s.cert).bytes()))?;
    setupDone(serverConfig.setAlpn(s.serverAlpn[..]))?;
    var clientConfig = setupOk(TlsConfig.client())?;
    setupDone(clientConfig.trustPem(trustOf(s.trust).bytes()))?;
    setupDone(clientConfig.setAlpn(s.clientAlpn[..]))?;
    let listener = net(Listener.bind("127.0.0.1", 0))?;
    let port = net(listener.port())?;
    var out = Outcome {
        server: null,
        client: null,
        serverAlpn: Alpn.None,
        clientAlpn: Alpn.None,
        version: 0,
        echoed: false,
        serverSawEnd: false,
        firstBack: 0,
    };
    var serverError: NetError? = null;
    var clientError: NetError? = null;
    var serverAlpn = Alpn.None;
    var clientAlpn = Alpn.None;
    var version: u32 = 0;
    var echoed = false;
    var sawEnd = false;
    var firstBack: u8 = 0;
    let r: Result<void, NetError> = await Async.scope(NetError.OutOfMemory, (sc) => {
        sc.spawn(async () => {
            match (await serve(listener, serverConfig, Deadline.after(s.serverDeadlineMs), mut serverAlpn, mut sawEnd)) {
                Ok() => {}
                Err(e) => { serverError = Some(e); }
            }
            return Ok();
        });
        sc.spawn(async () => {
            match (await client(port, clientConfig, s, mut clientAlpn, mut version, mut echoed, mut firstBack)) {
                Ok() => {}
                Err(e) => { clientError = Some(e); }
            }
            return Ok();
        });
    });
    match (r) {
        Ok() => {}
        Err(e) => { return Err(TestFailure.create(NetErrors.describe(e))); }
    }
    out.server = serverError;
    out.client = clientError;
    out.serverAlpn = serverAlpn;
    out.clientAlpn = clientAlpn;
    out.version = version;
    out.echoed = echoed;
    out.serverSawEnd = sawEnd;
    out.firstBack = firstBack;
    return Ok(out);
}

/// A read bounded by 10 s, as every read of a real client or server is. A peer that closes abortively right after
/// sending can leave this end never told: on macOS's loopback the reset can be handled before the data just ahead of
/// it, is then out of sequence and dropped (RFC 5961), and the closed peer never sends it again (captured with tcpdump,
/// 2026-11-03; Web ADR 0002 amendment 5.6). Without a bound, such a test waits for ever instead of failing.
async fn bounded(t: borrow mut TlsTransport, buf: SliceMut<u8>) -> Result<usize, NetError> =>
    await Async.deadline(Deadline.after(10000).instant(), NetError.TimedOut, async () => await t.read(buf));

/// Accepts one connection, handshakes, then echoes until the client's end.
async fn serve(
    listener: borrow Listener,
    config: borrow TlsConfig,
    deadline: Deadline,
    alpn: borrow mut Alpn,
    sawEnd: borrow mut bool,
) -> Result<void, NetError> {
    let stream = await listener.accept()?;
    var t = await TlsTransport.accept(stream, config, deadline)?;
    alpn = t.alpn();
    var buf = [0u8; 4096];
    loop {
        let n = await bounded(mut t, mut buf[..])?;
        if (n == 0) {
            sawEnd = true;
            return Ok();
        }
        await t.write(buf[0..n])?;
    }
}

/// Connects, handshakes, sends `s.message` bytes of a pattern, reads them back, then closes.
async fn client(
    port: u16,
    config: borrow TlsConfig,
    s: borrow Setup,
    alpn: borrow mut Alpn,
    version: borrow mut u32,
    echoed: borrow mut bool,
    firstBack: borrow mut u8,
) -> Result<void, NetError> {
    var tcp = PlainStream.tcp(await TcpTransport.connect("127.0.0.1", port)?);
    match (s.raw) {
        Raw.No => {}
        _ => {
            await rawClient(mut tcp, s.raw)?;
            var back = [0u8; 64];
            let n = await tcp.read(mut back[..])?; // what the server sends before it closes, if anything
            firstBack = if (n > 0) back[0] else 0;
            return Ok();
        }
    }
    var t = await TlsTransport.connect(tcp, config, nameOf(s.host), Deadline.after(5000))?;
    alpn = t.alpn();
    version = t.version();
    var sent = Vector<u8>.create();
    for (i in 0..s.message) {
        match (sent.push(truncate<u8>(i * 7 + i / 251))) {
            Ok() => {}
            Err(_) => { return Err(NetError.OutOfMemory); }
        }
    }
    var back = Vector<u8>.create();
    var at: usize = 0;
    while (at < s.message) {
        var end = at + 20000;
        if (end > s.message) {
            end = s.message;
        }
        let chunk = sent.view();
        await t.write(chunk[at..end])?;
        at = end;
        // Read what came back so far, so neither side's buffers fill.
        var buf = [0u8; 4096];
        while (back.length < at) {
            let n = await bounded(mut t, mut buf[..])?;
            if (n == 0) {
                return Err(NetError.Closed);
            }
            for (i in 0..n) {
                match (back.push(buf[i])) {
                    Ok() => {}
                    Err(_) => { return Err(NetError.OutOfMemory); }
                }
            }
        }
    }
    var same = back.length == sent.length;
    for (i in 0..back.length) {
        if (!same) {
            break;
        }
        same = back[i] == sent[i];
    }
    echoed = same;
    await t.shutdownWrite()?;
    var buf = [0u8; 16];
    let last = await bounded(mut t, mut buf[..])?; // the server's end, once it has seen ours
    return Ok();
}

/// Sends what a raw client sends.
async fn rawClient(tcp: borrow mut PlainStream, raw: Raw) -> Result<void, NetError> {
    match (raw) {
        Raw.Plaintext => { await tcp.write("GET / HTTP/1.1\r\nhost: localhost\r\n\r\n".bytes())?; }
        Raw.Truncated => {
            // A handshake record (22), TLS 1.0 in the record layer, 512 bytes long; then 50 of them: a ClientHello
            // (1) of 508 bytes, cut short.
            var bytes = [0u8; 55];
            bytes[0] = 22;
            bytes[1] = 3;
            bytes[2] = 1;
            bytes[3] = 2;
            bytes[4] = 0;
            bytes[5] = 1;
            bytes[6] = 0;
            bytes[7] = 1;
            bytes[8] = 252;
            bytes[9] = 3;
            bytes[10] = 3;
            await tcp.write(bytes[..])?;
            await tcp.shutdownWrite()?;
        }
        Raw.Oversized => {
            var header = [22u8, 3, 1, 0x48, 0x01];
            await tcp.write(header[..])?;
        }
        _ => {}
    }
    return Ok();
}

fn setupOk<T>(r: Result<T, TlsSetupError>) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create("a TLS setup error")); }
    }
}

fn setupDone(r: Result<void, TlsSetupError>) -> Result<void, TestFailure> {
    match (r) {
        Ok() => { return Ok(); }
        Err(_) => { return Err(TestFailure.create("a TLS setup error")); }
    }
}

fn net<T>(r: Result<T, NetError>) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(e) => { return Err(TestFailure.create(NetErrors.describe(e))); }
    }
}

/// Whether `e` is a TLS failure for `reason`.
fn isTls(e: NetError?, reason: TlsReason) -> bool {
    let got = match (e) {
        Some(NetError.Tls(r)) => r,
        _ => { return false; },
    };
    return reasonCode(got) == reasonCode(reason);
}

fn isNone(e: NetError?) -> bool => match (e) {
    Some(_) => false,
    null => true,
};

fn isAlpn(a: Alpn, b: Alpn) -> bool => match (a) {
    Alpn.None => match (b) {
        Alpn.None => true,
        _ => false,
    },
    Alpn.Http11 => match (b) {
        Alpn.Http11 => true,
        _ => false,
    },
    Alpn.Http2 => match (b) {
        Alpn.Http2 => true,
        _ => false,
    },
    _ => false,
};

fn reasonCode(r: TlsReason) -> u32 => match (r) {
    TlsReason.Handshake => 1,
    TlsReason.Certificate => 2,
    TlsReason.Protocol => 3,
    TlsReason.Alert => 4,
    TlsReason.Internal => 5,
};
