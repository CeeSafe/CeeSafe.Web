// The HTTP/1.1 connection driver (Web ADR 0004 §3.2; implementation plan §7, M2 task 4): read a head, parse it in
// place, run the application, finish the response and the body, and go on while the connection is kept alive.
//
// Buffers, kept for the connection's life: two head buffers that swap roles (the request's views borrow one while the
// bytes after its head, a body prefix or pipelined requests, wait in the other), the write buffer `out` and the
// response buffer `pending`. What an idle connection holds is mostly these (Web ADR 0015 §6), so the head buffers are
// made only as large as the requests need:
// - `a` starts at `FIRST_HEAD_BYTES`, and is reserved up to `maxHeadBytes` only for a head that does not fit;
// - `b` starts empty. It takes `maxHeadBytes` only when bytes follow a head, or when the exchange reads a body or a
//   peer's close into it (`Exchange`'s `carry`). The two swap only when `b` holds the next request's start.
// A connection keeps what it reserved, so a keep-alive request still allocates nothing once its buffers exist.
//
// Pipelining is sequential with coalescing: a finished response stays in `out` while another complete request is
// already buffered, so a burst of pipelined requests is answered with one write. `out` is sent when no complete
// request is buffered, when it is full, before waiting to read, and after a streamed response.
import web_core;
import web_http;

/// Serves HTTP/1.1 on `conn` until the client closes or asks to, a protocol error, a timeout, or the server's drain
/// (an idle connection closes at once; one in a request finishes it first). A peer's reset or a failed write is
/// `Err`; every other end is `Ok`.
public async fn serve(
    conn: borrow mut dyn Transport,
    connection: borrow ConnectionContext,
    app: borrow dyn Application,
    limits: borrow Limits,
) -> Result<void, NetError> =>
    await serveFrom(conn, connection, app, limits, "".bytes());

/// `serve`, for a connection whose first bytes, `already`, were read to choose the protocol (Web ADR 0011 §3.2: a
/// cleartext connection that does not start with HTTP/2's preface): they are the start of the first request.
public async fn serveFrom(
    conn: borrow mut dyn Transport,
    connection: borrow ConnectionContext,
    app: borrow dyn Application,
    limits: borrow Limits,
    already: Slice<u8>,
) -> Result<void, NetError> {
    let first = if (limits.maxHeadBytes < FIRST_HEAD_BYTES || already.length > FIRST_HEAD_BYTES) limits.maxHeadBytes
        else FIRST_HEAD_BYTES;
    var a = buffer(first)?;
    a.append(already)?;
    var b = buffer(0)?;
    var out = buffer(limits.writeBufferBytes)?;
    var pending = buffer(limits.writeBufferBytes)?;
    var date = DateCache.create(limits.sendDate);
    var response = match (ResponseHead.create(4096)) {
        Ok(h) => h,
        Err(_) => { return Err(NetError.OutOfMemory); },
    };
    loop {
        let span = await nextHead(
            conn,
            connection,
            limits,
            mut a,
            mut out,
            mut response,
            mut date,
        )? ?? { return Ok(); };
        let keep = await exchangeOne(
            conn,
            connection,
            app,
            limits,
            a,
            span.start,
            span.end,
            mut b,
            mut out,
            mut pending,
            mut response,
            mut date,
        )?;
        if (!keep) {
            match (await flush(conn, mut out, limits)) {
                Ok() => {}
                Err(_) => {} // closing anyway
            }
            return Ok();
        }
        a.clear();
        if (!b.isEmpty()) {
            // The bytes after this head, in `b`, start the next request.
            let t = a;
            a = b;
            b = t;
        }
    }
}

/// Where a complete head lies in `a`.
struct HeadSpan {
    start: usize;
    end: usize;
}

/// Reads until `a` holds a complete head, and returns where it lies; null when the connection ends instead (the client
/// closed or idled out, the drain, or a head that cannot be read, which is answered here). A peer's reset or a failed
/// write is `Err`.
async fn nextHead(
    conn: borrow mut dyn Transport,
    connection: borrow ConnectionContext,
    limits: borrow Limits,
    a: borrow mut OwnedBuffer,
    out: borrow mut OwnedBuffer,
    response: borrow mut ResponseHead,
    date: borrow mut DateCache,
) -> Result<HeadSpan?, NetError> {
    var scanner = HeadScanner.create();
    // A head already begun (bytes read to choose the protocol, or a pipelined request's start) is held to the header
    // timeout from now; one not begun, from its first byte (below).
    var headDeadline = if (a.isEmpty()) Deadline.never() else Deadline.after(limits.headerTimeoutMs);
    loop {
        match (scanner.scan(a.readable(), limits)) {
            Ok(true) => { break; }
            Ok(false) => {}
            Err(e) => {
                await reject(conn, out, response, date, ProtocolErrors.status(e), limits);
                return Ok(null);
            }
        }
        // Nothing complete is buffered: send what is waiting before waiting for more.
        await flush(conn, out, limits)?;
        a.compact();
        if (a.spareLength() == 0) {
            if (a.capacity() >= limits.maxHeadBytes) {
                await reject(conn, out, response, date, Status.headerFieldsTooLarge(), limits);
                return Ok(null);
            }
            // A head longer than the first buffer: room for the longest allowed (the scanner checks the limit).
            match (a.reserve(limits.maxHeadBytes)) {
                Ok() => {}
                Err(_) => { return Err(NetError.OutOfMemory); }
            }
        }
        let idle = a.isEmpty();
        var n: usize = 0;
        if (idle && connection.isDraining()) {
            // The server drains (Web ADR 0019): the next request, if it comes within the linger, is served, and its
            // response says `connection: close` (`keep` is false while draining); else the connection closes. A
            // client that had just sent on it is answered rather than left to send it again on a new connection.
            if (limits.drainLingerMs == 0) {
                return Ok(null);
            }
            let linger = if (limits.drainLingerMs < limits.idleTimeoutMs) limits.drainLingerMs else limits.idleTimeoutMs;
            match (await Transports.readWithin(conn, a.spare(), Deadline.after(linger))) {
                Ok(v) => { n = v; }
                Err(NetError.TimedOut) => { return Ok(null); }
                Err(e) => { return Err(e); }
            }
        } else if (idle) {
            let d = Deadline.after(limits.idleTimeoutMs);
            let r: Result<Raced<usize>, NetError> = await Async.race(
                async () => await Transports.readWithin(conn, a.spare(), d),
                async () => await drainStarted<usize>(connection.drain()),
            );
            match (r) {
                Ok(raced) => { n = raced.value; }
                Err(NetError.TimedOut) => { return Ok(null); } // idle too long
                Err(NetError.Cancelled) => {
                    if (connection.isDraining()) {
                        continue; // the drain began while it waited: wait on within the linger, above
                    }
                    return Err(NetError.Cancelled);
                }
                Err(e) => { return Err(e); }
            }
        } else {
            match (await Transports.readWithin(conn, a.spare(), headDeadline)) {
                Ok(v) => { n = v; }
                Err(NetError.TimedOut) => {
                    await reject(conn, out, response, date, Status.requestTimeout(), limits);
                    return Ok(null);
                }
                Err(e) => { return Err(e); }
            }
        }
        if (n == 0) {
            return Ok(null); // the client closed, between requests or within a head
        }
        if (idle) {
            headDeadline = Deadline.after(limits.headerTimeoutMs);
        }
        match (a.commit(n)) {
            Ok() => {}
            Err(e) => { return Err(e); }
        }
    }
    return Ok(Some(HeadSpan { start: scanner.start(), end: scanner.end() }));
}

/// The head buffer a connection starts with: most requests' heads fit in it (a browser's are typically under 2 KiB).
const FIRST_HEAD_BYTES: usize = 4096;

/// One request: parse the head `a[start..end]`, run the application, finish. True to keep the connection.
async fn exchangeOne(
    conn: borrow mut dyn Transport,
    connection: borrow ConnectionContext,
    app: borrow dyn Application,
    limits: borrow Limits,
    a: borrow OwnedBuffer,
    start: usize,
    end: usize,
    b: borrow mut OwnedBuffer,
    out: borrow mut OwnedBuffer,
    pending: borrow mut OwnedBuffer,
    response: borrow mut ResponseHead,
    date: borrow mut DateCache,
) -> Result<bool, NetError> {
    let input = a.readable();
    let head = match (parseHead(input, start, end, limits)) {
        Ok(h) => h,
        Err(e) => {
            await reject(conn, out, response, date, ProtocolErrors.status(e), limits);
            return Ok(false);
        },
    };
    b.clear();
    if (end < input.length && b.capacity() < limits.maxHeadBytes) {
        match (b.reserve(limits.maxHeadBytes)) {
            Ok() => {}
            Err(_) => { return Err(NetError.OutOfMemory); }
        }
    }
    b.append(input[end..])?;
    var noStream = NoStream {};
    var ex = Exchange.create(
        conn,
        mut noStream,
        b,
        out,
        pending,
        response,
        app,
        head.request,
        limits,
        date,
        head.framing,
        head.expectContinue,
        head.keepAlive && !connection.isDraining(),
    );
    var failed: HandlerError? = null;
    match (await app.handle(head.request, mut ex, connection)) {
        Ok() => {
            match (await ex.finish()) {
                Ok() => {}
                Err(e) => { failed = Some(e); }
            }
        }
        Err(e) => { failed = Some(e); }
    }
    match (failed) {
        Some(HandlerError.Status(s)) => {
            if (!(await ex.respondError(s, false))) {
                return Ok(false);
            }
        }
        Some(HandlerError.Internal) => {
            if (!(await ex.respondError(Status.internalServerError(), true))) {
                return Ok(false);
            }
        }
        Some(HandlerError.Io(_)) => { return Ok(false); } // the connection is broken: nothing more can be sent
        null => {}
    }
    await ex.finishBody();
    let keep = ex.keepAlive();
    let streamed = ex.streamed();
    // Coalescing: keep `out` while a complete request waits in `b`; send it otherwise.
    var nextReady = false;
    if (keep && !streamed) {
        var s = HeadScanner.create();
        nextReady = match (s.scan(b.readable(), limits)) {
            Ok(true) => true,
            _ => false,
        };
    }
    if (!nextReady) {
        await flush(conn, out, limits)?;
    }
    return Ok(keep);
}

/// Sends `status` with no content and `Connection: close`, for a request that cannot be read.
async fn reject(
    conn: borrow mut dyn Transport,
    out: borrow mut OwnedBuffer,
    response: borrow mut ResponseHead,
    date: borrow mut DateCache,
    status: StatusCode,
    limits: borrow Limits,
) {
    response.reset();
    response.setStatus(status);
    date.refresh();
    match (Encoder.head(response, ResponseFraming.Length(0), false, date.bytes(), out)) {
        Ok() => {}
        Err(_) => {
            // No room beside the responses still waiting in `out`: send them first, then this one.
            match (await flush(conn, out, limits)) {
                Ok() => {}
                Err(_) => { return; }
            }
            match (Encoder.head(response, ResponseFraming.Length(0), false, date.bytes(), out)) {
                Ok() => {}
                Err(_) => { return; }
            }
        }
    }
    match (await flush(conn, out, limits)) {
        Ok() => {}
        Err(_) => {}
    }
}

/// Writes `out` and empties it.
async fn flush(
    conn: borrow mut dyn Transport,
    out: borrow mut OwnedBuffer,
    limits: borrow Limits,
) -> Result<void, NetError> {
    if (out.isEmpty()) {
        return Ok();
    }
    await Transports.writeWithin(conn, out.readable(), Deadline.after(limits.writeTimeoutMs))?;
    out.clear();
    return Ok();
}

fn buffer(n: usize) -> Result<OwnedBuffer, NetError> {
    match (OwnedBuffer.create(n)) {
        Ok(b) => { return Ok(b); }
        Err(_) => { return Err(NetError.OutOfMemory); }
    }
}
