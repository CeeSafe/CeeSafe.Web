// The HTTP/1.1 driver over a scripted transport (implementation plan §7, M2 task 4 and its exit tests). Every
// expected byte string is written out by hand from RFC 9112 and the test application's rules (driver_support.cee).
import web_core;
import web_http;

/// The response the test application gives a request for `path` with `body`: `<path>:<body>`.
fn echoed(path: StringView, body: StringView, out: borrow mut Vector<u8>) -> Result<void, TestFailure> {
    let n = path.bytes().length + 1 + body.bytes().length;
    var digits = [0u8; 8];
    var k: usize = 8;
    var v = n;
    loop {
        k -= 1;
        digits[k] = truncate<u8>(48 + v % 10);
        v /= 10;
        if (v == 0) {
            break;
        }
    }
    let ok = pushText(out, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: ") && pushBytes(out, digits[k..]) &&
        pushText(out, "\r\n\r\n") && pushText(out, path) && pushText(out, ":") && pushText(out, body);
    return if (ok) Ok() else Err(TestFailure.create("expected bytes"));
}

fn pushText(out: borrow mut Vector<u8>, s: StringView) -> bool => pushBytes(out, s.bytes());

fn pushBytes(out: borrow mut Vector<u8>, s: Slice<u8>) -> bool {
    for (b in s) {
        match (out.push(b)) {
            Ok() => {}
            Err(_) => { return false; }
        }
    }
    return true;
}

@test
async fn one_get() -> Result<void, TestFailure> {
    let s = await run("GET /a HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 3\r\n\r\n/a:", s.output)?;
    Check.equalU64(1, s.writes.length as u64)?;
    return Ok();
}

@test
async fn pipelined_requests_coalesce_and_keep_their_own_heads() -> Result<void, TestFailure> {
    let text = "GET /a HTTP/1.1\r\nHost: x\r\nX-A: 1\r\n\r\nPOST /b HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\n\r\nxyzGET /c HTTP/1.1\r\nHost: x\r\n\r\n";
    var expected = Vector<u8>.create();
    echoed("/a", "", mut expected)?;
    echoed("/b", "xyz", mut expected)?;
    echoed("/c", "", mut expected)?;
    let whole = await run(text, 4096, quiet())?;
    Check.equalBytes(expected.view(), whole.output.view())?;
    Check.equalU64(1, whole.writes.length as u64)?; // all three in one write
    let trickle = await run(text, 1, quiet())?;
    Check.equalBytes(expected.view(), trickle.output.view())?; // one byte per read: the same bytes
    return Ok();
}

@test
async fn a_hundred_pipelined_in_order() -> Result<void, TestFailure> {
    var input = Vector<u8>.create();
    var expected = Vector<u8>.create();
    for (i in 0..100) {
        var name = [47u8, 48, 48];
        name[1] = truncate<u8>(48 + i / 10);
        name[2] = truncate<u8>(48 + i % 10);
        let path = match (StringView.fromUtf8(name[..])) {
            Some(p) => p,
            null => { return Err(TestFailure.create("path")); },
        };
        Check.isTrue(pushText(mut input, "GET ") && pushText(mut input, path) &&
            pushText(mut input, " HTTP/1.1\r\nHost: x\r\n\r\n"), "input")?;
        echoed(path, "", mut expected)?;
    }
    let text = match (StringView.fromUtf8(input.view())) {
        Some(t) => t,
        null => { return Err(TestFailure.create("text")); },
    };
    let s = await run(text, 65536, quiet())?;
    Check.equalBytes(expected.view(), s.output.view())?;
    Check.equalU64(1, s.writes.length as u64)?; // 100 responses of 50 bytes fit one 16 KiB write
    return Ok();
}

@test
async fn sixteen_coalesce_and_a_stream_flushes_first() -> Result<void, TestFailure> {
    var input = Vector<u8>.create();
    for (i in 0..16) {
        Check.isTrue(pushText(mut input, "GET /p HTTP/1.1\r\nHost: x\r\n\r\n"), "input")?;
    }
    let plain = match (StringView.fromUtf8(input.view())) {
        Some(t) => t,
        null => { return Err(TestFailure.create("text")); },
    };
    let s = await run(plain, 65536, quiet())?;
    Check.equalU64(1, s.writes.length as u64)?; // 16 pipelined requests, one flush

    // The 8th request streams: everything before it and its first chunk go at its flush; the rest of it when it
    // ends, before the 9th is handled; the last 8 together at the end.
    var mixed = Vector<u8>.create();
    var expected = Vector<u8>.create();
    for (i in 0..16) {
        if (i == 7) {
            Check.isTrue(pushText(mut mixed, "GET /stream HTTP/1.1\r\nHost: x\r\n\r\n"), "input")?;
            Check.isTrue(pushText(mut expected,
                "HTTP/1.1 200 OK\r\nx-hook: 1\r\ntransfer-encoding: chunked\r\n\r\n5\r\npart1\r\n5\r\npart2\r\n0\r\n\r\n"), "e")?;
        } else {
            Check.isTrue(pushText(mut mixed, "GET /p HTTP/1.1\r\nHost: x\r\n\r\n"), "input")?;
            echoed("/p", "", mut expected)?;
        }
    }
    let text = match (StringView.fromUtf8(mixed.view())) {
        Some(t) => t,
        null => { return Err(TestFailure.create("text")); },
    };
    let m = await run(text, 65536, quiet())?;
    Check.equalBytes(expected.view(), m.output.view())?;
    Check.equalU64(3, m.writes.length as u64)?;
    // Write 2 is the stream's remainder: "5\r\npart2\r\n0\r\n\r\n", 15 bytes, ending the response.
    Check.equalU64(15, m.writes[1] as u64)?;
    return Ok();
}

@test
async fn bodies_by_length_and_chunked_at_every_read_size() -> Result<void, TestFailure> {
    let text = "POST /l HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloPOST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2;e=1\r\nde\r\n0\r\nT: 1\r\n\r\n";
    var expected = Vector<u8>.create();
    echoed("/l", "hello", mut expected)?;
    echoed("/c", "abcde", mut expected)?;
    for (step in 1..12usize) {
        let s = await run(text, step, quiet())?;
        Check.equalBytes(expected.view(), s.output.view())?;
    }
    return Ok();
}

/// A chunked request's trailer fields reach the handler once it has read the body (RFC 9112 §7.1.2), at every read
/// size: names lowercased, values trimmed.
@test
async fn request_trailers_reach_the_handler() -> Result<void, TestFailure> {
    let text = "POST /trailers HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\nT: 1\r\nx-b:  two \r\n\r\n";
    var expected = Vector<u8>.create();
    echoed("/trailers", "t=1;x-b=two;", mut expected)?;
    for (step in 1..12usize) {
        let s = await run(text, step, quiet())?;
        Check.equalBytes(expected.view(), s.output.view())?;
    }
    return Ok();
}

/// A streamed response's trailers go in its last chunk (RFC 9112 §7.1.2).
@test
async fn response_trailers_in_the_last_chunk() -> Result<void, TestFailure> {
    let s = await run("GET /stream-trailers HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    return same(
        "HTTP/1.1 200 OK\r\nx-hook: 1\r\ntransfer-encoding: chunked\r\n\r\n5\r\npart1\r\n5\r\npart2\r\n0\r\nx-sum: 10\r\n\r\n",
        s.output,
    );
}

/// A response never flushed, with trailers, is chunked too (RFC 9112 §7.1.2): a declared length would leave the
/// trailers nowhere to go. Without trailers it gets its length; HEAD gets neither body nor trailers.
@test
async fn whole_response_trailers_need_chunks() -> Result<void, TestFailure> {
    let s = await run("GET /whole-trailers HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ntransfer-encoding: chunked\r\n\r\n5\r\nwhole\r\n0\r\nx-sum: 5\r\n\r\n", s.output)?;
    let h = await run("HEAD /whole-trailers HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    return same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 5\r\n\r\n", h.output);
}

@test
async fn expect_100_continue() -> Result<void, TestFailure> {
    let read = await run("POST /e HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 2\r\n\r\nhi", 4096,
        quiet())?;
    same("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 5\r\n\r\n/e:hi", read.output)?;
    // A handler that never reads: no 100, and the connection closes (the client may or may not send the body).
    let unread = await run(
        "POST /ignore HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 2\r\n\r\nhiGET /a HTTP/1.1\r\nHost: x\r\n\r\n",
        4096,
        quiet(),
    )?;
    same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 2\r\nconnection: close\r\n\r\nok", unread.output)?;
    return Ok();
}

@test
async fn unread_bodies_are_drained_or_close() -> Result<void, TestFailure> {
    let text = "POST /ignore HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\n0123456789GET /a HTTP/1.1\r\nHost: x\r\n\r\n";
    var expected = Vector<u8>.create();
    Check.isTrue(pushText(mut expected, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 2\r\n\r\nok"), "e")?;
    echoed("/a", "", mut expected)?;
    let drained = await run(text, 4096, quiet())?;
    Check.equalBytes(expected.view(), drained.output.view())?; // 10 bytes drained, the next request served
    var small = quiet();
    small.drainBytes = 4;
    let closed = await run(text, 4096, small)?;
    same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 2\r\n\r\nok", closed.output)?; // past 4 bytes: closed
    return Ok();
}

@test
async fn rejected_requests_close() -> Result<void, TestFailure> {
    let two = await run("GET / HTTP/1.1\r\nHost: x\r\nHost: y\r\n\r\nGET /a HTTP/1.1\r\nHost: x\r\n\r\n", 4096,
        quiet())?;
    same("HTTP/1.1 400 Bad Request\r\ncontent-length: 0\r\nconnection: close\r\n\r\n", two.output)?;
    let smuggle = await run(
        "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET /a HTTP/1.1\r\nHost: x\r\n\r\n",
        4096,
        quiet(),
    )?;
    same("HTTP/1.1 400 Bad Request\r\ncontent-length: 0\r\nconnection: close\r\n\r\n", smuggle.output)?;
    let bad = await run("POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n", 4096, quiet())?;
    same("HTTP/1.1 400 Bad Request\r\ncontent-length: 0\r\nconnection: close\r\n\r\n", bad.output)?;
    var tiny = quiet();
    tiny.maxRequestLineBytes = 16;
    let long = await run("GET /aaaaaaaaaaaaaaaaaaaa HTTP/1.1\r\nHost: x\r\n\r\n", 4096, tiny)?;
    same("HTTP/1.1 414 URI Too Long\r\ncontent-length: 0\r\nconnection: close\r\n\r\n", long.output)?;
    return Ok();
}

@test
async fn head_version_and_errors() -> Result<void, TestFailure> {
    let head = await run("HEAD /a HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 3\r\n\r\n", head.output)?; // GET's length, no content
    let old = await run("GET /a HTTP/1.0\r\n\r\nGET /b HTTP/1.0\r\n\r\n", 4096, quiet())?;
    same("HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 3\r\nconnection: close\r\n\r\n/a:", old.output)?;
    let failed = await run("GET /fail HTTP/1.1\r\nHost: x\r\n\r\nGET /a HTTP/1.1\r\nHost: x\r\n\r\n", 4096,
        quiet())?;
    var expected = Vector<u8>.create();
    Check.isTrue(pushText(mut expected, "HTTP/1.1 404 Not Found\r\ncontent-length: 0\r\n\r\n"), "e")?;
    echoed("/a", "", mut expected)?;
    Check.equalBytes(expected.view(), failed.output.view())?; // a handler's status keeps the connection
    return Ok();
}

@test
async fn large_responses() -> Result<void, TestFailure> {
    var x = Vector<u8>.create();
    for (i in 0..20000) {
        match (x.push(120)) {
            Ok() => {}
            Err(_) => { return Err(TestFailure.create("x")); }
        }
    }
    // Undeclared: the 16 KiB buffer fills, so it is chunked: 0x4000 bytes, then 0xe20 (3616) at the end.
    let xs = x.view();
    var chunked = Vector<u8>.create();
    Check.isTrue(pushText(mut chunked, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ntransfer-encoding: chunked\r\n\r\n4000\r\n") &&
        pushBytes(mut chunked, xs[0..16384]) && pushText(mut chunked, "\r\ne20\r\n") &&
        pushBytes(mut chunked, xs[16384..]) && pushText(mut chunked, "\r\n0\r\n\r\n"), "e")?;
    let big = await run("GET /big HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    Check.equalBytes(chunked.view(), big.output.view())?;
    var known = Vector<u8>.create();
    Check.isTrue(pushText(mut known, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 20000\r\n\r\n") &&
        pushBytes(mut known, x.view()), "e")?;
    let declared = await run("GET /bigknown HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    Check.equalBytes(known.view(), declared.output.view())?;
    return Ok();
}

/// A write at least as large as the 16 KiB buffer goes out without a copy once the buffer is empty, framed as a
/// buffered one. `/huge` writes "ab", then 40000 bytes: the first fills the buffer with "ab" and 16382 of them, sent
/// as one chunk of 0x4000; the other 23618 (0x5c42) go out directly as the next chunk.
@test
async fn large_writes_go_out_directly() -> Result<void, TestFailure> {
    var x = Vector<u8>.create();
    for (i in 0..40000) {
        match (x.push(120)) {
            Ok() => {}
            Err(_) => { return Err(TestFailure.create("x")); }
        }
    }
    let xs = x.view();
    var chunked = Vector<u8>.create();
    Check.isTrue(pushText(mut chunked, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ntransfer-encoding: chunked\r\n\r\n4000\r\nab") &&
        pushBytes(mut chunked, xs[0..16382]) && pushText(mut chunked, "\r\n5c42\r\n") &&
        pushBytes(mut chunked, xs[16382..]) && pushText(mut chunked, "\r\n0\r\n\r\n"), "e")?;
    let huge = await run("GET /huge HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    Check.equalBytes(chunked.view(), huge.output.view())?;
    var known = Vector<u8>.create();
    Check.isTrue(pushText(mut known, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 40002\r\n\r\nab") &&
        pushBytes(mut known, xs), "e")?;
    let declared = await run("GET /hugeknown HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    Check.equalBytes(known.view(), declared.output.view())?;
    // HEAD: the head GET would send, and no content (RFC 9110 §9.3.2), then the next request's response.
    var headed = Vector<u8>.create();
    Check.isTrue(pushText(mut headed, "HTTP/1.1 200 OK\r\nx-hook: 1\r\ncontent-length: 40002\r\n\r\n"), "e")?;
    echoed("/a", "", mut headed)?;
    let head = await run("HEAD /hugeknown HTTP/1.1\r\nHost: x\r\n\r\nGET /a HTTP/1.1\r\nHost: x\r\n\r\n", 4096, quiet())?;
    Check.equalBytes(headed.view(), head.output.view())?;
    return Ok();
}

/// With the default limits every response carries `Date` (RFC 9110 §6.6.1) right after the status line: an
/// IMF-fixdate of a second of the wall clock while the requests were served. The rejection carries it too.
@test
async fn responses_carry_the_date() -> Result<void, TestFailure> {
    let before = Clock.now().seconds;
    let s = await run(
        "GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\n\r\nBAD\r\n\r\n",
        4096,
        Limits.defaults(),
    )?;
    let after = Clock.now().seconds;
    let out = s.output.view();
    // Each response is "<status line>date: <29 bytes>\r\n<the rest>"; the two 200s are 89 bytes each.
    let first: usize = 23; // after "HTTP/1.1 200 OK\r\ndate: "
    let second: usize = 89 + 23;
    let third: usize = 178 + 32; // after "HTTP/1.1 400 Bad Request\r\ndate: "
    Check.isTrue(out.length == third + 29 + 42, "three responses of the expected lengths")?;
    let d1 = out[first..first + 29];
    let d2 = out[second..second + 29];
    let d3 = out[third..third + 29];
    Check.isTrue(inWindow(d1, before, after), "the first response's date is the clock's")?;
    Check.isTrue(inWindow(d2, before, after), "the second response's date is the clock's")?;
    Check.isTrue(inWindow(d3, before, after), "the rejection's date is the clock's")?;
    var expected = Vector<u8>.create();
    let ok = pushText(mut expected, "HTTP/1.1 200 OK\r\ndate: ") && pushBytes(mut expected, d1) &&
        pushText(mut expected, "\r\nx-hook: 1\r\ncontent-length: 3\r\n\r\n/a:") &&
        pushText(mut expected, "HTTP/1.1 200 OK\r\ndate: ") && pushBytes(mut expected, d2) &&
        pushText(mut expected, "\r\nx-hook: 1\r\ncontent-length: 3\r\n\r\n/b:") &&
        pushText(mut expected, "HTTP/1.1 400 Bad Request\r\ndate: ") && pushBytes(mut expected, d3) &&
        pushText(mut expected, "\r\ncontent-length: 0\r\nconnection: close\r\n\r\n");
    Check.isTrue(ok, "expected bytes")?;
    Check.equalBytes(expected.view(), out)?;
    return Ok();
}

/// `date` is the IMF-fixdate of a second from `before` to `after`.
fn inWindow(date: Slice<u8>, before: i64, after: i64) -> bool {
    var t = before;
    while (t <= after) {
        var text = [0u8; 29];
        HttpDate.format(truncate<u64>(t), mut text);
        if (sameBytes(date, text[..])) {
            return true;
        }
        t += 1;
    }
    return false;
}

fn sameBytes(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}
