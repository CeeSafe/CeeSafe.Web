// The client's half of the engine (Web ADR 0009 §3.1). Expected values are worked out from RFC 9112 §4 (status
// line) and §6.3 (response framing), and from the writer's contract.
import web_core;
import web_http;

/// What `text` parses to as the response to `method`: the status, the framing as a number (0 empty, 1 length,
/// 2 chunked, 3 until close; the length after), and keep-alive. Or the error's description.
struct Got {
    status: u16;
    framing: u32;
    length: u64;
    keepAlive: bool;
    error: ProtocolError?;
    complete: bool;
}

fn response(text: StringView, method: Method) -> Got {
    let bytes = text.bytes();
    var scanner = HeadScanner.create();
    let limits = Limits.defaults();
    let none = Got { status: 0, framing: 9, length: 0, keepAlive: false, error: null, complete: false };
    match (scanner.scan(bytes, limits)) {
        Ok(true) => {}
        Ok(false) => { return none; }
        Err(e) => { return Got { status: 0, framing: 9, length: 0, keepAlive: false, error: Some(e), complete: true }; }
    }
    match (parseResponseHead(bytes, scanner.start(), scanner.end(), method, limits)) {
        Ok(r) => {
            let framing = match (r.body) {
                ResponseBody.Empty => 0u32,
                ResponseBody.Length(_) => 1u32,
                ResponseBody.Chunked => 2u32,
                ResponseBody.UntilClose => 3u32,
            };
            let length = match (r.body) {
                ResponseBody.Length(n) => n,
                _ => 0,
            };
            return Got { status: r.status, framing: framing, length: length, keepAlive: r.keepAlive, error: null, complete: true };
        }
        Err(e) => { return Got { status: 0, framing: 9, length: 0, keepAlive: false, error: Some(e), complete: true }; }
    }
}

fn expect(g: Got, status: u16, framing: u32, length: u64, keepAlive: bool, what: StringView) -> Result<void, TestFailure> {
    match (g.error) {
        Some(e) => { return Check.fail(ProtocolErrors.describe(e)); }
        null => {}
    }
    Check.isTrue(g.complete, "a complete head")?;
    Check.equalU64(status as u64, g.status as u64)?;
    Check.equalU64(framing as u64, g.framing as u64)?;
    Check.equalU64(length, g.length)?;
    return Check.isTrue(g.keepAlive == keepAlive, what);
}

fn refused(g: Got, error: StringView) -> Result<void, TestFailure> {
    match (g.error) {
        Some(e) => { return Check.equalBytes(error.bytes(), ProtocolErrors.describe(e).bytes()); }
        null => { return Check.fail(error); }
    }
}

@test
fn response_framing() -> Result<void, TestFailure> {
    expect(response("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n", Method.Get), 200, 1, 5, true, "a length")?;
    expect(response("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", Method.Get), 200, 2, 0, true, "chunked")?;
    // No framing: until the close, and so not reusable (RFC 9112 §6.3 item 8).
    expect(response("HTTP/1.1 200 OK\r\n\r\n", Method.Get), 200, 3, 0, false, "until close")?;
    // No body whatever the fields say: HEAD, 1xx, 204, 304 (§6.3 items 1-2).
    expect(response("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\n", Method.Head), 200, 0, 0, true, "HEAD")?;
    expect(response("HTTP/1.1 204 No Content\r\n\r\n", Method.Get), 204, 0, 0, true, "204")?;
    expect(response("HTTP/1.1 304 Not Modified\r\nContent-Length: 3\r\n\r\n", Method.Get), 304, 0, 0, true, "304")?;
    expect(response("HTTP/1.1 100 Continue\r\n\r\n", Method.Post), 100, 0, 0, true, "100")?;
    expect(response("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", Method.Get), 200, 1, 0, true, "an empty body")?;
    // Keep-alive (RFC 9112 §9.3).
    expect(response("HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 1\r\n\r\n", Method.Get), 200, 1, 1, false, "close")?;
    expect(response("HTTP/1.0 200 OK\r\nContent-Length: 1\r\n\r\n", Method.Get), 200, 1, 1, false, "1.0")?;
    expect(response("HTTP/1.0 200 OK\r\nConnection: keep-alive\r\nContent-Length: 1\r\n\r\n", Method.Get), 200, 1, 1, true, "1.0 kept")?;
    // The reason phrase may be empty, and its space may be missing.
    expect(response("HTTP/1.1 404 \r\nContent-Length: 0\r\n\r\n", Method.Get), 404, 1, 0, true, "an empty reason")?;
    expect(response("HTTP/1.1 503\r\nContent-Length: 0\r\n\r\n", Method.Get), 503, 1, 0, true, "no reason")?;
    expect(response("HTTP/1.1 200 Very Fine Indeed\r\nContent-Length: 0\r\n\r\n", Method.Get), 200, 1, 0, true, "a long reason")?;
    return Ok();
}

@test
fn malformed_responses() -> Result<void, TestFailure> {
    refused(response("HTTP/1.1 20 OK\r\n\r\n", Method.Get), "malformed status line")?;
    refused(response("HTTP/1.1 2000 OK\r\n\r\n", Method.Get), "malformed status line")?;
    refused(response("HTTP/1.1 099 Low\r\n\r\n", Method.Get), "malformed status line")?;
    refused(response("http/1.1 200 OK\r\n\r\n", Method.Get), "malformed status line")?;
    refused(response("HTTP/1.1  200 OK\r\n\r\n", Method.Get), "malformed status line")?;
    refused(response("HTTP/2.0 200 OK\r\n\r\n", Method.Get), "unsupported HTTP version")?;
    refused(response("HTTP/1.1 200 OK\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n", Method.Get),
        "both Content-Length and Transfer-Encoding")?;
    refused(response("HTTP/1.1 200 OK\r\nContent-Length: 3\r\nContent-Length: 4\r\n\r\n", Method.Get),
        "invalid Content-Length")?;
    refused(response("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n", Method.Get),
        "unsupported Transfer-Encoding")?;
    refused(response("HTTP/1.1 200 OK\r\n folded: x\r\n\r\n", Method.Get), "obsolete line folding")?;
    refused(response("HTTP/1.1 200 OK\nContent-Length: 0\r\n\r\n", Method.Get), "bare LF")?;
    return Ok();
}

@test
fn writing_requests() -> Result<void, TestFailure> {
    var get = Vector<u8>.create();
    var w = RequestWriter.start(mut get, "GET".bytes(), "/a?b=1".bytes(), "example.com:8080".bytes());
    w.field(mut get, "accept".bytes(), "*/*".bytes());
    Check.isTrue(w.finish(mut get, Some(0u64), false), "a GET")?;
    Check.equalBytes("GET /a?b=1 HTTP/1.1\r\nhost: example.com:8080\r\naccept: */*\r\n\r\n".bytes(), get.view())?;

    var post = Vector<u8>.create();
    var p = RequestWriter.start(mut post, "POST".bytes(), "/items".bytes(), "[::1]:443".bytes());
    Check.isTrue(p.finish(mut post, Some(17u64), true), "a POST")?;
    Check.equalBytes("POST /items HTTP/1.1\r\nhost: [::1]:443\r\ncontent-length: 17\r\n\r\n".bytes(), post.view())?;

    var empty = Vector<u8>.create();
    var e = RequestWriter.start(mut empty, "PUT".bytes(), "/x".bytes(), "h".bytes());
    Check.isTrue(e.finish(mut empty, Some(0u64), true), "an empty PUT declares its length")?;
    Check.equalBytes("PUT /x HTTP/1.1\r\nhost: h\r\ncontent-length: 0\r\n\r\n".bytes(), empty.view())?;

    var chunked = Vector<u8>.create();
    var c = RequestWriter.start(mut chunked, "POST".bytes(), "/up".bytes(), "h".bytes());
    Check.isTrue(c.finish(mut chunked, null, true), "chunked")?;
    Check.equalBytes("POST /up HTTP/1.1\r\nhost: h\r\ntransfer-encoding: chunked\r\n\r\n".bytes(), chunked.view())?;

    // Refusals: nothing a caller passes can end a line or add a field.
    Check.isTrue(!injected("GET", "/", "h", "x-a", "1\r\nx-evil: 1"), "CR LF in a value")?;
    Check.isTrue(!injected("GET", "/", "h", "x a", "1"), "a space in a name")?;
    Check.isTrue(!injected("GET", "/", "h", "Host", "other"), "a second host")?;
    Check.isTrue(!injected("GET", "/", "h", "Content-Length", "5"), "framing from a caller")?;
    Check.isTrue(!injected("GET", "/a b", "h", "x", "1"), "a space in the target")?;
    Check.isTrue(!injected("GET", "a", "h", "x", "1"), "a target not in origin form")?;
    Check.isTrue(!injected("G T", "/", "h", "x", "1"), "a space in the method")?;
    Check.isTrue(!injected("GET", "/", "h\r\nx: y", "x", "1"), "CR LF in the host")?;
    Check.isTrue(!injected("GET", "/", "", "x", "1"), "an empty host")?;
    Check.isTrue(injected("GET", "/", "h", "x", "1"), "and a good one passes")?;
    return Ok();
}

fn injected(method: StringView, target: StringView, host: StringView, name: StringView, value: StringView) -> bool {
    var out = Vector<u8>.create();
    var w = RequestWriter.start(mut out, method.bytes(), target.bytes(), host.bytes());
    w.field(mut out, name.bytes(), value.bytes());
    return w.finish(mut out, Some(0u64), false);
}
