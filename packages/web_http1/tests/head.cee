// The request head parser against RFC 9112, case by case. Each expected outcome is the RFC's rule for a server, cited
// beside it; this server takes the strict choice wherever the RFC lets it (bare LF, obs-fold: reject).
import web_http;

@test
fn a_simple_get() -> Result<void, TestFailure> {
    let text = "GET /a?b=1 HTTP/1.1\r\nHost: example.com\r\nX-Pad:  v \t\r\n\r\n";
    let input = text.bytes();
    let limits = Limits.defaults();
    var scanner = HeadScanner.create();
    Check.isTrue(match (scanner.scan(input, limits)) {
        Ok(true) => true,
        _ => false,
    }, "the head is complete")?;
    Check.equalU64(input.length as u64, scanner.end() as u64)?;
    let head = match (parseHead(input, scanner.start(), scanner.end(), limits)) {
        Ok(h) => h,
        Err(_) => { return Err(TestFailure.create("it parses")); },
    };
    let r = head.request;
    Check.isTrue(Methods.same(r.method(), Method.Get), "GET")?;
    Check.equalText("/a?b=1", r.target())?;
    Check.equalText("/a", r.path())?;
    Check.isTrue(match (r.version()) {
        Version.Http11 => true,
        _ => false,
    }, "HTTP/1.1")?;
    Check.equalU64(2, r.headers().count() as u64)?;
    let pad = match (r.headers().getNamed("x-pad")) {
        Some(v) => v,
        null => { return Err(TestFailure.create("X-Pad is found")); },
    };
    Check.equalBytes("v".bytes(), pad)?; // OWS on both sides is not part of the value (RFC 9112 §5)
    Check.isTrue(match (head.framing) {
        BodyFraming.None => true,
        _ => false,
    }, "no body")?;
    Check.isTrue(head.keepAlive && !head.expectContinue, "keep-alive by default in 1.1, no 100-continue")?;
    return Ok();
}

@test
fn framing_and_connection() -> Result<void, TestFailure> {
    let limits = Limits.defaults();
    let a = "POST /x HTTP/1.1\r\nHost: a\r\nContent-Length: 5, 5\r\nConnection: Close\r\nExpect: 100-Continue\r\n\r\nhello";
    let input = a.bytes();
    var s = HeadScanner.create();
    match (s.scan(input, limits)) {
        Ok(_) => {}
        Err(_) => { return Err(TestFailure.create("scan")); }
    }
    Check.equalU64((input.length - 5) as u64, s.end() as u64)?; // the body stays in the buffer
    let h = match (parseHead(input, s.start(), s.end(), limits)) {
        Ok(v) => v,
        Err(_) => { return Err(TestFailure.create("a list of equal lengths is one length (RFC 9112 §6.3)")); },
    };
    Check.isTrue(match (h.framing) {
        BodyFraming.Length(n) => n == 5,
        _ => false,
    }, "Content-Length: 5, 5 is 5")?;
    Check.isFalse(h.keepAlive, "Connection: Close ends it, any case")?;
    Check.isTrue(h.expectContinue, "Expect: 100-Continue, any case")?;

    let c = "POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: Chunked\r\n\r\n";
    var s2 = HeadScanner.create();
    match (s2.scan(c.bytes(), limits)) {
        Ok(_) => {}
        Err(_) => { return Err(TestFailure.create("scan chunked")); }
    }
    let h2 = match (parseHead(c.bytes(), s2.start(), s2.end(), limits)) {
        Ok(v) => v,
        Err(_) => { return Err(TestFailure.create("Chunked is chunked: codings ignore case")); },
    };
    Check.isTrue(match (h2.framing) {
        BodyFraming.Chunked => true,
        _ => false,
    }, "chunked framing")?;

    let old = "GET / HTTP/1.0\r\n\r\n";
    var s3 = HeadScanner.create();
    match (s3.scan(old.bytes(), limits)) {
        Ok(_) => {}
        Err(_) => { return Err(TestFailure.create("scan 1.0")); }
    }
    let h3 = match (parseHead(old.bytes(), s3.start(), s3.end(), limits)) {
        Ok(v) => v,
        Err(_) => { return Err(TestFailure.create("HTTP/1.0 needs no Host")); },
    };
    Check.isFalse(h3.keepAlive, "HTTP/1.0 closes unless keep-alive is asked (RFC 9112 §9.3)")?;

    let old2 = "GET / HTTP/1.0\r\nConnection: keep-alive\r\nExpect: 100-continue\r\n\r\n";
    var s4 = HeadScanner.create();
    match (s4.scan(old2.bytes(), limits)) {
        Ok(_) => {}
        Err(_) => { return Err(TestFailure.create("scan 1.0 keep-alive")); }
    }
    let h4 = match (parseHead(old2.bytes(), s4.start(), s4.end(), limits)) {
        Ok(v) => v,
        Err(_) => { return Err(TestFailure.create("1.0 keep-alive parses")); },
    };
    Check.isTrue(h4.keepAlive, "HTTP/1.0 with Connection: keep-alive stays open")?;
    Check.isFalse(h4.expectContinue, "100-continue from HTTP/1.0 is ignored (RFC 9110 §10.1.1)")?;
    return Ok();
}

@test
fn accepted_forms() -> Result<void, TestFailure> {
    accepts("\r\n\r\nGET / HTTP/1.1\r\nHost: a\r\n\r\n", "empty lines before the request line (RFC 9112 §2.2)")?;
    accepts("OPTIONS * HTTP/1.1\r\nHost: a\r\n\r\n", "asterisk-form for OPTIONS")?;
    accepts("CONNECT a.test:443 HTTP/1.1\r\nHost: a.test:443\r\n\r\n", "authority-form for CONNECT")?;
    accepts("GET http://a.test/b HTTP/1.1\r\nHost: a.test\r\n\r\n", "absolute-form")?;
    accepts("GET / HTTP/1.2\r\nHost: a\r\n\r\n", "HTTP/1.2 is handled as 1.1 (RFC 9110 §2.5)")?;
    accepts("PROPFIND / HTTP/1.1\r\nHost: a\r\n\r\n", "an extension method")?;
    accepts("GET / HTTP/1.1\r\nHost: a\r\nX: caf\u{e9}\r\n\r\n", "obs-text in a value")?;
    accepts("GET / HTTP/1.1\r\nHost: [::1]:8080\r\n\r\n", "an IPv6 Host")?;
    accepts("GET / HTTP/1.1\r\nHost: a\r\nX:\r\n\r\n", "an empty value")?;
    accepts("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\n", "Content-Length: 0")?;
    return Ok();
}

@test
fn request_line_errors() -> Result<void, TestFailure> {
    rejects("GET  / HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "two spaces")?;
    rejects("GET / HTTP/1.1 \r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "a trailing space")?;
    rejects("GET / http/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "lower-case HTTP (RFC 9112 §2.3)")?;
    rejects("GET / HTTP/2.0\r\nHost: a\r\n\r\n", ProtocolError.UnsupportedVersion, "HTTP/2.0 over HTTP/1 framing")?;
    rejects("GET / HTTP/1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "no minor version")?;
    rejects("G@T / HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "a method that is not a token")?;
    rejects("GET a HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "a target in no form")?;
    rejects("GET * HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "* without OPTIONS")?;
    rejects("CONNECT a/b HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "CONNECT with a path")?;
    rejects("GET /caf\u{e9} HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "non-ASCII in the target")?;
    rejects("GET /\u{0}x HTTP/1.1\r\nHost: a\r\n\r\n", ProtocolError.BadRequestLine, "NUL in the target")?;
    rejects("GET / HTTP/1.1\nHost: a\n\n", ProtocolError.BareLineFeed, "bare LF line ends (RFC 9112 §2.2)")?;
    return Ok();
}

@test
fn field_errors() -> Result<void, TestFailure> {
    rejects("GET / HTTP/1.1\r\nHost: a\nX: y\r\n\r\n", ProtocolError.BareLineFeed, "a bare LF after a field")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\nX: a\r\n b\r\n\r\n", ProtocolError.ObsoleteFold, "obs-fold (RFC 9112 §5.2)")?;
    rejects("GET / HTTP/1.1\r\nHost : a\r\n\r\n", ProtocolError.BadHeader, "space before the colon (RFC 9112 §5.1)")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\nX: a\u{0}b\r\n\r\n", ProtocolError.BadHeader, "NUL in a value")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\nX: a\rb\r\n\r\n", ProtocolError.BadHeader, "a bare CR in a value")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\nNoColon\r\n\r\n", ProtocolError.BadHeader, "a line without a colon")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\n: v\r\n\r\n", ProtocolError.BadHeader, "an empty name")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\nX\u{e9}: v\r\n\r\n", ProtocolError.BadHeader, "a name that is not a token")?;
    rejects("GET / HTTP/1.1\r\n\r\n", ProtocolError.BadHost, "HTTP/1.1 without Host (RFC 9112 §3.2)")?;
    rejects("GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n", ProtocolError.BadHost, "two Hosts")?;
    rejects("GET / HTTP/1.1\r\nHost: a b\r\n\r\n", ProtocolError.BadHost, "a space inside Host")?;
    rejects("GET / HTTP/1.1\r\nHost: a/b\r\n\r\n", ProtocolError.BadHost, "a slash inside Host")?;
    return Ok();
}

@test
fn smuggling_shapes() -> Result<void, TestFailure> {
    // CL.TE and TE.CL: both fields, in either order (RFC 9112 §6.1: a server may reject; this one does, and closes).
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 6\r\nTransfer-Encoding: chunked\r\n\r\n",
        ProtocolError.LengthAndEncoding, "CL.TE")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nContent-Length: 6\r\n\r\n",
        ProtocolError.LengthAndEncoding, "TE.CL")?;
    // TE.TE obfuscations: anything but exactly one chunked is refused.
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: xchunked\r\n\r\n", ProtocolError.BadTransferEncoding,
        "xchunked")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked, chunked\r\n\r\n",
        ProtocolError.BadTransferEncoding, "chunked twice")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: identity\r\n\r\n",
        ProtocolError.BadTransferEncoding, "a second TE field")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: gzip, chunked\r\n\r\n",
        ProtocolError.BadTransferEncoding, "a coding this server does not decode")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked, gzip\r\n\r\n",
        ProtocolError.BadTransferEncoding, "chunked not last")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding : chunked\r\n\r\n", ProtocolError.BadHeader,
        "space before the colon of TE")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: \u{b}chunked\r\n\r\n", ProtocolError.BadHeader,
        "a vertical tab before chunked")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n  , identity\r\n\r\n",
        ProtocolError.ObsoleteFold, "a folded TE")?;
    rejects("POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n", ProtocolError.BadTransferEncoding,
        "TE in HTTP/1.0 (RFC 9112 §6.1)")?;
    // Content-Length.
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\n",
        ProtocolError.BadContentLength, "two different lengths")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5, 6\r\n\r\n", ProtocolError.BadContentLength,
        "a list of different lengths")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: +5\r\n\r\n", ProtocolError.BadContentLength, "a sign")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: -1\r\n\r\n", ProtocolError.BadContentLength, "negative")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5x\r\n\r\n", ProtocolError.BadContentLength, "5x")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 0x10\r\n\r\n", ProtocolError.BadContentLength, "hex")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: \r\n\r\n", ProtocolError.BadContentLength, "empty")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 18446744073709551616\r\n\r\n",
        ProtocolError.BadContentLength, "2^64: 20 digits")?;
    rejects("POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 8388609\r\n\r\n", ProtocolError.BodyTooLarge,
        "one byte past the 8 MiB default")?;
    return Ok();
}

@test
fn limits_are_enforced() -> Result<void, TestFailure> {
    var limits = Limits.defaults();
    limits.maxRequestLineBytes = 32;
    limits.maxHeadBytes = 64;
    limits.maxHeaders = 2;
    // "GET /" + 11 × "a" + " HTTP/1.1\r\n" is 5 + 11 + 11 = 27 bytes: fits; 21 × "a" is 37: too long.
    let fits = "GET /aaaaaaaaaaa HTTP/1.1\r\nHost: a\r\n\r\n";
    Check.isTrue(match (outcomeOf(fits, limits)) {
        Outcome.Parsed => true,
        _ => false,
    }, "a 27-byte request line under a 32-byte limit")?;
    Check.isTrue(match (outcomeOf("GET /aaaaaaaaaaaaaaaaaaaaa HTTP/1.1\r\nHost: a\r\n\r\n", limits)) {
        Outcome.Rejected(ProtocolError.RequestLineTooLong) => true,
        _ => false,
    }, "a 37-byte request line")?;
    Check.isTrue(match (outcomeOf("GET /aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", limits)) {
        Outcome.Rejected(ProtocolError.RequestLineTooLong) => true,
        _ => false,
    }, "an unfinished request line already past the limit")?;
    Check.isTrue(match (outcomeOf("GET / HTTP/1.1\r\nHost: a\r\nA: 1\r\n\r\n", limits)) {
        Outcome.Parsed => true,
        _ => false,
    }, "two fields under a limit of two")?;
    Check.isTrue(match (outcomeOf("GET / HTTP/1.1\r\nHost: a\r\nA: 1\r\nB: 2\r\n\r\n", limits)) {
        Outcome.Rejected(ProtocolError.TooManyHeaders) => true,
        _ => false,
    }, "three fields")?;
    // 16 + 9 + 2 + 2 × 20 = 67 bytes past a 64-byte head limit, unfinished.
    Check.isTrue(match (outcomeOf("GET / HTTP/1.1\r\nHost: a\r\nX: aaaaaaaaaaaaaaa\r\nY: aaaaaaaaaaaaaaa\r\n", limits)) {
        Outcome.Rejected(ProtocolError.HeadTooLarge) => true,
        _ => false,
    }, "an unfinished head past the limit")?;
    Check.isTrue(match (outcomeOf("GET / HTTP/1.1\r\nHost: a\r\n", limits)) {
        Outcome.Incomplete => true,
        _ => false,
    }, "no empty line yet: incomplete")?;
    return Ok();
}

@test
fn byte_at_a_time_matches_whole() -> Result<void, TestFailure> {
    // Fed one byte more each call, the scanner finds the same end, after the same number of bytes, as all at once.
    let text = "\r\nPOST /up HTTP/1.1\r\nHost: a\r\nContent-Length: 3\r\n\r\nabcGET";
    let input = text.bytes();
    let limits = Limits.defaults();
    var s = HeadScanner.create();
    var completeAt: usize = 0;
    for (n in 1..input.length + 1) {
        match (s.scan(input[0..n], limits)) {
            Ok(true) => {
                if (completeAt == 0) {
                    completeAt = n;
                }
            }
            Ok(false) => {}
            Err(_) => { return Err(TestFailure.create("no error at any split")); }
        }
    }
    // The head is "\r\n" 2 + "POST /up HTTP/1.1\r\n" (4 + 1 + 3 + 1 + 8 + 2) 19 + "Host: a\r\n" 9 +
    // "Content-Length: 3\r\n" (15 + 2 + 2) 19 + the empty line 2 = 51 bytes, its empty line's LF the 51st.
    Check.equalU64(51, completeAt as u64)?;
    Check.equalU64(51, s.end() as u64)?;
    Check.equalU64(2, s.start() as u64)?;
    return Ok();
}
