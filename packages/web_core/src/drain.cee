// web_core drain signal (Web ADR 0001 §3.5, implementation plan M1 task 4): graceful shutdown, broadcast to every
// task of a server.

/// A server's drain: once started, every task waiting on it wakes, and every later check sees it. One drain serves any
/// number of waiters (unlike CeeSafe's `AsyncSignal`, which wakes one task): it is a channel that is never sent to
/// and is closed to start the drain, so each waiter's `recvAsync` sees the end (`tests/probes/drain-broadcast.cee`).
/// It is shared by borrow, or, for a task that may hold no loan (an HTTP/2 stream's), by `share`; starting it is
/// idempotent and has no effects, so a signal handler's task may call it.
@noncopy
public struct Drain {
    private channel: Channel<u8>;
    private started: Arc<AtomicBool>;

    /// A drain not started. Allocates the channel and the flag once.
    public fn create() -> Result<Drain, NetError> {
        let channel = match (Channel<u8>.create(1)) {
            Ok(c) => c,
            Err(e) => { return Err(NetErrors.fromAlloc(e)); },
        };
        match (Arc<AtomicBool>.create(AtomicBool.create(false))) {
            Ok(flag) => { return Ok(Drain { channel: channel, started: flag }); }
            Err(e) => { return Err(NetErrors.fromAlloc(e)); }
        }
    }

    /// Another handle to the same drain: started when it is, waking with it.
    public fn share(borrow this) -> Drain => Drain { channel: this.channel.clone(), started: this.started.clone() };

    /// Starts the drain: wakes every waiter. Calling it again does nothing more.
    public fn start(borrow this) {
        this.started.get().store(true);
        this.channel.close();
    }

    /// Whether the drain has started.
    public fn isDraining(borrow this) -> bool => this.started.get().load();

    /// Waits until the drain starts (at once if it has). `Err(Cancelled)` if the task is cancelled first.
    public async fn wait(borrow this) -> Result<void, NetError> {
        loop {
            match (await this.channel.recvAsync()) {
                Ok(null) => { return Ok(); }
                Ok(_) => {} // never sent to; a value would be ignored
                Err(e) => { return Err(NetErrors.fromAsync(e)); }
            }
        }
    }
}

/// Waits until `drain` starts, then returns `Err(NetError.Cancelled)`; it never returns `Ok`. So it is the second
/// child of an `Async.race` that stops an operation when a drain starts, as `deadlineElapsed` does for a deadline;
/// the caller tells the two apart with `drain.isDraining()`. Its `Err` decides the race even when the operation
/// returned a value in the same turn (Web ADR 0021): for an operation whose value must not be lost, a read or an
/// accept, race `drainBegun` instead.
///
/// ```ceesafe
/// let r: Result<Raced<bool>, NetError> =
///     await Async.race(async () => await turnGiven(channel), async () => await drainStarted<bool>(drain));
/// ```
public async fn drainStarted<T>(drain: borrow Drain) -> Result<T, NetError> {
    await drain.wait()?;
    return Err(NetError.Cancelled);
}

/// Waits until `drain` starts, then returns `Ok(null)` (Web ADR 0021): the second child of an `Async.race` whose first
/// child wraps its value, `Ok(Some(v))`, for an operation whose result must not be lost (a read's bytes, an accepted
/// connection). The drain and the operation can both finish in one turn of the executor: a child sees the race's
/// cancellation only once the race's task has run, so the operation, woken with the drain, may return its value
/// after the drain returned. `drainStarted`'s `Err` then decides the race and the value is dropped; `Ok(null)` keeps
/// it in `Raced.other`, and `drainTaken` reads it whichever child came first:
///
/// ```ceesafe
/// let r: Result<Raced<usize?>, NetError> = await Async.race(
///     async () => match (await conn.read(buffer)) { Ok(n) => Ok(Some(n)), Err(e) => Err(e) },
///     async () => await drainBegun<usize>(drain),
/// );
/// let got: usize? = drainTaken<usize>(r?); // null: the drain, and nothing was read
/// ```
public async fn drainBegun<T>(drain: borrow Drain) -> Result<T?, NetError> {
    await drain.wait()?;
    return Ok(null);
}

/// What a race of an operation (`Ok(Some(v))`) against `drainBegun` got: the operation's value if it returned one,
/// before the drain or in the same turn; null if the drain came first and the operation had nothing.
public fn drainTaken<T>(raced: Raced<T?>) -> T? {
    match (raced.value) {
        Some(v) => { return Some(v); }
        null => {}
    }
    return match (raced.other) {
        Some(late) => late,
        null => null,
    };
}
