// web_core connection context (Web ADR 0001 §3.6): what a connection task knows about its connection.

/// A connection's identity, timing and the server's drain, owned by its connection task and lent to handlers. The peer
/// and local addresses come with CeeSafe's SocketAddress (upstream U1).
public struct ConnectionContext<region r> {
    private number: u64;
    private acceptedAt: u64;
    private drainSignal: borrow(r) Drain;

    /// The context of connection `id`, accepted at `acceptedAt` on `Timer.now()`'s clock, served under `drain`.
    public fn create(id: u64, acceptedAt: u64, drain: borrow(r) Drain) -> ConnectionContext<r> =>
        ConnectionContext { number: id, acceptedAt: acceptedAt, drainSignal: drain };

    /// The context of connection `id`, accepted now.
    public fn acceptedNow(id: u64, drain: borrow(r) Drain) -> ConnectionContext<r> =>
        ConnectionContext.create(id, Timer.now(), drain);

    /// The connection's id, unique within one server.
    public fn id(borrow this) -> u64 => this.number;

    /// When it was accepted, on `Timer.now()`'s clock.
    public fn acceptedAtMs(borrow this) -> u64 => this.acceptedAt;

    /// Milliseconds since it was accepted.
    public fn ageMs(borrow this) -> u64 {
        let now = Timer.now();
        return if (now >= this.acceptedAt) now - this.acceptedAt else 0;
    }

    /// The server's drain: a connection between requests races its idle wait against it (`drainStarted`).
    public fn drain(borrow this) -> borrow(r) Drain => this.drainSignal;

    /// Whether the server is draining: finish the request in flight, then close.
    public fn isDraining(borrow this) -> bool => this.drainSignal.isDraining();
}
