// Transport and Transports (Web ADR 0001 §3.2-3.6), over a scripted transport: reads at every fragment size,
// writeAllVectored at every partial-step size, a step that writes nothing, and closeGracefully against a peer that
// ends its side and one that never does.
// Ported from tests/web_core/transport to `ceesafec test` (CeeSafe ADR 0049).

/// Delivers `input` at most `chunk` bytes per read; each vectored step writes at most `step` bytes; `hang` makes
/// reads wait (cancellably) instead of reaching the end.
struct Script {
    input: Vector<u8>;
    at: usize;
    chunk: usize;
    out: Vector<u8>;
    step: usize;
    hang: bool;
    shut: bool;
}

impl Transport for Script {
    async fn read(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, NetError> {
        if (buffer.length == 0) {
            return Err(NetError.LimitExceeded);
        }
        if (this.at == this.input.length) {
            if (this.hang) {
                match (await Timer.sleep(1000000)) {
                    Ok() => {}
                    Err(e) => { return Err(NetErrors.fromAsync(e)); }
                }
            }
            return Ok(0);
        }
        var n: usize = 0;
        while (n < buffer.length && n < this.chunk && this.at < this.input.length) {
            buffer[n] = this.input[this.at];
            n += 1;
            this.at += 1;
        }
        return Ok(n);
    }

    async fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, NetError> {
        for (b in bytes) {
            match (this.out.push(b)) {
                Ok() => {}
                Err(e) => { return Err(NetErrors.fromAlloc(e)); }
            }
        }
        return Ok();
    }

    async fn writeVectored(borrow mut this, parts: borrow IoParts) -> Result<usize, NetError> {
        var n: usize = 0;
        for (i in 0..parts.count()) {
            let p = parts.part(i);
            for (b in p) {
                if (n == this.step) {
                    return Ok(n);
                }
                match (this.out.push(b)) {
                    Ok() => {}
                    Err(e) => { return Err(NetErrors.fromAlloc(e)); }
                }
                n += 1;
            }
        }
        return Ok(n);
    }

    async fn shutdownWrite(borrow mut this) -> Result<void, NetError> {
        this.shut = true;
        return Ok();
    }

    fn alpn(borrow this) -> Alpn => Alpn.None;

    @effects()
    fn peerAddress(borrow this) -> SocketAddress? => null;

    @effects()
    fn localAddress(borrow this) -> SocketAddress? => null;
}

fn script(input: StringView, chunk: usize, step: usize, hang: bool) -> Result<Script, AllocError> {
    var v = Vector<u8>.create();
    for (b in input.bytes()) {
        v.push(b)?;
    }
    return Ok(Script { input: v, at: 0, chunk: chunk, out: Vector<u8>.create(), step: step, hang: hang, shut: false });
}

async fn readAll(t: borrow mut dyn Transport, into: borrow mut OwnedBuffer) -> Result<void, NetError> {
    loop {
        let n = await t.read(into.spare())?;
        if (n == 0) {
            return Ok();
        }
        into.commit(n)?;
    }
}

@test
async fn reads_at_every_fragment_size() -> Result<void, TestFailure> {
    // "reads at every fragment size reassemble"
    let text = "GET / HTTP/1.1\r\nHost: a\r\n\r\n";
    for (chunk in 1..text.length + 2) {
        var s = alloc(script(text, truncate<usize>(chunk), 0, false))?;
        var buf = alloc(OwnedBuffer.create(64))?;
        netVoid(await readAll(mut s, mut buf))?;
        Check.equalBytes(text.bytes(), buf.readable())?;
    }
    return Ok();
}

@test
async fn write_all_vectored_at_every_step() -> Result<void, TestFailure> {
    // "writeAllVectored at every step size"
    let head = "HTTP/1.1 200 OK\r\n";
    let fields = "Content-Length: 5\r\n\r\n";
    let body = "hello";
    let whole = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello";
    for (step in 1..whole.length + 2) {
        var s = alloc(script("", 1, truncate<usize>(step), false))?;
        let two = match (IoParts.of(head.bytes()).then(fields.bytes())) {
            Some(p) => p,
            null => { return Err(TestFailure.create("IoParts has no slot for the fields")); },
        };
        let parts = match (two.then(body.bytes())) {
            Some(p) => p,
            null => { return Err(TestFailure.create("IoParts has no slot for the body")); },
        };
        netVoid(await Transports.writeAllVectored(mut s, parts))?;
        Check.equalBytes(whole.bytes(), s.out.view())?;
    }
    return Ok();
}

@test
async fn a_step_writing_nothing_is_closed() -> Result<void, TestFailure> {
    var s = alloc(script("", 1, 0, false))?;
    let x = "x";
    let parts = IoParts.of(x.bytes());
    Check.isTrue(match (await Transports.writeAllVectored(mut s, parts)) {
        Err(NetError.Closed) => true,
        _ => false,
    }, "a step writing nothing is Closed")?;
    return Ok();
}

// What web_core relies on from lib/std's IoParts (ADR 0045 §3.1); values counted by hand.
@test
fn io_parts_slots() -> Result<void, TestFailure> {
    // "IoParts slots"
    let a = "ab";
    let b = "cde";
    let p = match (IoParts.of(a.bytes()).then(b.bytes())) {
        Some(v) => v,
        null => { return Err(TestFailure.create("IoParts slots: no slot for a second part")); },
    };
    let rest = p.after(3); // "ab" whole and "c": "de" is left
    Check.equalU64(2, p.count() as u64)?;
    Check.equalU64(5, p.totalLength() as u64)?;
    Check.equalU64(3, p.part(1).length as u64)?;
    Check.equalU64(0, p.part(2).length as u64)?;
    Check.equalU64(0, p.part(7).length as u64)?;
    Check.equalU64(1, rest.count() as u64)?;
    Check.equalU64(2, rest.totalLength() as u64)?;
    Check.equalU64(100, rest.part(0)[0] as u64)?;
    Check.equalU64(0, p.after(5).totalLength() as u64)?;
    return Ok();
}

@test
async fn close_gracefully() -> Result<void, TestFailure> {
    // "closeGracefully: peer ends, or deadline"
    var scratch = [0u8; 8];
    var ends = alloc(script("bye from peer", 4, 1, false))?;
    let first = await Transports.closeGracefully(mut ends, mut scratch[..], Deadline.after(1000));
    Check.isTrue(match (first) {
        Ok() => ends.shut && ends.at == ends.input.length,
        Err(_) => false,
    }, "closeGracefully: peer ends")?;
    var hangs = alloc(script("", 4, 1, true))?;
    let second = await Transports.closeGracefully(mut hangs, mut scratch[..], Deadline.after(20));
    Check.isTrue(match (second) {
        Err(NetError.TimedOut) => hangs.shut,
        _ => false,
    }, "closeGracefully: or deadline")?;
    return Ok();
}

@test
async fn boxed_transport() -> Result<void, TestFailure> {
    // "Box<dyn Transport>"
    let s = alloc(script("abc", 2, 1, false))?;
    var t: Box<dyn Transport> = alloc(Box.create(s))?;
    var buf = [0u8; 8];
    let n = net(await t.read(mut buf[..]))?;
    Check.equalU64(2, n as u64)?;
    Check.isTrue(match (await t.read(mut buf[0..0])) {
        Err(NetError.LimitExceeded) => true,
        _ => false,
    }, "Box<dyn Transport>: an empty buffer is LimitExceeded")?;
    Check.isTrue(match (t.alpn()) {
        Alpn.None => true,
        _ => false,
    }, "Box<dyn Transport>: no ALPN")?;
    return Ok();
}
