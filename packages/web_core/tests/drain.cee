// Drain (implementation plan M1 task 4): one start wakes every waiter, a late waiter returns at once, starting twice
// is harmless, and drainStarted stops the operation it races.
// Ported from tests/web_core/drain to `ceesafec test` (CeeSafe ADR 0049).

@test
async fn drain_wakes_every_waiter() -> Result<void, TestFailure> {
    let drain = net(Drain.create())?;
    Check.isFalse(drain.isDraining(), "a new drain has not started")?;

    // Six waiters, one start.
    var woken = [false; 6];
    netVoid(await Async.scope(NetError.OutOfMemory, (s) => {
        for (k in 0..woken.length) {
            s.spawn(async () => {
                await drain.wait()?;
                woken[k] = true;
                return Ok();
            });
        }
        s.spawn(async () => {
            await sleepMs(10)?;
            drain.start();
            return Ok();
        });
    }))?;
    var all = true;
    for (k in 0..woken.length) {
        all = all && woken[k];
    }
    Check.isTrue(all && drain.isDraining(), "one start wakes all six waiters")?;

    let before = Timer.now();
    netVoid(await drain.wait())?;
    Check.isTrue(Timer.now() - before < 5, "a waiter after the start returns at once")?;
    drain.start();
    Check.isTrue(drain.isDraining(), "starting again is harmless")?;
    return Ok();
}

@test
async fn drain_started_races_an_operation() -> Result<void, TestFailure> {
    // drainStarted against an operation: the operation wins before a start, the drain wins after one.
    let fresh = net(Drain.create())?;
    let quick: Result<Raced<u32>, NetError> =
        await Async.race(async () => await work(5, 7), async () => await drainStarted<u32>(fresh));
    let r = net(quick)?;
    // "the operation finishes before a drain"
    Check.equalU64(7, r.value as u64)?;
    Check.equalU64(0, r.winner as u64)?;
    var stopped: Result<Raced<u32>, NetError> = Err(NetError.Closed);
    netVoid(await Async.scope(NetError.OutOfMemory, (s) => {
        s.spawn(async () => {
            stopped = await Async.race(async () => await work(100000, 7), async () => await drainStarted<u32>(fresh));
            return Ok();
        });
        s.spawn(async () => {
            await sleepMs(10)?;
            fresh.start();
            return Ok();
        });
    }))?;
    Check.isTrue(match (stopped) {
        Err(NetError.Cancelled) => fresh.isDraining(),
        _ => false,
    }, "a drain stops the operation as Cancelled")?;
    return Ok();
}

@test
fn drain_taken_reads_every_outcome() -> Result<void, TestFailure> {
    // Web ADR 0021: the operation's value is kept whichever child returned first. The drain winning with the
    // operation's value in `other` is the case `drainStarted` lost: both woken in one turn, the operation, a
    // grandchild under `Async.deadline`, returning before the race's cancellation reached it (seen on Linux with
    // epoll by the probe in Web ADR 0021 §1; the interleaving is the executor's, which a test here cannot force).
    let first: Raced<u32?> = Raced { winner: 0, value: Some(7u32), other: null };
    Check.isTrue(drainTaken<u32>(first) == Some(7u32), "the operation first")?;
    let both: Raced<u32?> = Raced { winner: 1, value: null, other: Some(Some(7u32)) };
    Check.isTrue(drainTaken<u32>(both) == Some(7u32), "the drain first, the operation's value in the same turn")?;
    let late: Raced<u32?> = Raced { winner: 1, value: null, other: null };
    Check.isTrue(drainTaken<u32>(late).isNull(), "the drain first, and the operation had nothing")?;
    return Ok();
}

@test
async fn drain_begun_races_an_operation() -> Result<void, TestFailure> {
    // Before a drain the operation's value is the race's; after one, with nothing come, null.
    let quiet = net(Drain.create())?;
    let early: Result<Raced<u32?>, NetError> = await Async.race(
        async () => match (await work(1, 9)) {
            Ok(v) => Ok(Some(v)),
            Err(e) => Err(e),
        },
        async () => await drainBegun<u32>(quiet),
    );
    Check.isTrue(drainTaken<u32>(net(early)?) == Some(9u32), "an operation before the drain")?;
    quiet.start();
    let none: Result<Raced<u32?>, NetError> = await Async.race(
        async () => match (await work(1000, 9)) {
            Ok(v) => Ok(Some(v)),
            Err(e) => Err(e),
        },
        async () => await drainBegun<u32>(quiet),
    );
    Check.isTrue(drainTaken<u32>(net(none)?).isNull(), "the drain, with nothing taken")?;
    return Ok();
}
