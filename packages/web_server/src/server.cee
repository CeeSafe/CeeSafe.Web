// The server (Web ADR 0007 §3.4, amendment 2): the application's state, its router and its middleware, served over
// M1's connection server. `Server<S>` implements `Application` and `ConnectionHandler` for every state type (CeeSafe
// ADR 0054's generic impls), so an application writes no glue: it calls `server.run(listener, acceptor, limits,
// drain)` (Web ADR 0007 amendment 2), which serves HTTP/1.1 and HTTP/2 (Web ADR 0011 §3.2, §4: the server moves into
// an `Arc` that every HTTP/2 stream task shares).
import web_core;
import web_transport;
import web_http;
import web_http1;
import web_http2;

/// An HTTP server for an application whose state is `S`. Its state, handlers and middleware are `Send`: HTTP/2 runs
/// each request in its own task.
public struct Server<S: Send> {
    private appState: S;
    private routes: Router<S>;
    private hooks: Vector<Box<dyn Middleware<S> + Send>>;
    private httpLimits: Limits;

    /// A server owning `state`, with no routes and no middleware; `limits` bound each connection's requests.
    public fn create(state: S, limits: Limits) -> Result<Server<S>, RouteError> {
        let routes = Router<S>.create()?;
        return Ok(Server {
            appState: state,
            routes: routes,
            hooks: Vector<Box<dyn Middleware<S> + Send>>.create(),
            httpLimits: limits,
        });
    }

    /// Adds `m` after the middleware already added: its `before` runs after theirs, its `after` before theirs.
    public fn use(borrow mut this, m: Box<dyn Middleware<S> + Send>) -> Result<void, RouteError> {
        match (this.hooks.push(m)) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(RouteError.OutOfMemory); }
        }
    }

    /// The router, to add routes.
    public fn router(borrow mut this) -> borrow mut Router<S> => borrow mut this.routes;

    /// The application's state.
    public fn state(borrow this) -> borrow S => borrow this.appState;

    /// The HTTP limits each connection's requests are held to.
    public fn limits(borrow this) -> borrow Limits => borrow this.httpLimits;

    /// Serves connections from `incoming` (a `Listener`, or a `MockIncoming` in tests) through `acceptor` with M1's
    /// connection server, until `drain` finishes or `incoming` ends (`ConnectionServer.run`). A connection is HTTP/2
    /// when TLS negotiated `h2`, or when it starts with HTTP/2's preface (prior knowledge, RFC 9113 §3.3); HTTP/1.1
    /// otherwise. The server moves into an `Arc` shared by every connection and HTTP/2 stream.
    public async fn run(
        this,
        incoming: borrow dyn Incoming,
        acceptor: borrow dyn Acceptor,
        limits: borrow ConnectionLimits,
        drain: borrow Drain,
    ) -> Result<ServerReport, NetError> {
        let service = serviceOf(this)?;
        return await ConnectionServer.run(incoming, acceptor, service, limits, drain);
    }
}

/// An application served over HTTP/1.1 and HTTP/2: the protocol is chosen per connection (Web ADR 0011 §3.2).
public struct HttpService {
    private app: Arc<Box<dyn Application + Send>>;
    private httpLimits: Limits;
}

impl ConnectionHandler for HttpService {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> {
        let h2 = match (conn.alpn()) {
            Alpn.Http2 => true,
            _ => false,
        };
        if (h2) {
            return await serveH2(conn, ctx, this.app, this.httpLimits, "".bytes());
        }
        // Cleartext, or TLS without `h2`: the first bytes tell HTTP/2's preface from an HTTP/1.1 request line. They
        // differ by the second byte at the latest ("PRI" against "POST" or "PUT"), so this reads one segment as a rule.
        var first = [0u8; 24];
        var n: usize = 0;
        let text = clientPreface();
        let preface = text.bytes();
        let deadline = Deadline.after(this.httpLimits.headerTimeoutMs);
        while (n < first.length && prefixOf(first[0..n], preface)) {
            let got = match (await Transports.readWithin(conn, mut first[n..], deadline)) {
                Ok(v) => v,
                Err(NetError.TimedOut) => { return Ok(); },
                Err(e) => { return Err(e); },
            };
            if (got == 0) {
                return Ok(); // the client closed before a request
            }
            n += got;
        }
        let sendable: borrow dyn Application + Send = this.app.get();
        let app: borrow dyn Application = sendable;
        if (n == first.length && prefixOf(first[..], preface)) {
            return await serveH2(conn, ctx, this.app, this.httpLimits, first[..]);
        }
        return await web_http1.serveFrom(conn, ctx, app, this.httpLimits, first[0..n]);
    }
}

/// The service of `server`, which it owns from now on.
public fn serviceOf<S: Send>(server: Server<S>) -> Result<HttpService, NetError> {
    let limits = server.httpLimits;
    let app = applicationOf(server)?;
    return Ok(HttpService.of(app, limits));
}

/// `server` as a shared application, which it owns from now on: the one `serviceOf` serves. Serve it over TCP with
/// `HttpService.of` and, in the same program, over HTTP/3 with `web_http3`'s `Http3Server.serve`, so both run the
/// same routes, middleware and state (Web ADR 0014 amendment 4 item 1). `web_server` itself never depends on
/// `web_http3`.
public fn applicationOf<S: Send>(server: Server<S>) -> Result<Arc<Box<dyn Application + Send>>, NetError> {
    let boxed: Box<dyn Application + Send> = match (Box.create(server)) {
        Ok(b) => b,
        Err(_) => { return Err(NetError.OutOfMemory); },
    };
    match (Arc<Box<dyn Application + Send>>.create(boxed)) {
        Ok(app) => { return Ok(app); }
        Err(_) => { return Err(NetError.OutOfMemory); }
    }
}

impl HttpService {
    /// The service of a shared application (`applicationOf`), its requests held to `limits`.
    public fn of(app: Arc<Box<dyn Application + Send>>, limits: Limits) -> HttpService =>
        HttpService { app: app, httpLimits: limits };
}

/// Whether `bytes` is where `whole` starts.
fn prefixOf(bytes: Slice<u8>, whole: Slice<u8>) -> bool {
    if (bytes.length > whole.length) {
        return false;
    }
    for (i in 0..bytes.length) {
        if (bytes[i] != whole[i]) {
            return false;
        }
    }
    return true;
}

impl<S: Send> ConnectionHandler for Server<S> {
    async fn serve(
        borrow this,
        conn: borrow mut dyn Transport,
        ctx: borrow ConnectionContext,
    ) -> Result<void, NetError> =>
        await web_http1.serve(conn, ctx, this, this.httpLimits);
}

impl<S: Send> Application for Server<S> {
    /// Routes the request, runs every middleware's `before` in order, then the route's handler. A path with no
    /// route is 404; a path with routes but none for the method is 405 with `Allow`, or 204 with `Allow` for OPTIONS
    /// (RFC 9110 §9.3.7, §15.5.6). `OPTIONS *` is 204.
    async fn handle(
        borrow this,
        request: borrow Request,
        exchange: borrow mut Exchange,
        connection: borrow ConnectionContext,
    ) -> Result<void, HandlerError> {
        var params = Params.empty();
        let path = request.path();
        let found = this.routes.find(request.method(), path.bytes(), mut params);
        var ctx = RequestContext<S>.create(this.appState, connection, this.routes, path, params);
        for (i in 0..this.hooks.length) {
            match (await this.hooks[i].before(mut ctx, request, exchange)?) {
                Flow.Continue => {}
                Flow.Responded => { return Ok(); }
            }
        }
        let options = Methods.same(request.method(), Method.Options);
        match (found) {
            RouteMatch.Found(index) => { return await this.routes.handler(index).handle(mut ctx, request, exchange); }
            RouteMatch.MethodNotAllowed(mask) => {
                var text = [0u8; 96];
                let n = allowText(mask | (1u32 << Methods.index(Method.Options)), mut text);
                exchange.header("allow", text[0..n])?;
                let status = if (options) Status.noContent() else Status.methodNotAllowed();
                return await exchange.send(status, "".bytes());
            }
            RouteMatch.NotFound => {
                let asterisk = Ascii.equals(path.bytes(), "*");
                let status = if (options && asterisk) Status.noContent() else Status.notFound();
                return await exchange.send(status, "".bytes());
            }
        }
    }

    /// Every middleware's `after`, in reverse order.
    async fn beforeHead(
        borrow this,
        request: borrow Request,
        head: borrow mut ResponseHead,
    ) -> Result<void, HandlerError> {
        var i = this.hooks.length;
        while (i > 0) {
            i -= 1;
            await this.hooks[i].after(request, head)?;
        }
        return Ok();
    }
}

/// The methods in `mask` (over `Methods.index`), as an `Allow` value ("GET, HEAD, OPTIONS") in `out`; its length.
fn allowText(mask: u32, out: borrow mut [u8; 96]) -> usize {
    var n: usize = 0;
    for (i in 0..9u32) {
        if ((mask & (1u32 << i)) == 0) {
            continue;
        }
        let name = Methods.text(methodAt(i)).bytes();
        if (n > 0) {
            out[n] = 44;
            out[n + 1] = 32;
            n += 2;
        }
        for (b in name) {
            out[n] = b;
            n += 1;
        }
    }
    return n;
}

/// The method at `Methods.index` value `i` (0 to 8).
fn methodAt(i: u32) -> Method => match (i) {
    0 => Method.Get,
    1 => Method.Head,
    2 => Method.Post,
    3 => Method.Put,
    4 => Method.Delete,
    5 => Method.Connect,
    6 => Method.Options,
    7 => Method.Trace,
    _ => Method.Patch,
};
